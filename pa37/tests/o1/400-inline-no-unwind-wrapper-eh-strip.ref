function @leaf(%x : i64) -> i64 [unwind=no] {
  block ^entry:
    %t1 = binary add i64 %x, 1
    return i64 %t1
}
function @wrapper(%x : i64) -> i64 [unwind=no] {
  block ^entry:
    %__o1inl0__t1 = binary add i64 %x, 1
    return i64 %__o1inl0__t1
}
function @main(%x : i64) -> i64 {
  block ^entry:
    %__o1inl0____o1inl0__t1 = binary add i64 %x, 1
    %t2 = binary shl i64 %__o1inl0____o1inl0__t1, 1
    return i64 %t2
}
