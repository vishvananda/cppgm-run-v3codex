function @callee(%x : i64, %take_x : u8) -> i64 {
  block ^entry:
    branch %take_x, ^take_x, ^increment

  block ^take_x:
    return i64 %x

  block ^increment:
    %t2 = binary add i64 %x, 1
    return i64 %t2
}
function @caller(%x : i64, %take_x : u8) -> i64 {
  block ^entry:
    branch %take_x, ^__o1inl0__take_x, ^__o1inl0__increment

  block ^__o1inl0__take_x:
    jump ^__o1inl0__cont

  block ^__o1inl0__increment:
    %__o1inl0__t2 = binary add i64 %x, 1
    jump ^__o1inl0__cont

  block ^__o1inl0__cont:
    %t0 = phi i64 [^__o1inl0__take_x: %x, ^__o1inl0__increment: %__o1inl0__t2]
    return i64 %t0
}
function @object_callee(%p : ptr, %take_p : u8) -> obj<8x8> {
  slot $__o1inl0__retmergeobj__1 : obj<8x8>

  block ^entry:
    branch %take_p, ^take_p, ^take_null

  block ^take_p:
    %t1 = addr $__o1inl0__retmergeobj__1
    store ptr %p, %t1
    return obj<8x8> $__o1inl0__retmergeobj__1

  block ^take_null:
    %t2 = addr $__o1inl0__retmergeobj__1
    store ptr 0, %t2
    return obj<8x8> $__o1inl0__retmergeobj__1
}
function @object_caller(%p : ptr, %take_p : u8, %out : ptr) -> void {
  block ^entry:
    branch %take_p, ^__o1inl0__take_p, ^__o1inl0__take_null

  block ^__o1inl0__take_p:
    jump ^__o1inl0__cont

  block ^__o1inl0__take_null:
    jump ^__o1inl0__cont

  block ^__o1inl0__cont:
    %t5 = phi ptr [^__o1inl0__take_p: %p, ^__o1inl0__take_null: 0]
    store ptr %t5, %out
    return void
}
