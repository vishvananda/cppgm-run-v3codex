function @choose(%x : i64) -> i64 [unwind=no, binding=strong, prefer_local=yes] {
  block ^entry:
    %t1 = cmp eq i64 %x, 0
    branch %t1, ^zero, ^nonzero

  block ^zero:
    return i64 10

  block ^nonzero:
    return i64 20
}
function @caller(%x : i64) -> i64 {
  block ^entry:
    %__o1inl0__t1 = cmp eq i64 %x, 0
    branch %__o1inl0__t1, ^__o1inl0__zero, ^__o1inl0__nonzero

  block ^__o1inl0__zero:
    jump ^__o1inl0__cont

  block ^__o1inl0__nonzero:
    jump ^__o1inl0__cont

  block ^__o1inl0__cont:
    %t0 = phi i64 [^__o1inl0__zero: 10, ^__o1inl0__nonzero: 20]
    %t2 = binary add i64 %t0, 1
    return i64 %t2
}
