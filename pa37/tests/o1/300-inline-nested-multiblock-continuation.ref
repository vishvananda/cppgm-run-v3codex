function @main(%outer : i64, %inner : i64) -> i64 {
  block ^entry:
    %__o1inl0__is_zero = cmp eq i64 %outer, 0
    branch %__o1inl0__is_zero, ^__o1inl0____o1inl0__entry, ^__o1inl0__nonzero

  block ^__o1inl0____o1inl0__entry:
    %__o1inl0____o1inl0__is_zero = cmp eq i64 %inner, 0
    branch %__o1inl0____o1inl0__is_zero, ^__o1inl0____o1inl0__zero, ^__o1inl0____o1inl0__nonzero

  block ^__o1inl0____o1inl0__zero:
    jump ^__o1inl0____o1inl0__cont

  block ^__o1inl0____o1inl0__nonzero:
    jump ^__o1inl0____o1inl0__cont

  block ^__o1inl0____o1inl0__cont:
    %t0 = phi i64 [^__o1inl0____o1inl0__zero: 10, ^__o1inl0____o1inl0__nonzero: 20]
    jump ^__o1inl0__cont

  block ^__o1inl0__nonzero:
    jump ^__o1inl0__cont

  block ^__o1inl0__cont:
    %t2 = phi i64 [^__o1inl0____o1inl0__cont: %t0, ^__o1inl0__nonzero: %outer]
    %adjusted = binary add i64 %t2, 1
    return i64 %adjusted
}
function @wrapper(%outer : i64, %inner : i64) -> i64 {
  block ^entry:
    %is_zero = cmp eq i64 %outer, 0
    branch %is_zero, ^__o1inl0__entry, ^nonzero

  block ^__o1inl0__entry:
    %__o1inl0__is_zero = cmp eq i64 %inner, 0
    branch %__o1inl0__is_zero, ^__o1inl0__zero, ^__o1inl0__nonzero

  block ^__o1inl0__zero:
    jump ^__o1inl0__cont

  block ^__o1inl0__nonzero:
    jump ^__o1inl0__cont

  block ^__o1inl0__cont:
    %t0 = phi i64 [^__o1inl0__zero: 10, ^__o1inl0__nonzero: 20]
    return i64 %t0

  block ^nonzero:
    return i64 %outer
}
function @leaf(%inner : i64) -> i64 {
  block ^entry:
    %is_zero = cmp eq i64 %inner, 0
    branch %is_zero, ^zero, ^nonzero

  block ^zero:
    return i64 10

  block ^nonzero:
    return i64 20
}
