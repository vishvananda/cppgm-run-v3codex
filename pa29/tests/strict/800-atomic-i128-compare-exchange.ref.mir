machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i128
  init i128 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx
    slot $expected -> [rbp-16] : i128
    temp %loaded -> [rbp-32] : i128
    temp %nine -> [rbp-32] : i128
    temp %now -> [rbp-32] : i128
    temp %wanted -> [rbp-48] : i128

  block ^entry
    mov r8, @g
    mov rax, 0
    mov rdx, 0
    mov rbx, 0
    mov rcx, 0
    mov r11, r8
    lock_cmpxchg16b [r11], expected=rdx:rax, desired=rcx:rbx
    lea r11, [rbp-32]
    store.i64 [r11], rax
    store.i64 [r11+8], rdx
    lea r11, [rbp-32]
    load.i64 rax, [r11]
    load.i64 rdx, [r11+8]
    lea r11, [rbp-16]
    store.i64 [r11], rax
    store.i64 [r11+8], rdx
    mov rax, 9
    mov rdx, 0
    lea r11, [rbp-32]
    store.i64 [r11], rax
    store.i64 [r11+8], rdx
    lea r10, [rbp-16]
    load.i64 rax, [r10]
    load.i64 rdx, [r10+8]
    lea r11, [rbp-32]
    load.i64 rbx, [r11]
    load.i64 rcx, [r11+8]
    mov r11, r8
    lock_cmpxchg16b [r11], expected=rdx:rax, desired=rcx:rbx
    store.i64 [r10], rax
    store.i64 [r10+8], rdx
    sete rax
    movzx rax, rax
    mov r9, rax
    mov rax, 0
    mov rdx, 0
    mov rbx, 0
    mov rcx, 0
    mov r11, r8
    lock_cmpxchg16b [r11], expected=rdx:rax, desired=rcx:rbx
    lea r11, [rbp-32]
    store.i64 [r11], rax
    store.i64 [r11+8], rdx
    mov rax, 9
    mov rdx, 0
    lea r11, [rbp-48]
    store.i64 [r11], rax
    store.i64 [r11+8], rdx
    lea r11, [rbp-32]
    load.i64 rax, [r11]
    load.i64 rdx, [r11+8]
    lea r11, [rbp-48]
    load.i64 rcx, [r11]
    load.i64 rsi, [r11+8]
    cmp.i64 rdx, rsi
    sete r10
    movzx r10, r10
    cmp.i64 rax, rcx
    sete r11
    movzx r11, r11
    and r10, r11
    mov r8, r10
    and r9, r8
    ret r9
