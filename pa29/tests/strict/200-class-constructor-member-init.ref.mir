machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @YP__YP
  abi
    param %this -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0

  block ^entry
    mov rax, 3
    store.i32 [rdi], rax
    ret

function @YP___YP
  abi
    param %this -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0

  block ^entry
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    preserve rbx
    slot $p__0 -> [rbp-8] : i64

  block ^entry
    lea rdi, [rbp-8]
    call @YP__YP [args=(rdi)]
    load.i32 rbx, [rbp-8]
    sext.i32 rbx
    lea rdi, [rbp-8]
    call @YP___YP [args=(rdi)]
    ret rbx
