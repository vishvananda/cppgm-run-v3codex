machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i64
  init i64 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    mov r8, @g
    mov r9, 9
    mov rax, r9
    xchg.i64 [r8], rax
    mov rdi, rax
    load.i64 rsi, [r8]
    mov r8, 7
    cmp.i64 rdi, r8
    sete rdi
    movzx rdi, rdi
    cmp.i64 rsi, r9
    sete rsi
    movzx rsi, rsi
    and rdi, rsi
    mov rax, rdi
    ret rax
