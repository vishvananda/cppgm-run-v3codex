machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i64
  init i64 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, @g
    mov rax, 9
    xchg.i64 [r8], rax
    mov r9, rax
    load.i64 rdi, [r8]
    mov rdx, 7
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov rdx, 9
    cmp.i64 rdi, rdx
    sete rdi
    movzx rdi, rdi
    and r9, rdi
    ret r9
