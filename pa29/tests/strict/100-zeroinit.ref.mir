machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @dst
  storage data
  item i64 7
  item i64 8

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    mov r8, @dst
    zero_bytes 16x8, r8
    load.i64 r9, @dst
    add r9, [r8+8]
    ret r9
