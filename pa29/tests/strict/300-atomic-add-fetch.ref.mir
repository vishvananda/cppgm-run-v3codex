machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i64
  init i64 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    mov r8, @g
    mov r9, 5
    mov rcx, r8
    mov rdx, r9
    mov rax, r9
    lock_xadd.i64 [rcx], rax
    add rax, rdx
    mov rdi, rax
    mov r8, 12
    cmp.i64 rdi, r8
    sete rdi
    movzx rdi, rdi
    mov rax, rdi
    ret rax
