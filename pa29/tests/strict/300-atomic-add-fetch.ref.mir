machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i64
  init i64 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    mov r8, @g
    mov rcx, r8
    mov rdx, 5
    mov rax, 5
    lock_xadd.i64 [rcx], rax
    add rax, rdx
    mov r9, rax
    mov rax, r9
    mov rdx, 12
    cmp.i64 rax, rdx
    sete rax
    movzx rax, rax
    ret rax
