machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i32
  init i32 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, @g
    mov rax, 11
    xchg.i32 [r8], rax
    load.i32 r9, [r8]
    cmp.i32 r9, 11
    sete rax
    movzx rax, rax
    ret rax
