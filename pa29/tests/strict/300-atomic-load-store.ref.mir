machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i64
  init i64 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, @g
    load.i64 r9, [r8]
    add r9, 1
    store.i64 [r8], r9
    load.i64 r9, [r8]
    cmp.i64 r9, 8
    sete rax
    movzx rax, rax
    ret rax
