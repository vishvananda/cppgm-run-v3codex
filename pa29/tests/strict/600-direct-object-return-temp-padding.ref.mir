machine_ir x86_64 linux

startup
    call @__cppgm_406d61696e [args=()]
    mov rdi, rax
    exit

function @f
  abi
    return obj<3x1> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $x -> [rbp-4] : obj<3x1>

  block ^entry
    lea rdi, [rbp-4]
    zero_bytes 3x1, rdi
    store.u8 [rbp-3], 1
    load.i32 rax, [rbp-4]
    ret

function @__cppgm_406d61696e
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $out -> [rbp-4] : obj<3x1>

  block ^entry
    call @f [args=()]
    store.i32 [rbp-4], rax
    mov rax, 0
    ret rax
