machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i64
  init i64 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    preserve rbx r12
    slot $expected -> [rbp-8] : i64

  block ^entry
    mov r8, @g
    mov r9, 7
    store.i64 [rbp-8], r9
    mov rbx, 9
    mov rcx, r8
    lea rdx, [rbp-8]
    load.i64 rax, [rdx]
    mov rsi, rbx
    lock_cmpxchg.i64 [rcx], rsi
    store.i64 [rdx], rax
    sete rax
    movzx rax, rax
    mov rdi, rax
    load.i64 rsi, [r8]
    load.i64 r8, [rbp-8]
    mov r12, 1
    cmp.i64 rdi, r12
    sete rdi
    movzx rdi, rdi
    cmp.i64 rsi, rbx
    sete rsi
    movzx rsi, rsi
    cmp.i64 r8, r9
    sete r8
    movzx r8, r8
    and rdi, rsi
    and rdi, r8
    mov rax, rdi
    ret rax
