machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i64
  init i64 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $expected -> [rbp-8] : i64

  block ^entry
    mov r8, @g
    store.i64 [rbp-8], 7
    mov rcx, r8
    lea rdx, [rbp-8]
    load.i64 rax, [rdx]
    mov rsi, 9
    lock_cmpxchg.i64 [rcx], rsi
    store.i64 [rdx], rax
    sete rax
    movzx rax, rax
    mov r9, rax
    load.i64 rdi, [r8]
    load.i64 r8, [rbp-8]
    mov rdx, 1
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov rdx, 9
    cmp.i64 rdi, rdx
    sete rdi
    movzx rdi, rdi
    mov rdx, 7
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    and r9, rdi
    and r9, r8
    ret r9
