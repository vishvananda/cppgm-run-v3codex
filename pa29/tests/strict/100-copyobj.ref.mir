machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @src
  storage data
  item i64 5
  item i64 9

global @dst
  storage data
  item i64 0
  item i64 0

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    mov r8, @dst
    mov r9, @src
    copy_bytes 16x8, r8, r9
    load.i64 r9, @dst
    load.i64 rdi, [r8+8]
    add r9, rdi
    ret r9
