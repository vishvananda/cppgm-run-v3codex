machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g thread_local
  storage scalar i64
  init i64 0

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, 7
    tls_addr r11, @g__tls_wrapper
    store.i64 [r11], rbx
    tls_addr r11, @g__tls_wrapper
    load.i64 r8, [r11]
    and r8, 4294967295
    sext.i32 r8
    ret r8
