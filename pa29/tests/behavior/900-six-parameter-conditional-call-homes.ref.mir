machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @select_width
  abi
    param %receiver -> rdi : i64
    param %width -> rsi : i64
    param %opcode -> rdx : i64
    param %source -> rcx : i64
    param %destination -> r8 : i64
    param %scratch -> r9 : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    param-slot %width -> [rbp-8] : i64
    temp %destination_scratch -> [rbp-16] : i64

  block ^entry
    store.i64 [rbp-8], rsi
    mov r13, rdi
    mov r12, rdx
    mov r15, rcx
    mov rbx, r8
    mov r14, r9
    cmp.i64 [rbp-8], 16
    je ^prefix
    jmp ^continue

  block ^prefix
    call @touch
    jmp ^continue

  block ^continue
    mov r8, r13
    load.i64 rdx, [rbp-8]
    add r8, rdx
    mov r9, r12
    add r9, r15
    mov rax, rbx
    add rax, r14
    store.i64 [rbp-16], rax
    add r8, r9
    load.i64 rdx, [rbp-16]
    add r8, rdx
    mov rax, r8
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 0
    mov rsi, 64
    mov rdx, 40
    mov rcx, 1
    mov r8, 0
    mov r9, 3
    call @select_width
    mov r8, rax
    mov rdx, 108
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
