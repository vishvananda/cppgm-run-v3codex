machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @g1
  storage scalar i64
  init i64 10

global @g2
  storage scalar i64
  init i64 20

global @g3
  storage scalar i64
  init i64 30

global @g4
  storage scalar i64
  init i64 40

global @g5
  storage scalar i64
  init i64 50

global @g6
  storage scalar i64
  init i64 60

function @clobber
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    return void -> void
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %a -> [rbp-8] : i64
    param-slot %b -> [rbp-16] : i64
    param-slot %c -> [rbp-24] : i64
    param-slot %d -> [rbp-32] : i64
    param-slot %e -> [rbp-40] : i64
    param-slot %f -> [rbp-48] : i64

  block ^entry
    store.i64 [rbp-8], rdi
    store.i64 [rbp-16], rsi
    store.i64 [rbp-24], rdx
    store.i64 [rbp-32], rcx
    store.i64 [rbp-40], r8
    store.i64 [rbp-48], r9
    ret

function @run
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %v6 -> [rbp-8] : i64

  block ^entry
    load.i64 rbx, @g1
    load.i64 r12, @g2
    load.i64 r13, @g3
    load.i64 r14, @g4
    load.i64 r15, @g5
    load.i64 rax, @g6
    store.i64 [rbp-8], rax
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    call @clobber
    add rbx, r12
    add rbx, r13
    add rbx, r14
    add rbx, r15
    load.i64 rdx, [rbp-8]
    add rbx, rdx
    mov rax, rbx
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    call @run
    mov r8, rax
    mov rdx, 210
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
