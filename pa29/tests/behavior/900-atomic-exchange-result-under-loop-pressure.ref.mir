machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @g
  storage scalar i64
  init i64 0

function @pressure
  abi
    param %seed -> rdi : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %address -> [rbp-8] : ptr
    temp %old -> [rbp-16] : i64

  block ^entry
    mov r8, rdi
    mov r9, rdi
    add r9, 1
    mov rbx, rdi
    add rbx, 2
    mov r12, rdi
    add r12, 3
    mov r13, rdi
    add r13, 4
    mov r14, rdi
    add r14, 5
    jmp ^exchange

  block ^exchange
    mov r15, r8
    add r15, 6
    mov rax, @g
    store.ptr [rbp-8], rax
    load.ptr rcx, [rbp-8]
    mov rax, r15
    xchg.i64 [rcx], rax
    store.i64 [rbp-16], rax
    load.i64 rax, [rbp-16]
    cmp.i64 rax, 0
    jne ^exchange
    jmp ^done

  block ^done
    mov r8, r9
    add r8, rbx
    mov r15, r12
    add r15, r13
    add r8, r15
    add r8, r14
    mov rax, r8
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 10
    call @pressure
    mov r8, rax
    mov rdx, 65
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
