machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @loop_value
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    return i64 -> rax
  frame
    stack_size 96
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    slot $iteration -> [rbp-8] : i64
    slot $result -> [rbp-16] : i64
    temp %from_e -> [rbp-24] : i64
    temp %ab -> [rbp-32] : i64
    temp %bc -> [rbp-40] : i64
    temp %cd -> [rbp-48] : i64

  block ^entry
    mov rbx, rdi
    mov r12, rsi
    mov r13, rdx
    mov r14, rcx
    mov r15, r8
    mov rax, 0
    store.i64 [rbp-8], rax
    mov rax, 0
    store.i64 [rbp-16], rax
    jmp ^loop_condition

  block ^loop_condition
    cmp.i64 [rbp-8], 1
    jl ^loop_body
    jmp ^loop_end

  block ^loop_body
    mov rax, r15
    add rax, 1
    store.i64 [rbp-24], rax
    mov rax, rbx
    add rax, r12
    store.i64 [rbp-32], rax
    mov rax, r12
    add rax, r13
    store.i64 [rbp-40], rax
    mov rax, r13
    add rax, r14
    store.i64 [rbp-48], rax
    call @touch
    load.i64 r8, [rbp-32]
    load.i64 rdx, [rbp-40]
    add r8, rdx
    load.i64 r9, [rbp-48]
    load.i64 rdx, [rbp-24]
    add r9, rdx
    add r8, r9
    add r8, rbx
    add r8, r12
    add r8, r13
    add r8, r14
    store.i64 [rbp-16], r8
    load.i64 r8, [rbp-8]
    add r8, 1
    store.i64 [rbp-8], r8
    jmp ^loop_condition

  block ^loop_end
    load.i64 rax, [rbp-16]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    call @loop_value
    mov r8, rax
    mov rdx, 31
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
