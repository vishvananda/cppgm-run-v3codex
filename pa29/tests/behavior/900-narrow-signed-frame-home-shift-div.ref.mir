machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @dirty_stack
  abi
    return void -> void
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $junk -> [rbp-64] : obj<64x8>

  block ^entry
    mov rax, -1
    lea rcx, [rbp-64]
    store.i64 [rcx], rax
    lea r8, [rbp-64]
    lea r8, [r8+8]
    mov rax, -1
    store.i64 [r8], rax
    lea r8, [rbp-64]
    lea r8, [r8+16]
    mov rax, -1
    store.i64 [r8], rax
    lea r8, [rbp-64]
    lea r8, [r8+24]
    mov rax, -1
    store.i64 [r8], rax
    lea r8, [rbp-64]
    lea r8, [r8+32]
    mov rax, -1
    store.i64 [r8], rax
    lea r8, [rbp-64]
    lea r8, [r8+40]
    mov rax, -1
    store.i64 [r8], rax
    lea r8, [rbp-64]
    lea r8, [r8+48]
    mov rax, -1
    store.i64 [r8], rax
    lea r8, [rbp-64]
    lea r8, [r8+56]
    mov rax, -1
    store.i64 [r8], rax
    ret

function @side_effect
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @fold
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    param %c -> rdx : i32
    param %d -> rcx : i32
    param %e -> r8 : i32
    param %f -> r9 : i32
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    param-slot %f -> [rbp-4] : i32
    temp %remainder -> [rbp-8] : i32

  block ^entry
    store.i32 [rbp-4], r9
    mov rbx, rdi
    mov r12, rsi
    mov r13, rdx
    mov r14, rcx
    mov r15, r8
    call @side_effect
    mov r8, rbx
    sext.i32 r8
    mov rdx, 1
    mov rcx, rdx
    sar r8, cl
    sext.i32 r8
    mov rdx, 2
    mov rcx, rdx
    sext.i32 rcx
    mov rax, r12
    sext.i32 rax
    cqo
    idiv rcx
    mov r9, rax
    sext.i32 r9
    mov rax, r13
    mov rdx, 3
    mov rcx, rdx
    sext.i32 rcx
    sext.i32 rax
    cqo
    idiv rcx
    store.i32 [rbp-8], rdx
    add r8, r9
    sext.i32 r8
    load.i32 rdx, [rbp-8]
    add r8, rdx
    sext.i32 r8
    add r8, r14
    sext.i32 r8
    add r8, r15
    sext.i32 r8
    load.i32 rdx, [rbp-4]
    add r8, rdx
    sext.i32 r8
    mov rax, r8
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @dirty_stack
    mov rdi, -8
    mov rsi, -8
    mov rdx, -7
    mov rcx, 1
    mov r8, 2
    mov r9, 3
    call @fold
    mov r8, rax
    sext.i32 r8
    cmp.i32 r8, -3
    je ^good
    jmp ^bad

  block ^good
    mov rax, 0
    ret rax

  block ^bad
    mov rax, 1
    ret rax
