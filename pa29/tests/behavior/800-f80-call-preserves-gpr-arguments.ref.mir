machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @first
  storage scalar i64
  init i64 11

global @second
  storage scalar i64
  init i64 22

function @identity
  abi
    param %value -> rdi : ptr
    return ptr -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, rdi
    ret rax

function @check
  abi
    param %first -> rdi : ptr
    param %value -> [rbp+16] : f80
    param %second -> rsi : ptr
    return i64 -> rax
  frame
    stack_size 96
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve r12 r13 r14
    param-slot %value -> [rbp-16] : f80

  block ^entry
    fmov.f80 [rbp-16], [rbp+16]
    mov r8, @first
    mov r12, @second
    mov r13, rdi
    cmp.ptr r13, r8
    sete r13
    movzx r13, r13
    feq.f80 rax, [rbp-16], 3.5L
    mov r8, rax
    mov r14, rsi
    cmp.ptr r14, r12
    sete r14
    movzx r14, r14
    and r13, r14
    and r13, r8
    mov rax, r13
    ret rax

function @forward
  abi
    param %first -> rdi : ptr
    param %value -> [rbp+16] : f80
    param %second -> rsi : ptr
    return i64 -> rax
  frame
    stack_size 128
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12
    param-slot %value -> [rbp-16] : f80
    slot $value -> [rbp-32] : f80
    temp %loaded_value -> [rbp-48] : f80

  block ^entry
    fmov.f80 [rbp-16], [rbp+16]
    mov r8, rdi
    mov rbx, rsi
    fmov.f80 [rbp-32], [rbp-16]
    mov r9, rdi
    call @identity
    mov r12, rax
    fmov.f80 [rbp-48], [rbp-32]
    mov r9, rbx
    sub rsp, 16
    mov rdi, r12
    fmov.f80 [rsp], [rbp-48]
    mov rsi, rbx
    call @check
    add rsp, 16
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, @first
    mov r9, @second
    sub rsp, 16
    mov rdi, r8
    fmov.f80 [rsp], 3.5L
    mov rsi, r9
    call @forward
    add rsp, 16
    ret rax
