machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @increment
  abi
    param %cell -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov r9, rdi
    load.i32 rbx, [r9]
    sext.i32 rbx
    add rbx, 1
    sext.i32 rbx
    store.i32 [r9], rbx
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx
    slot $counter -> [rbp-8] : obj<8x4>

  block ^entry
    lea rbx, [rbp-8]
    mov rax, 0
    store.i32 [rbx], rax
    jmp ^loop_condition

  block ^loop_condition
    load.i32 r8, [rbx]
    sext.i32 r8
    cmp.i32 r8, 5
    jge ^loop_end
    jmp ^loop_body

  block ^loop_body
    mov rdi, rbx
    call @increment
    jmp ^loop_condition

  block ^loop_end
    lea r8, [rbp-8]
    load.i32 r9, [r8]
    sext.i32 r9
    cmp.i32 r9, 5
    je ^good
    jmp ^bad

  block ^good
    mov rax, 0
    ret rax

  block ^bad
    mov rax, 1
    ret rax
