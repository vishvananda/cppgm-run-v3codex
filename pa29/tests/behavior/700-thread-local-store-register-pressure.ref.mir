machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @g thread_local
  storage scalar i64
  init i64 0

function @f
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %x -> r9 : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve r14
    temp %t2 -> [rbp-8] : i64
    temp %t3 -> [rbp-16] : i64
    temp %t4 -> [rbp-24] : i64
    temp %t5 -> [rbp-32] : i64
    temp %z -> [rbp-40] : i64

  block ^entry
    mov r14, rdi
    add r14, 1
    mov rax, rsi
    add rax, 2
    store.i64 [rbp-8], rax
    mov rax, rdx
    add rax, 3
    store.i64 [rbp-16], rax
    mov rax, rcx
    add rax, 4
    store.i64 [rbp-24], rax
    mov rax, r8
    add rax, 5
    store.i64 [rbp-32], rax
    mov rax, r9
    add rax, 1
    store.i64 [rbp-40], rax
    load.i64 rax, [rbp-40]
    store.i64 [rbp-48], rax
    tls_addr r11, @g__tls_wrapper
    load.i64 rax, [rbp-48]
    store.i64 [r11], rax
    load.i64 rdx, [rbp-8]
    add r14, rdx
    load.i64 rdx, [rbp-16]
    add r14, rdx
    load.i64 rdx, [rbp-24]
    add r14, rdx
    load.i64 rdx, [rbp-32]
    add r14, rdx
    load.i64 rdx, [rbp-40]
    add r14, rdx
    mov rax, r14
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    call @f
    mov r9, rax
    sext.i32 r9
    mov rax, r9
    ret rax
