machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @clobber
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %a -> [rbp-8] : i64
    param-slot %b -> [rbp-16] : i64
    param-slot %c -> [rbp-24] : i64
    param-slot %d -> [rbp-32] : i64
    param-slot %f -> [rbp-40] : i64

  block ^entry
    store.i64 [rbp-8], rdi
    store.i64 [rbp-16], rsi
    store.i64 [rbp-24], rdx
    store.i64 [rbp-32], rcx
    store.i64 [rbp-40], r9
    mov rax, r8
    ret rax

function @size
  abi
    param %this -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %this -> [rbp-8] : ptr

  block ^entry
    store.ptr [rbp-8], rdi
    mov rdi, 10
    mov rsi, 20
    mov rdx, 30
    mov rcx, 40
    mov r8, 12345
    mov r9, 60
    call @clobber
    mov rax, 1
    ret rax

function @check
  abi
    param %this -> rdi : ptr
    param %index -> rsi : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r13

  block ^entry
    mov r9, rdi
    mov r8, rsi
    mov rbx, rsi
    call @size
    mov r13, rax
    cmp.i64 rbx, r13
    jae ^bad
    jmp ^good

  block ^bad
    mov rax, 3
    ret rax

  block ^good
    mov rax, 0
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 0
    mov rsi, 0
    call @check
    ret rax
