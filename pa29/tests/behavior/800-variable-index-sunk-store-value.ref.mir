machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @buffer
  storage data
  item i64 10
  item i64 20
  item i64 30
  item i64 40

global @which
  storage scalar i64
  init i64 2

global @saved
  storage scalar ptr
  init ptr 0

function @touch
  abi
    param %scratch -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %scratch -> [rbp-8] : ptr

  block ^entry
    store.ptr [rbp-8], rdi
    ret

function @run
  abi
    return void -> void
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $scratch -> [rbp-40] : obj<40x8>

  block ^entry
    lea rdi, [rbp-40]
    call @touch
    mov r8, @buffer
    load.i64 rdx, @which
    imul rdx, 8
    add r8, rdx
    store.ptr @saved, r8
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    call @run
    mov r8, @buffer
    lea r8, [r8+16]
    load.ptr r9, @saved
    mov rbx, r9
    cmp.ptr rbx, r8
    sete rbx
    movzx rbx, rbx
    load.i64 r8, [r9]
    mov rdx, 30
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    and rbx, r8
    mov rdx, 0
    cmp.i64 rbx, rdx
    sete rbx
    movzx rbx, rbx
    mov r8, rbx
    sext.i32 r8
    mov rax, r8
    ret rax
