machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @sum_object_and_scalars
  abi
    param %pair -> rdi : i64
    param %pair -> rsi : i64
    param %a -> rdx : i64
    param %b -> rcx : i64
    param %c -> r8 : i64
    param %d -> r9 : i64
    param %tail -> [rbp+16] : i64
    return i64 -> rax
  frame
    stack_size 80
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    param-slot %pair -> [rbp-16] : obj<16x8>
    param-slot %tail -> [rbp-24] : i64

  block ^entry
    store.i64 [rbp-16], rdi
    store.i64 [rbp-8], rsi
    load.i64 rax, [rbp+16]
    store.i64 [rbp-24], rax
    mov rbx, r8
    mov r8, rdx
    mov r12, r9
    mov r9, rcx
    lea rcx, [rbp-16]
    load.i64 r13, [rcx]
    lea r14, [rbp-16]
    lea r14, [r14+8]
    load.i64 r15, [r14]
    add r13, r15
    add r13, r8
    add r13, r9
    add r13, rbx
    add r13, r12
    load.i64 rdx, [rbp-24]
    add r13, rdx
    mov rax, r13
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14
    slot $pair -> [rbp-16] : obj<16x8>

  block ^entry
    mov rax, 100
    lea rcx, [rbp-16]
    store.i64 [rcx], rax
    lea r8, [rbp-16]
    lea r8, [r8+8]
    mov rax, 200
    store.i64 [r8], rax
    mov r8, 50
    mov r9, 1
    mov rbx, 2
    mov r12, 3
    mov r13, 4
    store.i64 [rbp-24], r8
    sub rsp, 16
    lea r11, [rbp-16]
    load.i64 rdi, [r11]
    lea r11, [rbp-16]
    load.i64 rsi, [r11+8]
    mov rdx, r9
    mov rcx, rbx
    mov r8, r12
    mov r9, r13
    load.i64 r11, [rbp-24]
    store.i64 [rsp], r11
    call @sum_object_and_scalars
    add rsp, 16
    mov r14, rax
    mov rdx, 360
    cmp.i64 r14, rdx
    sete r14
    movzx r14, r14
    mov rdx, 0
    cmp.i64 r14, rdx
    sete r14
    movzx r14, r14
    mov rax, r14
    ret rax
