machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @choose
  abi
    param %value -> rdi : i64
    param %enter -> rsi : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %raw -> [rbp-8] : i64

  block ^entry
    mov r9, rdi
    mov r8, rsi
    mov r13, 1
    mov r15, 2
    mov r14, 3
    mov r12, 4
    mov rbx, 5
    cmp.i64 r8, 0
    jne ^compute
    jmp ^sibling

  block ^compute
    mov rax, r9
    mov rdx, 1
    mov rcx, rdx
    cqo
    idiv rcx
    store.i64 [rbp-8], rax
    cmp.i64 [rbp-8], 0
    jl ^call_path
    jmp ^merge

  block ^call_path
    call @touch
    jmp ^merge

  block ^merge
    mov r8, r13
    add r8, r15
    mov r9, r14
    add r9, r12
    add r8, r9
    add r8, rbx
    load.i64 rax, [rbp-8]
    ret rax

  block ^sibling
    mov r8, r13
    add r8, r15
    mov r9, r14
    add r9, r12
    add r8, r9
    add r8, rbx
    mov rax, 0
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, -9
    mov rsi, 1
    call @choose
    mov rdi, 7
    mov rsi, 1
    call @choose
    mov r8, rax
    mov rdx, 7
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
