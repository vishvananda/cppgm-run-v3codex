machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @first
  storage data
  item i64 0

global @second
  storage data
  item i64 0

global @third
  storage data
  item i64 0

global @fourth
  storage data
  item i64 0

function @target
  abi
    param %ret -> rdi : ptr
    param %this -> rsi : ptr
    param %class -> rdx : ptr
    param %index -> rcx : i32
    param %base -> r8 : u8
    param %address -> r9 : ptr
    param %vector -> [rbp+16] : ptr
    return void -> void
  frame
    stack_size 112
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve r12 r14
    param-slot %vector -> [rbp-8] : ptr
    temp %second -> [rbp-16] : ptr
    temp %third -> [rbp-24] : ptr
    temp %fourth -> [rbp-32] : ptr
    temp %wrong1 -> [rbp-40] : i64
    temp %wrong3 -> [rbp-48] : i64
    temp %wrong4 -> [rbp-56] : i64
    temp %wrong5 -> [rbp-64] : i64
    temp %wrong6 -> [rbp-72] : i64
    temp %sum1 -> [rbp-80] : i64

  block ^entry
    load.ptr rax, [rbp+16]
    store.ptr [rbp-8], rax
    mov r14, rdi
    mov r12, @first
    mov rax, @second
    store.ptr [rbp-16], rax
    mov rax, @third
    store.ptr [rbp-24], rax
    mov rax, @fourth
    store.ptr [rbp-32], rax
    mov rax, rsi
    cmp.ptr rax, r12
    setne rax
    movzx rax, rax
    store.i64 [rbp-40], rax
    mov r12, rdx
    load.ptr rdx, [rbp-16]
    cmp.ptr r12, rdx
    setne r12
    movzx r12, r12
    mov rax, rcx
    mov rdx, 7
    cmp.i32 rax, rdx
    setne rax
    movzx rax, rax
    store.i64 [rbp-48], rax
    mov rax, r8
    mov rdx, 1
    cmp.u8 rax, rdx
    setne rax
    movzx rax, rax
    store.i64 [rbp-56], rax
    mov rax, r9
    load.ptr rdx, [rbp-24]
    cmp.ptr rax, rdx
    setne rax
    movzx rax, rax
    store.i64 [rbp-64], rax
    load.ptr rax, [rbp-8]
    load.ptr rdx, [rbp-32]
    cmp.ptr rax, rdx
    setne rax
    movzx rax, rax
    store.i64 [rbp-72], rax
    load.i64 rax, [rbp-40]
    add rax, r12
    store.i64 [rbp-80], rax
    load.i64 r12, [rbp-80]
    load.i64 rdx, [rbp-48]
    add r12, rdx
    load.i64 rdx, [rbp-56]
    add r12, rdx
    load.i64 rdx, [rbp-64]
    add r12, rdx
    load.i64 rdx, [rbp-72]
    add r12, rdx
    store.i64 [r14], r12
    ret

function @forward
  abi
    param %ret -> rdi : ptr
    param %arg1 -> rsi : ptr
    param %arg2 -> rdx : ptr
    param %arg3 -> rcx : i32
    param %arg4 -> r8 : u8
    param %arg5 -> r9 : ptr
    param %arg6 -> [rbp+16] : ptr
    return void -> void
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    param-slot %arg6 -> [rbp-8] : ptr

  block ^entry
    load.ptr rax, [rbp+16]
    store.ptr [rbp-8], rax
    mov r14, rdi
    mov rbx, rcx
    mov r12, r8
    mov r13, r9
    mov r9, rdx
    mov r15, rsi
    store.i64 [rbp-16], r9
    sub rsp, 16
    mov rdi, r14
    mov rsi, r15
    lea rsi, [rsi-136]
    load.i64 rdx, [rbp-16]
    mov rcx, rbx
    mov r8, r12
    mov r9, r13
    load.ptr r11, [rbp-8]
    store.ptr [rsp], r11
    call @target
    add rsp, 16
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12
    slot $result -> [rbp-8] : i64

  block ^entry
    mov r8, @first
    mov r9, @second
    mov rbx, @third
    mov r12, @fourth
    store.i64 [rbp-16], r9
    sub rsp, 16
    lea rdi, [rbp-8]
    mov rsi, r8
    lea rsi, [rsi+136]
    load.i64 rdx, [rbp-16]
    mov rcx, 7
    mov r8, 1
    mov r9, rbx
    store.ptr [rsp], r12
    call @forward
    add rsp, 16
    load.i64 rax, [rbp-8]
    ret rax
