machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @object
  storage data
  item i64 0
  item i64 0

global @wrong
  storage data
  item i64 0
  item i64 0

function @make
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %wrong_base -> r8 : ptr
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %a -> [rbp-8] : i64
    param-slot %b -> [rbp-16] : i64
    param-slot %c -> [rbp-24] : i64
    param-slot %d -> [rbp-32] : i64
    param-slot %wrong_base -> [rbp-40] : ptr

  block ^entry
    store.i64 [rbp-8], rdi
    store.i64 [rbp-16], rsi
    store.i64 [rbp-24], rdx
    store.i64 [rbp-32], rcx
    store.ptr [rbp-40], r8
    mov rax, 42
    ret rax

function @store_value
  abi
    param %p -> rdi : ptr
    param %value -> rsi : i64
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, rdi
    store.i64 [r8], rsi
    ret

function @run
  abi
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, @object
    mov r8, @wrong
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    call @make
    mov r9, rax
    mov rdi, rbx
    lea rdi, [rdi+8]
    mov rsi, rax
    call @store_value
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    call @run
    mov r8, @object
    lea r8, [r8+8]
    load.i64 r9, [r8]
    mov r8, @wrong
    lea r8, [r8+8]
    load.i64 rbx, [r8]
    mov rdx, 42
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov rdx, 0
    cmp.i64 rbx, rdx
    sete rbx
    movzx rbx, rbx
    and r9, rbx
    mov rdx, 0
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov r8, r9
    sext.i32 r8
    mov rax, r8
    ret rax
