machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @good
  storage scalar i64
  init i64 42

global @wrong
  storage data
  item i64 13
  item i64 99

function @capture
  abi
    param %p -> rdi : ptr
    param %addr -> rsi : ptr
    param %b -> rdx : i64
    param %c -> rcx : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %addr -> [rbp-8] : ptr
    param-slot %b -> [rbp-16] : i64
    param-slot %c -> [rbp-24] : i64

  block ^entry
    store.ptr [rbp-8], rsi
    store.i64 [rbp-16], rdx
    store.i64 [rbp-24], rcx
    mov r8, rdi
    load.i64 rax, [r8]
    ret rax

function @run
  abi
    param %p -> rdi : ptr
    param %q -> rsi : i64
    param %r -> rdx : i64
    param %s -> rcx : i64
    param %t -> r8 : i64
    param %u -> r9 : i64
    param %v -> [rbp+16] : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %q -> [rbp-8] : i64
    param-slot %r -> [rbp-16] : i64
    param-slot %s -> [rbp-24] : i64
    param-slot %t -> [rbp-32] : i64
    param-slot %u -> [rbp-40] : i64
    param-slot %v -> [rbp-48] : i64
    slot $p -> [rbp-56] : ptr

  block ^entry
    store.i64 [rbp-8], rsi
    store.i64 [rbp-16], rdx
    store.i64 [rbp-24], rcx
    store.i64 [rbp-32], r8
    store.i64 [rbp-40], r9
    load.i64 rax, [rbp+16]
    store.i64 [rbp-48], rax
    store.ptr [rbp-56], rdi
    jmp ^call

  block ^call
    load.ptr r8, [rbp-56]
    mov r9, @wrong
    mov rdi, r8
    mov rsi, r9
    lea rsi, [rsi+8]
    mov rdx, 2
    mov rcx, 3
    call @capture
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, @good
    sub rsp, 16
    mov rdi, r8
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    mov r11, 7
    store.i64 [rsp], r11
    call @run
    add rsp, 16
    mov r9, rax
    mov rdx, 42
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov rdx, 0
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov r8, r9
    sext.i32 r8
    mov rax, r8
    ret rax
