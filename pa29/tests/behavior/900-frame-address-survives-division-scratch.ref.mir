machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx
    slot $bytes -> [rbp-8] : obj<8x1>

  block ^entry
    mov rax, 65
    lea rcx, [rbp-8]
    store.i8 [rcx], rax
    mov r8, 200
    mov rdx, 100
    mov rcx, rdx
    mov rax, r8
    mov rdx, 0
    div rcx
    lea r9, [rbp-8]
    lea r9, [r9+1]
    mov rbx, rax
    sext.i8 rbx
    store.i8 [r9], rbx
    load.i8 r8, [r9]
    sext.i8 r8
    mov r9, r8
    zext.i8 r9
    sext.i32 r9
    mov rdx, 2
    cmp.i32 r9, rdx
    sete r9
    movzx r9, r9
    mov rdx, 0
    cmp.i32 r9, rdx
    sete r9
    movzx r9, r9
    mov rax, r9
    ret rax
