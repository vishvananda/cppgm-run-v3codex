machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-4] : f32

  block ^entry
    fmov.f32 [rbp-4], 0
    fmov.f32 xmm0, [rbp-4]
    feq.f32 rax, xmm0, 0.0
    mov r8, rax
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
