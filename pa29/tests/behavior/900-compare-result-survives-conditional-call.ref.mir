machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @clobber
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx
    param-slot %b -> [rbp-8] : i64
    param-slot %c -> [rbp-16] : i64
    param-slot %d -> [rbp-24] : i64

  block ^entry
    store.i64 [rbp-8], rsi
    store.i64 [rbp-16], rdx
    store.i64 [rbp-24], rcx
    mov r9, r8
    mov rbx, rdi
    add rbx, r9
    mov rax, rbx
    ret rax

function @classify
  abi
    param %kind -> rdi : i32
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov r9, rdi
    sext.i32 r9
    mov rbx, r9
    mov rdx, 1
    cmp.i32 rbx, rdx
    setne rbx
    movzx rbx, rbx
    cmp.i64 rbx, 0
    je ^named_path
    jmp ^merge

  block ^named_path
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    call @clobber
    jmp ^merge

  block ^merge
    mov rax, rbx
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    call @classify
    mov rdi, 0
    call @classify
    mov r8, rax
    mov rdx, 1
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
