machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @return_one
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 1
    ret rax

function @loop_sum
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    return i64 -> rax
  frame
    stack_size 80
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    slot $storage -> [rbp-16] : obj<16x8>
    slot $current -> [rbp-24] : i64

  block ^entry
    mov rbx, rdi
    mov r12, rsi
    mov r13, rdx
    mov r14, rcx
    lea r15, [rbp-16]
    lea r15, [r15+8]
    mov rax, 7
    store.i64 [r15], rax
    mov rax, 0
    store.i64 [rbp-24], rax
    jmp ^loop_condition

  block ^loop_condition
    cmp.i64 [rbp-24], 3
    jl ^loop_body
    jmp ^loop_end

  block ^loop_body
    call @return_one
    mov r8, rax
    cmp.i64 r8, 1
    je ^loop_step
    jmp ^failure

  block ^loop_step
    load.i64 r8, [rbp-24]
    add r8, 1
    store.i64 [rbp-24], r8
    jmp ^loop_condition

  block ^loop_end
    mov r8, rbx
    add r8, r12
    mov r9, r13
    add r9, r14
    add r8, r9
    load.i64 r9, [r15]
    add r8, r9
    mov rax, r8
    ret rax

  block ^failure
    mov rax, -1
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 10
    mov rsi, 20
    mov rdx, 30
    mov rcx, 40
    call @loop_sum
    mov r8, rax
    mov rdx, 107
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
