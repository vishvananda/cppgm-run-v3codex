machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @value
  storage scalar i64
  init i64 77

function @consume
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    param-slot %p -> [rbp-8] : ptr

  block ^entry
    store.ptr [rbp-8], rdi
    mov rax, 0
    ret rax

function @load_value
  abi
    param %p -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0

  block ^entry
    mov r8, rdi
    load.i64 rax, [r8]
    ret rax

function @target
  abi
    param %a -> rdi : ptr
    param %b -> rsi : ptr
    param %c -> rdx : ptr
    param %d -> rcx : ptr
    param %e -> r8 : ptr
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    preserve rbx r12
    param-slot %a -> [rbp-8] : ptr
    param-slot %c -> [rbp-16] : ptr
    param-slot %d -> [rbp-24] : ptr

  block ^entry
    store.ptr [rbp-8], rdi
    store.ptr [rbp-16], rdx
    store.ptr [rbp-24], rcx
    mov rbx, rsi
    mov r9, r8
    mov rdi, r8
    call @load_value
    mov r12, rax
    mov r9, rbx
    mov rdi, rbx
    call @consume
    mov rax, r12
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48

  block ^entry
    mov r8, @value
    mov rdi, 0
    mov rsi, 0
    mov rdx, 0
    mov rcx, 0
    call @target
    mov r9, rax
    mov rdx, 77
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov rdx, 0
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov r8, r9
    sext.i32 r8
    mov rax, r8
    ret rax
