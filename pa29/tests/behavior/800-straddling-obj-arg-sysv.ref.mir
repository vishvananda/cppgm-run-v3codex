machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @read_pair
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %pair -> r9 : i64
    param %pair -> [rbp+16] : i64
    return i64 -> rax
  frame
    stack_size 80
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx
    param-slot %a -> [rbp-8] : i64
    param-slot %b -> [rbp-16] : i64
    param-slot %c -> [rbp-24] : i64
    param-slot %d -> [rbp-32] : i64
    param-slot %e -> [rbp-40] : i64
    param-slot %pair -> [rbp-56] : obj<16x8>

  block ^entry
    store.i64 [rbp-8], rdi
    store.i64 [rbp-16], rsi
    store.i64 [rbp-24], rdx
    store.i64 [rbp-32], rcx
    store.i64 [rbp-40], r8
    store.i64 [rbp-56], r9
    load.i64 rax, [rbp+16]
    store.i64 [rbp-48], rax
    lea rcx, [rbp-56]
    load.i64 r8, [rcx]
    lea r9, [rbp-56]
    lea r9, [r9+8]
    load.i64 rbx, [r9]
    add r8, rbx
    mov rax, r8
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    slot $pair -> [rbp-16] : obj<16x8>

  block ^entry
    mov rax, 100
    lea rcx, [rbp-16]
    store.i64 [rcx], rax
    lea r8, [rbp-16]
    lea r8, [r8+8]
    mov rax, 23
    store.i64 [r8], rax
    sub rsp, 16
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    lea r11, [rbp-16]
    load.i64 r9, [r11]
    lea r11, [rbp-16]
    load.i64 r11, [r11+8]
    store.i64 [rsp], r11
    call @read_pair
    add rsp, 16
    mov r8, rax
    mov rdx, 123
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
