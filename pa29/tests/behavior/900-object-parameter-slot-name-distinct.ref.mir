machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @make_value
  abi
    return obj<8x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-8] : obj<8x8>

  block ^entry
    mov rax, 77
    lea rcx, [rbp-8]
    store.i64 [rcx], rax
    lea r11, [rbp-8]
    load.i64 rax, [r11]
    ret

function @read_parameter
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %value -> [rbp-8] : obj<8x8>
    slot $value -> [rbp-16] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], rdi
    mov rax, 99
    lea rcx, [rbp-16]
    store.i64 [rcx], rax
    load.i64 rax, [rbp-8]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    temp %value -> [rbp-8] : obj<8x8>

  block ^entry
    call @make_value
    lea r11, [rbp-8]
    store.i64 [r11], rax
    lea r11, [rbp-8]
    load.i64 rdi, [r11]
    call @read_parameter
    mov r8, rax
    mov rdx, 77
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
