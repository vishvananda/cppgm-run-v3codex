machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @cell
  storage data
  item i64 11

function @g
  abi
    param %a -> rdi : ptr
    param %b -> rsi : i64
    return ptr -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, rdi
    store.i64 [r8], rsi
    mov rax, r8
    ret rax

function @f
  abi
    param %this -> rdi : ptr
    param %hash -> rsi : i64
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r9, rdi
    mov r8, rsi
    call @g
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, @cell
    mov rdi, rbx
    mov rsi, 123
    call @f
    mov r8, rax
    cmp.ptr r8, rbx
    jne ^bad_ptr
    jmp ^check_value

  block ^bad_ptr
    mov rax, 1
    ret rax

  block ^check_value
    load.i64 r8, [rbx]
    mov rdx, 123
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rax, r8
    ret rax
