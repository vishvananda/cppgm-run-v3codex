machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @copied
  storage data
  item i64 0

function @make_tag_spilled
  abi
    return obj<8x8> -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $tmp -> [rbp-8] : obj<8x8>
    slot $force_spill -> [rbp-48] : obj<40x8>

  block ^entry
    mov rax, 77
    lea rcx, [rbp-8]
    store.i64 [rcx], rax
    lea r11, [rbp-8]
    load.i64 rax, [r11]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    temp %tag -> [rbp-8] : obj<8x8>

  block ^entry
    call @make_tag_spilled
    lea r11, [rbp-8]
    store.i64 [r11], rax
    mov r8, @copied
    mov rdi, r8
    lea rsi, [rbp-8]
    copy_bytes 8x8, rdi, rsi
    load.i64 r8, @copied
    mov rdx, 77
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
