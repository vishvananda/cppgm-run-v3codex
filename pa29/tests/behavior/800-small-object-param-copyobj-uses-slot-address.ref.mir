machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @copied
  storage data
  item i64 0

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @make_tag
  abi
    return obj<8x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $tmp -> [rbp-8] : obj<8x8>

  block ^entry
    mov rax, 77
    lea rcx, [rbp-8]
    store.i64 [rcx], rax
    lea r11, [rbp-8]
    load.i64 rax, [r11]
    ret

function @copy_after_call
  abi
    param %tag -> rdi : i64
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %tag -> [rbp-8] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], rdi
    call @touch
    mov r8, @copied
    mov rdi, r8
    lea rsi, [rbp-8]
    copy_bytes 8x8, rdi, rsi
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    temp %tag -> [rbp-8] : obj<8x8>

  block ^entry
    call @make_tag
    lea r11, [rbp-8]
    store.i64 [r11], rax
    lea r11, [rbp-8]
    load.i64 rdi, [r11]
    call @copy_after_call
    load.i64 r8, @copied
    mov rdx, 77
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
