machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @calc
  abi
    param %n -> rdi : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx
    slot $n -> [rbp-8] : i64

  block ^entry
    mov r8, rdi
    add r8, 0
    store.i64 [rbp-8], r8
    add r8, 2
    load.i64 rbx, [rbp-8]
    add r8, rbx
    mov rax, r8
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 10
    call @calc
    mov r8, rax
    mov rdx, 22
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
