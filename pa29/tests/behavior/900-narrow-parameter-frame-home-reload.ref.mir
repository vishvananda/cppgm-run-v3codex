machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @table
  storage data
  item i64 11
  item i64 22
  item i64 33

function @dirty_stack
  abi
    return void -> void
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $junk -> [rbp-64] : obj<64x8>

  block ^entry
    mov rax, -1
    lea rcx, [rbp-64]
    store.i64 [rcx], rax
    lea r8, [rbp-64]
    lea r8, [r8+8]
    mov rax, -1
    store.i64 [r8], rax
    lea r8, [rbp-64]
    lea r8, [r8+16]
    mov rax, -1
    store.i64 [r8], rax
    lea r8, [rbp-64]
    lea r8, [r8+24]
    mov rax, -1
    store.i64 [r8], rax
    lea r8, [rbp-64]
    lea r8, [r8+32]
    mov rax, -1
    store.i64 [r8], rax
    lea r8, [rbp-64]
    lea r8, [r8+40]
    mov rax, -1
    store.i64 [r8], rax
    lea r8, [rbp-64]
    lea r8, [r8+48]
    mov rax, -1
    store.i64 [r8], rax
    lea r8, [rbp-64]
    lea r8, [r8+56]
    mov rax, -1
    store.i64 [r8], rax
    ret

function @side_effect
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @lookup
  abi
    param %a -> rdi : i32
    param %b -> rsi : i32
    param %c -> rdx : i32
    param %d -> rcx : i32
    param %e -> r8 : i32
    param %level -> r9 : i32
    return i64 -> rax
  frame
    stack_size 96
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    param-slot %level -> [rbp-4] : i32
    temp %b64 -> [rbp-16] : i64
    temp %c64 -> [rbp-24] : i64
    temp %d64 -> [rbp-32] : i64
    temp %e64 -> [rbp-40] : i64

  block ^entry
    store.i32 [rbp-4], r9
    mov rbx, rdi
    mov r12, rsi
    mov r13, rdx
    mov r14, rcx
    mov r15, r8
    call @side_effect
    mov r8, @table
    load.i32 r9, [rbp-4]
    sext.i32 r9
    imul r9, 8
    mov rdx, r9
    add r8, rdx
    load.i64 r9, [r8]
    mov r8, rbx
    imul r8, 1
    mov rax, r12
    imul rax, 1
    store.i64 [rbp-16], rax
    mov rax, r13
    imul rax, 1
    store.i64 [rbp-24], rax
    mov rax, r14
    imul rax, 1
    store.i64 [rbp-32], rax
    mov rax, r15
    imul rax, 1
    store.i64 [rbp-40], rax
    add r9, r8
    load.i64 rdx, [rbp-16]
    add r9, rdx
    load.i64 rdx, [rbp-24]
    add r9, rdx
    load.i64 rdx, [rbp-32]
    add r9, rdx
    load.i64 rdx, [rbp-40]
    add r9, rdx
    mov rax, r9
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @dirty_stack
    mov rdi, 2
    mov rsi, 3
    mov rdx, 4
    mov rcx, 5
    mov r8, 6
    mov r9, 1
    call @lookup
    mov r8, rax
    cmp.i64 r8, 42
    je ^good
    jmp ^bad

  block ^good
    mov rax, 0
    ret rax

  block ^bad
    mov rax, 1
    ret rax
