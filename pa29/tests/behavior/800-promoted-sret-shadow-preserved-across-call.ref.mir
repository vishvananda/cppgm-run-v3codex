machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @saved_ret
  storage scalar ptr
  init ptr 0

function @clobber
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    return void -> void
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %a -> [rbp-8] : i64
    param-slot %b -> [rbp-16] : i64
    param-slot %c -> [rbp-24] : i64
    param-slot %d -> [rbp-32] : i64
    param-slot %e -> [rbp-40] : i64
    param-slot %f -> [rbp-48] : i64

  block ^entry
    store.i64 [rbp-8], rdi
    store.i64 [rbp-16], rsi
    store.i64 [rbp-24], rdx
    store.i64 [rbp-32], rcx
    store.i64 [rbp-40], r8
    store.i64 [rbp-48], r9
    ret

function @make_pair
  abi
    param %ret -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, rdi
    store.ptr @saved_ret, rdi
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    call @clobber
    mov r8, rbx
    mov rax, 11
    store.i64 [r8], rax
    mov r8, rbx
    lea r8, [r8+8]
    mov rax, 22
    store.i64 [r8], rax
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12
    slot $out -> [rbp-16] : obj<16x8>

  block ^entry
    lea rdi, [rbp-16]
    call @make_pair
    load.ptr r8, @saved_ret
    lea rdx, [rbp-16]
    cmp.ptr r8, rdx
    sete r8
    movzx r8, r8
    lea rcx, [rbp-16]
    load.i64 r9, [rcx]
    lea rbx, [rbp-16]
    lea rbx, [rbx+8]
    load.i64 r12, [rbx]
    mov rdx, 11
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov rdx, 22
    cmp.i64 r12, rdx
    sete r12
    movzx r12, r12
    and r9, r12
    and r8, r9
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
