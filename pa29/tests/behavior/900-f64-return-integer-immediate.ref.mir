machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @one
  abi
    return f64 -> xmm0
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    fmov.f64 xmm0, 1
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    call @one
    fmov.f64 xmm0, xmm0
    feq.f64 rax, xmm0, 1.0
    mov r8, rax
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
