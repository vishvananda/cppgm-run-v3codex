machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @cell
  storage data
  item i64 0

global @source
  storage data
  item i64 11
  item i64 22
  item i64 33
  item i64 44

global @dest
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0
  item i64 0

function @mark
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, rdi
    mov rax, 99
    store.i64 [r8], rax
    ret

function @copy_then_mark_base
  abi
    param %this -> rdi : ptr
    return void -> void
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12

  block ^entry
    mov r8, rdi
    mov r9, rdi
    mov rbx, @source
    mov r12, @dest
    mov rdi, r12
    mov rsi, rbx
    copy_bytes 24x8, rdi, rsi
    mov rdi, r9
    call @mark
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, @cell
    mov rdi, r8
    call @copy_then_mark_base
    load.i64 r8, @cell
    mov rdx, 99
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 0
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
