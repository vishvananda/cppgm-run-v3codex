machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cell
  storage data
  item i64 41

function @touch
  abi
    param %p -> rdi : ptr
    param %n -> rsi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rsi

function @dispatch
  abi
    param %which -> rdi : i64
    param %this -> rsi : ptr
    param %n -> rdx : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1>

  block ^entry
    mov <gpr1>, rsi
    mov <gpr0>, rdx
    mov rax, rdi
    mov rcx, 1
    cmp.i64 rax, rcx
    je ^case
    jmp ^miss

  block ^case
    mov rdi, rsi
    mov rsi, rdx
    call @touch [args=(rsi,rdi)]
    mov rdi, <gpr1>
    mov rsi, <gpr0>
    call @touch [args=(rsi,rdi)]
    ret rax

  block ^miss
    mov rax, 0
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    mov rsi, @cell
    mov rdx, 7
    call @dispatch [args=(rdx,rsi,rdi)]
    mov r8, rax
    cmp.i64 r8, 7
    je ^good
    jmp ^bad

  block ^good
    mov rax, 0
    ret rax

  block ^bad
    mov rax, 1
    ret rax
