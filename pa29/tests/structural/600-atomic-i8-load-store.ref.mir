machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar i8
  init i8 7

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, @g
    load.i8 r9, [r8]
    add r9, 1
    sext.i8 r9
    store.i8 [r8], r9
    load.i8 r9, [r8]
    mov rdx, 8
    cmp.i8 r9, rdx
    sete rax
    movzx rax, rax
    ret rax
