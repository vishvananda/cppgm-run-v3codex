machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @sum8
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    param %g -> [rbp+<off0>] : i64
    param %h -> [rbp+<off1>] : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    param-slot %g -> [rbp-<off0>] : i64
    param-slot %h -> [rbp-<off1>] : i64

  block ^entry
    load.i64 rax, [rbp+<off0>]
    store.i64 [rbp-<off0>], rax
    load.i64 rax, [rbp+<off1>]
    store.i64 [rbp-<off1>], rax
    mov <gpr0>, rdx
    mov <gpr1>, rcx
    mov <gpr2>, r8
    mov <gpr3>, r9
    mov r9, rsi
    mov <gpr4>, rdi
    add <gpr4>, r9
    add <gpr4>, <gpr0>
    add <gpr4>, <gpr1>
    add <gpr4>, <gpr2>
    add <gpr4>, <gpr3>
    load.i64 rdx, [rbp-<off0>]
    add <gpr4>, rdx
    load.i64 rdx, [rbp-<off1>]
    add <gpr4>, rdx
    mov rax, <gpr4>
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    temp %r -> [rbp-<off0>] : i64

  block ^entry
    sub rsp, 16
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    mov <gpr5>, 7
    store.i64 [rsp], <gpr5>
    mov <gpr5>, 8
    store.i64 [rsp+<off0>], <gpr5>
    call @sum8 [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    store.i64 [rbp-<off0>], rax
    load.i64 r8, [rbp-<off0>]
    sub r8, 36
    mov rax, r8
    ret rax
