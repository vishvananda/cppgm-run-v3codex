machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @seen
  storage scalar i32
  init i32 0

global @pair
  storage data
  item f64 1.0
  item i32 2

function @check
  abi
    param %p -> rdi : ptr
    return void -> void
  frame
    stack_size 48
    scratch_bytes 48

  block ^entry
    mov r8, rdi
    fmov.f64 xmm0, [r8]
    fcmp.f64 xmm0, 0.0
    jp ^rhs
    jne ^rhs
    jmp ^end

  block ^rhs
    load.i32 r8, [rdi+<off0>]
    sext.i32 r8
    cmp.i32 r8, 0
    jne ^then
    jmp ^end

  block ^then
    mov rax, 1
    store.i32 @seen, rax
    jmp ^end

  block ^end
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    mov rdi, @pair
    call @check [args=(rdi)]
    cmp.i32 @seen, 1
    je ^pass
    jmp ^fail

  block ^pass
    mov rax, 0
    ret rax

  block ^fail
    mov rax, 1
    ret rax
