machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @make_value
  abi
    return obj<8x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $tmp -> [rbp-<off0>] : obj<8x8>

  block ^entry
    store.i64 [rbp-<off0>], 7
    load.i64 rax, [rbp-<off0>]
    ret

function @unwrap
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $x -> [rbp-<off0>] : obj<8x8>

  block ^entry
    call @make_value [args=()]
    store.i64 [rbp-<off0>], rax
    load.i64 rax, [rbp-<off0>]
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @unwrap [args=()]
    ret rax
