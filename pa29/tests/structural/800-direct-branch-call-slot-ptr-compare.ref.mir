machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cells
  storage data
  item i64 11
  item i64 13

function @clobber
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    return void -> void
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $first -> [rbp-8] : ptr
    slot $last -> [rbp-16] : ptr

  block ^entry
    mov r8, @cells
    store.ptr [rbp-8], r8
    store.ptr [rbp-16], r8
    mov rdi, 10
    mov rsi, 20
    mov rdx, 30
    mov rcx, 40
    mov r8, 50
    mov r9, 60
    call @clobber [args=(rcx,rdx,rsi,rdi,r8,r9)]
    load.ptr rax, [rbp-8]
    cmp.ptr rax, [rbp-16]
    je ^done
    jmp ^body

  block ^body
    mov rax, 1
    ret rax

  block ^done
    mov rax, 0
    ret rax
