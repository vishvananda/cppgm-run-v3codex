machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $x -> [rbp-2] : u16

  block ^entry
    store.u16 [rbp-2], 65535
    load.u16 r8, [rbp-2]
    cmp.i64 r8, 65535
    sete rax
    movzx rax, rax
    ret rax
