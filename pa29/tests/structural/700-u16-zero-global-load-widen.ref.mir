machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g
  storage scalar u16
  init u16 65535

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    load.u16 r8, @g
    zext.i16 r8
    cmp.i64 r8, 65535
    sete rax
    movzx rax, rax
    ret rax
