machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    slot $x -> [rbp-<off0>] : i8

  block ^entry
    mov rax, -1
    store.i8 [rbp-<off0>], rax
    lea rcx, [rbp-<off0>]
    load.i8 r8, [rcx]
    sext.i8 r8
    cmp.i64 r8, -1
    sete rax
    movzx rax, rax
    ret rax
