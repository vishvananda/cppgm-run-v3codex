machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @add1
  abi
    param %x -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0

  block ^entry
    add rdi, 1
    mov rax, rdi
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    preserve <gpr0>

  block ^entry
    mov <gpr0>, 7
    add <gpr0>, 8
    mov rdi, 20
    call @add1 [args=(rdi)]
    mov r8, rax
    add <gpr0>, r8
    mov rax, <gpr0>
    ret rax
