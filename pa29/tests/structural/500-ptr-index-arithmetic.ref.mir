machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cells
  storage data
  item i64 11
  item i64 13

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, @cells
    lea r9, [r8+8]
    mov rdi, r9
    sub rdi, r8
    load.i64 r8, [r9]
    mov rdx, 1
    cmp.i64 rdi, rdx
    sete rdi
    movzx rdi, rdi
    mov rdx, 13
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    and rdi, r8
    ret rdi
