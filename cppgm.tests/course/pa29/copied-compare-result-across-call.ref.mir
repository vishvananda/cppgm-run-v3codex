machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @zero
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    mov rax, 0
    ret rax

function @clobber_caller_saved
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    param-slot %a -> [rbp-8] : i64
    param-slot %b -> [rbp-16] : i64
    param-slot %c -> [rbp-24] : i64
    param-slot %d -> [rbp-32] : i64
    param-slot %e -> [rbp-40] : i64

  block ^entry
    store.i64 [rbp-8], rdi
    store.i64 [rbp-16], rsi
    store.i64 [rbp-24], rdx
    store.i64 [rbp-32], rcx
    store.i64 [rbp-40], r8
    mov rax, 0
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    preserve rbx

  block ^entry
    call @zero [args=()]
    mov rdx, 0
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    mov rbx, rax
    zext.i8 rbx
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    call @clobber_caller_saved [args=(rcx,rdx,rsi,rdi,r8)]
    mov rax, rbx
    zext.i8 rax
    sext.i32 rax
    ret rax
