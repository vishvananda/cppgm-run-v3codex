machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @preserve_third
  abi
    param %first -> rdi : i64
    param %second -> rsi : i64
    param %third -> rdx : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %first_wide -> [rbp-16] : i128
    temp %second_wide -> [rbp-16] : i128
    temp %third_wide -> [rbp-16] : i128

  block ^entry
    mov r8, rdx
    mov rax, rdi
    cqo
    store.i64 [rbp-16], rax
    store.i64 [rbp-8], rdx
    mov rax, rsi
    cqo
    store.i64 [rbp-16], rax
    store.i64 [rbp-8], rdx
    mov rax, r8
    cqo
    store.i64 [rbp-16], rax
    store.i64 [rbp-8], rdx
    lea r11, [rbp-16]
    load.i64 r9, [r11]
    ret r9

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 14
    call @preserve_third [args=(rdx,rsi,rdi)]
    mov rdx, 14
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
