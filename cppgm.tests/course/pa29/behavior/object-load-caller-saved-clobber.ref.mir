machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12
    slot $a -> [rbp-8] : i64
    slot $b -> [rbp-16] : i64
    slot $c -> [rbp-24] : i64
    slot $d -> [rbp-32] : i64
    slot $object -> [rbp-40] : obj<8x8>
    temp %unused -> [rbp-48] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], 10
    store.i64 [rbp-16], 20
    store.i64 [rbp-24], 30
    store.i64 [rbp-32], 40
    store.i64 [rbp-40], 7
    load.i64 r8, [rbp-8]
    load.i64 r9, [rbp-16]
    load.i64 rbx, [rbp-24]
    load.i64 r12, [rbp-32]
    lea rdi, [rbp-48]
    lea rsi, [rbp-40]
    copy_bytes 8x8, rdi, rsi
    add r8, r9
    add r8, rbx
    add r8, r12
    mov rdx, 100
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rax, r8
    sext.i32 rax
    ret rax
