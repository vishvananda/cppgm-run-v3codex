machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @read_fifth
  abi
    param %unused0 -> rdi : ptr
    param %unused1 -> rsi : i64
    param %unused2 -> rdx : i64
    param %unused3 -> rcx : i64
    param %value -> r8 : ptr
    param %unused5 -> r9 : i64
    param %unused6 -> [rbp+16] : i64
    return i64 -> rax
  frame
    stack_size 80
    scratch_bytes 0
    preserve rbx
    param-slot %unused0 -> [rbp-8] : ptr
    param-slot %unused1 -> [rbp-16] : i64
    param-slot %unused2 -> [rbp-24] : i64
    param-slot %unused3 -> [rbp-32] : i64
    param-slot %unused5 -> [rbp-40] : i64
    param-slot %unused6 -> [rbp-48] : i64
    slot $scratch1 -> [rbp-56] : i64
    slot $scratch2 -> [rbp-64] : i64

  block ^entry
    store.ptr [rbp-8], rdi
    store.i64 [rbp-16], rsi
    store.i64 [rbp-24], rdx
    store.i64 [rbp-32], rcx
    store.i64 [rbp-40], r9
    load.i64 rax, [rbp+16]
    store.i64 [rbp-48], rax
    mov r9, r8
    load.i64 rbx, [r9]
    mov rax, 11
    lea rcx, [rbp-56]
    store.i64 [rcx], rax
    mov rax, 22
    lea rcx, [rbp-64]
    store.i64 [rcx], rax
    mov rax, rbx
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    slot $value -> [rbp-8] : i64

  block ^entry
    mov rax, 77
    lea rcx, [rbp-8]
    store.i64 [rcx], rax
    sub rsp, 16
    lea rdi, [rbp-8]
    mov rsi, 1
    mov rdx, 2
    mov rcx, 3
    lea r8, [rbp-8]
    mov r9, 5
    mov r11, 6
    store.i64 [rsp], r11
    call @read_fifth
    add rsp, 16
    mov r8, rax
    mov rdx, 77
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
