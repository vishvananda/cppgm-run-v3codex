machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @value
  storage scalar i64
  init i64 11

function @produce
  abi
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    mov r8, @value
    mov rax, r8
    ret rax

function @read
  abi
    param %address -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0

  block ^entry
    mov r8, rdi
    load.i64 rax, [r8]
    ret rax

function @exercise
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    return i64 -> rax
  frame
    stack_size 112
    scratch_bytes 0
    preserve rbx r12 r13 r14 r15
    slot $other -> [rbp-8] : i64
    temp %saved -> [rbp-16] : ptr
    temp %first -> [rbp-24] : i64
    temp %second -> [rbp-32] : i64
    temp %third -> [rbp-40] : i64
    temp %values1 -> [rbp-48] : i64
    temp %values2 -> [rbp-56] : i64
    temp %values3 -> [rbp-64] : i64

  block ^entry
    mov rbx, rdi
    mov r12, rsi
    mov r13, rdx
    mov r14, rcx
    mov r15, r8
    mov rax, 22
    store.i64 [rbp-8], rax
    call @produce
    store.ptr [rbp-16], rax
    load.ptr rdi, [rbp-16]
    call @read
    store.i64 [rbp-24], rax
    lea rdi, [rbp-8]
    call @read
    store.i64 [rbp-32], rax
    load.ptr rdi, [rbp-16]
    call @read
    store.i64 [rbp-40], rax
    lea rdi, [rbp-8]
    call @read
    mov r8, rax
    mov r9, rbx
    add r9, r12
    add r9, r13
    add r9, r14
    add r9, r15
    load.i64 rax, [rbp-24]
    load.i64 rdx, [rbp-32]
    add rax, rdx
    store.i64 [rbp-48], rax
    load.i64 rax, [rbp-48]
    load.i64 rdx, [rbp-40]
    add rax, rdx
    store.i64 [rbp-56], rax
    load.i64 rax, [rbp-56]
    add rax, r8
    store.i64 [rbp-64], rax
    load.i64 r8, [rbp-64]
    add r8, r9
    mov rax, r8
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    call @exercise
    mov r8, rax
    mov rdx, 81
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
