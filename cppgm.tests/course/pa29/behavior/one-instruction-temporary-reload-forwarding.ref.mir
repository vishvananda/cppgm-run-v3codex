machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @cells
  storage data
  item i64 17
  item i64 19

global @observed
  storage scalar i64
  init i64 0

function @probe
  abi
    param %base -> rdi : ptr
    param %a -> rsi : i64
    param %b -> rdx : i64
    param %c -> rcx : i64
    param %d -> r8 : i64
    return i64 -> rax
  frame
    stack_size 144
    scratch_bytes 0
    preserve r12 r13 r14 r15
    temp %indexed -> [rbp-8] : ptr
    temp %single -> [rbp-16] : i64
    temp %second_index -> [rbp-24] : ptr
    temp %loaded -> [rbp-32] : i64
    temp %ab -> [rbp-40] : i64
    temp %cd -> [rbp-48] : i64
    temp %ac -> [rbp-56] : i64
    temp %bd -> [rbp-64] : i64
    temp %left -> [rbp-72] : i64
    temp %right -> [rbp-80] : i64
    temp %parameters -> [rbp-88] : i64
    temp %observed -> [rbp-96] : i64

  block ^entry
    mov r9, rdx
    mov r12, rcx
    mov r13, r8
    mov r14, 100
    mov r15, 200
    store.ptr [rbp-8], rdi
    mov rax, 11
    store.i64 [rbp-16], rax
    load.ptr rax, [rbp-8]
    lea rax, [rax+8]
    store.ptr [rbp-24], rax
    load.i64 rax, [rbp-16]
    store.i64 @observed, rax
    load.ptr rcx, [rbp-24]
    load.i64 rax, [rcx]
    store.i64 [rbp-32], rax
    mov rax, rsi
    add rax, r9
    store.i64 [rbp-40], rax
    mov rax, r12
    add rax, r13
    store.i64 [rbp-48], rax
    mov rax, rsi
    add rax, r12
    store.i64 [rbp-56], rax
    mov rax, r9
    add rax, r13
    store.i64 [rbp-64], rax
    load.i64 rax, [rbp-40]
    load.i64 rdx, [rbp-48]
    add rax, rdx
    store.i64 [rbp-72], rax
    load.i64 rax, [rbp-56]
    load.i64 rdx, [rbp-64]
    add rax, rdx
    store.i64 [rbp-80], rax
    load.i64 rax, [rbp-72]
    load.i64 rdx, [rbp-80]
    add rax, rdx
    store.i64 [rbp-88], rax
    load.i64 rax, @observed
    store.i64 [rbp-96], rax
    add r14, r15
    load.i64 r15, [rbp-32]
    load.i64 rdx, [rbp-96]
    add r15, rdx
    add r14, r15
    load.i64 rdx, [rbp-88]
    add r14, rdx
    mov rax, r14
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48

  block ^entry
    mov r8, @cells
    mov rdi, r8
    mov rsi, 1
    mov rdx, 2
    mov rcx, 3
    mov r8, 4
    call @probe
    mov r9, rax
    mov rdx, 350
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov r8, r9
    sext.i32 r8
    mov rax, r8
    ret rax
