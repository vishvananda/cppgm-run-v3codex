machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cells
  storage data
  item i64 17
  item i64 19

global @observed
  storage scalar i64
  init i64 0

function @probe
  abi
    param %base -> rdi : ptr
    param %a -> rsi : i64
    param %b -> rdx : i64
    param %c -> rcx : i64
    param %d -> r8 : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15

  block ^entry
    store.i64 @observed, 11
    load.i64 rbx, [rdi+8]
    mov r12, rsi
    add r12, rdx
    mov r13, rcx
    add r13, r8
    mov r14, rsi
    add r14, rcx
    mov r15, rdx
    add r15, r8
    add r12, r13
    add r14, r15
    add r12, r14
    load.i64 r13, @observed
    mov r14, 100
    add r14, 200
    add rbx, r13
    add r14, rbx
    add r14, r12
    ret r14

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @cells
    mov rsi, 1
    mov rdx, 2
    mov rcx, 3
    mov r8, 4
    call @probe [args=(rcx,rdx,rsi,rdi,r8)]
    mov rdx, 350
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
