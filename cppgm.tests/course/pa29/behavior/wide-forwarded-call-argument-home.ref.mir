machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @one
  storage scalar i64
  init i64 1

global @two
  storage scalar i64
  init i64 2

global @three
  storage scalar i64
  init i64 3

global @four
  storage scalar i64
  init i64 4

global @five
  storage scalar i64
  init i64 5

global @six
  storage scalar i64
  init i64 6

global @seven
  storage scalar i64
  init i64 7

global @observed
  storage scalar i64
  init i64 0

global @cppgm_priv_exc_top
  storage scalar ptr
  init ptr 0

global @cppgm_priv_exc_value
  storage scalar ptr
  init ptr 0

function @cppgm_priv_exc_unhandled
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @target
  abi
    param %a -> rdi : ptr
    param %b -> rsi : ptr
    param %c -> rdx : ptr
    param %d -> rcx : ptr
    param %e -> r8 : ptr
    param %f -> r9 : ptr
    param %g -> [rbp+16] : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %g -> [rbp-8] : ptr

  block ^entry
    load.ptr rax, [rbp+16]
    store.ptr [rbp-8], rax
    load.i64 rax, [r9]
    store.i64 @observed, rax
    ret

function @consume
  abi
    param %value -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @forward
  abi
    param %a -> rdi : ptr
    param %b -> rsi : ptr
    param %c -> rdx : ptr
    param %d -> rcx : ptr
    param %e -> r8 : ptr
    param %f -> r9 : ptr
    param %g -> [rbp+16] : ptr
    return void -> void
  frame
    stack_size 80
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %a -> [rbp-8] : ptr
    param-slot %b -> [rbp-16] : ptr
    param-slot %c -> [rbp-24] : ptr
    param-slot %d -> [rbp-32] : ptr
    param-slot %e -> [rbp-40] : ptr
    param-slot %f -> [rbp-48] : ptr
    param-slot %g -> [rbp-56] : ptr
    slot $temporary -> [rbp-64] : i64
    temp %host-eh-exception -> [rbp-72] : ptr
    temp %host-eh-selector -> [rbp-80] : i64

  block ^entry
    store.ptr [rbp-8], rdi
    store.ptr [rbp-16], rsi
    store.ptr [rbp-24], rdx
    store.ptr [rbp-32], rcx
    store.ptr [rbp-40], r8
    store.ptr [rbp-48], r9
    load.ptr rax, [rbp+16]
    store.ptr [rbp-56], rax
    eh_push ^unwind, 0
    sub rsp, 16
    load.ptr r11, [rbp-56]
    store.ptr [rsp], r11
    lea rdi, [rbp-64]
    call @target [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    eh_pop
    jmp ^done

  block ^unwind
    resume

  block ^done
    load.ptr rdi, [rbp-8]
    call @consume [args=(rdi)]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    sub rsp, 16
    mov r11, @seven
    store.ptr [rsp], r11
    mov rdi, @one
    mov rsi, @two
    mov rdx, @three
    mov rcx, @four
    mov r8, @five
    mov r9, @six
    call @forward [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    load.i64 r8, @observed
    mov rdx, 6
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rax, r8
    sext.i32 rax
    ret rax
