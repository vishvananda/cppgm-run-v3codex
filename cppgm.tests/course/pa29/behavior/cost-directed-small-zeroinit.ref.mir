machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @one
  storage data
  item i8 17

global @four
  storage data
  item i32 572662306

global @eight
  storage data
  item i64 3689348814741910323

global @sixteen
  storage data
  item i64 4919131752989213764
  item i64 6148914691236517205

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, @one
    zero_bytes 1x1, r8
    mov rdx, 0
    cmp.i8 @one, rdx
    jne ^bad
    jmp ^four

  block ^four
    mov r8, @four
    zero_bytes 4x4, r8
    cmp.i32 @four, 0
    jne ^bad
    jmp ^eight

  block ^eight
    mov r8, @eight
    zero_bytes 8x8, r8
    cmp.i64 @eight, 0
    jne ^bad
    jmp ^sixteen

  block ^sixteen
    mov r8, @sixteen
    zero_bytes 16x8, r8
    load.i64 r9, @sixteen
    or r9, [r8+8]
    cmp.i64 r9, 0
    jne ^bad
    jmp ^ok

  block ^bad
    mov rax, 1
    ret rax

  block ^ok
    mov rax, 0
    ret rax
