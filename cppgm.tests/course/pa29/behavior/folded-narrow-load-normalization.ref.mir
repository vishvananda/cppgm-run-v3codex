machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @sink
  storage scalar i64
  init i64 0

function @accept
  abi
    param %value -> rdi : u8
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, rdi
    mov rcx, 2
    cmp.i64 rax, rcx
    je ^good
    jmp ^bad

  block ^good
    mov rax, 0
    ret rax

  block ^bad
    mov rax, 1
    ret rax

function @get_record
  abi
    param %one -> rdi : i64
    param %two -> rsi : i64
    param %three -> rdx : i64
    param %four -> rcx : i64
    param %five -> r8 : i64
    param %record -> r9 : ptr
    return ptr -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret r9

function @reduced
  abi
    param %record -> rdi : ptr
    return i32 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %host-eh-exception -> [rbp-8] : ptr
    temp %host-eh-selector -> [rbp-16] : i64
    temp %entity -> [rbp-24] : ptr

  block ^entry
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, rdi
    mov rdi, 1
    call @get_record [args=(rcx,rdx,rsi,rdi,r8,r9), unwind=no]
    store.ptr [rbp-24], rax
    eh_push ^unwind, 0
    load.ptr r8, [rbp-24]
    lea r8, [r8+8]
    load.u8 r9, [r8]
    mov r8, 20
    add r8, 22
    store.i64 @sink, r8
    mov rdi, r9
    call @accept [args=(rdi)]
    mov r8, rax
    sext.i32 r8
    eh_pop
    ret r8

  block ^unwind
    resume

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    slot $record -> [rbp-16] : obj<16x8>

  block ^entry
    lea r8, [rbp-16]
    store.u8 [r8+8], 2
    mov rdi, r8
    call @reduced [args=(rdi)]
    ret rax
