machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @false_condition
  abi
    return u8 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    mov rax, 0
    ret rax

function @clobber_return_register
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    mov rax, 1
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    preserve rbx

  block ^entry
    call @false_condition
    mov rbx, rax
    zext.i8 rbx
    call @clobber_return_register
    mov rax, rbx
    cmp.i64 rax, 0
    jne ^wrong
    jmp ^correct

  block ^wrong
    mov rax, 1
    ret rax

  block ^correct
    mov rax, 0
    ret rax
