    store.i64 [rbp-96], r13
    load.i64 r13, [rbp-8]
    add r13, [rbp-16]
    store.i64 [rbp-104], r12
    load.i64 r12, [rbp-24]
    add r12, [rbp-32]
    store.i64 [rbp-112], rbx
    load.i64 rbx, [rbp-40]
    add rbx, [rbp-48]
    store.i64 [rbp-120], rsi
    load.i64 rsi, [rbp-56]
    add rsi, [rbp-64]
    add r15, r14
    add r13, r12
    add rbx, rsi
    fadd.f64 xmm0, 1.5, 2.5
    add r8, r9
    add rdi, [rbp-120]
    load.i64 r9, [rbp-112]
    add r9, [rbp-104]
    load.i64 rsi, [rbp-80]
    add rsi, [rbp-72]
    load.i64 r12, [rbp-8]
    add r12, [rbp-16]
    load.i64 r14, [rbp-24]
    add r14, [rbp-32]
    store.i64 [rbp-120], rbx
    load.i64 rbx, [rbp-40]
    add rbx, [rbp-48]
    store.i64 [rbp-112], r13
    load.i64 r13, [rbp-56]
    add r13, [rbp-64]
    add r8, rdi
    add r9, rsi
    add r12, r14
    add rbx, r13
    add r8, r9
    add r12, rbx
    add r8, r12
    load.i64 r9, [rbp-88]
    add r9, [rbp-96]
    add r15, r9
    load.i64 r9, [rbp-112]
    add r9, [rbp-120]
    add r15, r9
    add r8, r15
    fne.f64 rax, xmm0, 4.0
    mov r9, rax
    add r8, r9
    ret r8

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    call @sum_under_pressure [args=()]
    mov rbx, rax
    call @sum_under_float_pressure [args=()]
    mov r8, rax
    mov rdx, 272
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 272
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    or rbx, r8
    ret rbx
