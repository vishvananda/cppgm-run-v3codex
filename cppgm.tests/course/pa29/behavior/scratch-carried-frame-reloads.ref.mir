    temp %x3 -> [rbp-96] : i64
    temp %x4 -> [rbp-104] : i64
    temp %x5 -> [rbp-112] : i64
    temp %x6 -> [rbp-120] : i64

  block ^entry
    load.i64 r8, @v0
    load.i64 r9, @v1
    load.i64 rdi, @v2
    load.i64 rsi, @v3
    load.i64 rbx, @v4
    load.i64 r12, @v5
    load.i64 r13, @v6
    load.i64 r14, @v7
    load.i64 r15, @v8
    store.i64 [rbp-8], r15
    load.i64 r15, @v9
    store.i64 [rbp-16], r15
    load.i64 r15, @v10
    store.i64 [rbp-24], r15
    load.i64 r15, @v11
    store.i64 [rbp-32], r15
    load.i64 r15, @v12
    store.i64 [rbp-40], r15
    load.i64 r15, @v13
    store.i64 [rbp-48], r15
    load.i64 r15, @v14
    store.i64 [rbp-56], r15
    load.i64 r15, @v15
    store.i64 [rbp-64], r15
    mov r15, r8
    add r15, r9
    store.i64 [rbp-72], r15
    mov r15, rdi
    add r15, rsi
    store.i64 [rbp-80], r15
    mov r15, rbx
    add r15, r12
    store.i64 [rbp-88], r15
    mov r15, r13
    add r15, r14
    store.i64 [rbp-96], r15
    load.i64 r15, [rbp-8]
    add r15, [rbp-16]
    store.i64 [rbp-104], r15
    load.i64 r15, [rbp-24]
    add r15, [rbp-32]
    store.i64 [rbp-112], r15
    load.i64 r15, [rbp-40]
    add r15, [rbp-48]
    store.i64 [rbp-120], r15
    load.i64 r15, [rbp-56]
    add r15, [rbp-64]
    add r8, r9
    add rdi, rsi
    add rbx, r12
    add r13, r14
    load.i64 r9, [rbp-8]
    add r9, [rbp-16]
    load.i64 rsi, [rbp-24]
    add rsi, [rbp-32]
    load.i64 r12, [rbp-40]
    add r12, [rbp-48]
    load.i64 r14, [rbp-56]
    add r14, [rbp-64]
    add r8, rdi
    add rbx, r13
    add r9, rsi
    add r12, r14
    add r8, rbx
    add r9, r12
    add r8, r9
    load.i64 r9, [rbp-72]
    add r9, [rbp-80]
    load.i64 rdi, [rbp-88]
    add rdi, [rbp-96]
    load.i64 rsi, [rbp-104]
    add rsi, [rbp-112]
    load.i64 rbx, [rbp-120]
    add rbx, r15
    add r9, rdi
    add rsi, rbx
    add r9, rsi
    add r8, r9
    ret r8

function @sum_under_float_pressure
  abi
    return i64 -> rax
  frame
    stack_size 208
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %v8 -> [rbp-8] : i64
    temp %v9 -> [rbp-16] : i64
    temp %v10 -> [rbp-24] : i64
    temp %v11 -> [rbp-32] : i64
    temp %v12 -> [rbp-40] : i64
    temp %v13 -> [rbp-48] : i64
    temp %v14 -> [rbp-56] : i64
    temp %v15 -> [rbp-64] : i64
