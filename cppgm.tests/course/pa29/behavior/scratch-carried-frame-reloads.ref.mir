function @sum_under_pressure
  abi
    return i64 -> rax
  frame
    stack_size 160
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %v8 -> [rbp-8] : i64
    temp %v9 -> [rbp-16] : i64
    temp %v10 -> [rbp-24] : i64
    temp %v11 -> [rbp-32] : i64
    temp %v12 -> [rbp-40] : i64
