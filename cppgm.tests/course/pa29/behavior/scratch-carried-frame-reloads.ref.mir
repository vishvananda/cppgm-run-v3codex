    load.i64 r9, @v1
    load.i64 rdi, @v2
    load.i64 rsi, @v3
    load.i64 rbx, @v4
    load.i64 r12, @v5
    load.i64 r13, @v6
    load.i64 r14, @v7
    load.i64 r15, @v8
    store.i64 [rbp-8], r15
    load.i64 r15, @v9
    store.i64 [rbp-16], r15
    load.i64 r15, @v10
    store.i64 [rbp-24], r15
    load.i64 r15, @v11
    store.i64 [rbp-32], r15
    load.i64 r15, @v12
    store.i64 [rbp-40], r15
    load.i64 r15, @v13
    store.i64 [rbp-48], r15
    load.i64 r15, @v14
    store.i64 [rbp-56], r15
    load.i64 r15, @v15
    store.i64 [rbp-64], r15
    mov r15, r8
    add r15, r9
    store.i64 [rbp-72], r14
    mov r14, rdi
    add r14, rsi
    store.i64 [rbp-80], r13
    mov r13, rbx
    add r13, r12
    store.i64 [rbp-88], r13
    load.i64 r13, [rbp-80]
