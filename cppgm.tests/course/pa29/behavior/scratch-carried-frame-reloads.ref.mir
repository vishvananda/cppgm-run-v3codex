    temp %v5 -> [rbp-104] : i64
    temp %v4 -> [rbp-112] : i64
    temp %v3 -> [rbp-120] : i64
    temp %x11 -> [rbp-120] : i64
    temp %x10 -> [rbp-112] : i64

