machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @state
  storage data
  item i64 0
  item i64 0

global @shift_state
  storage data
  item i64 0
  item i64 0

function @loop_shift
  abi
    param %result -> rdi : ptr
    param %value -> rsi : i64
    param %limit -> rdx : i64
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12

  block ^entry
    mov r8, rdx
    store.i64 [rdi+8], 0
    jmp ^condition

  block ^condition
    load.i64 r9, [rdi+8]
    cmp.i64 r9, r8
    jb ^body
    jmp ^done

  block ^body
    mov rbx, r9
    imul rbx, 8
    mov r12, rsi
    mov rcx, rbx
    shr r12, cl
    and r12, 255
    store.i64 [rdi], r12
    mov rbx, r9
    add rbx, 1
    store.i64 [rdi+8], rbx
    jmp ^condition

  block ^done
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12
    temp %stable -> [rbp-8] : ptr
    temp %counter -> [rbp-16] : ptr

  block ^entry
    mov r8, @state
    store.ptr [rbp-8], r8
    lea r8, [r8+8]
    store.ptr [rbp-16], r8
    load.ptr rcx, [rbp-16]
    store.i64 [rcx], 0
    jmp ^condition

  block ^condition
    load.ptr rcx, [rbp-16]
    load.i64 r8, [rcx]
    cmp.i64 r8, 2
    jb ^body
    jmp ^done

  block ^body
    load.ptr rcx, [rbp-8]
    store.i64 [rcx], 7
    mov r9, r8
    add r9, 1
    load.ptr rcx, [rbp-16]
    store.i64 [rcx], r9
    jmp ^condition

  block ^done
    mov r9, @state
    load.i64 rdi, [r9]
    mov rbx, rdi
    mov rdx, 7
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov r12, @shift_state
    mov rdi, r12
    mov rsi, 118046
    mov rdx, 3
    call @loop_shift [args=(rdx,rsi,rdi)]
    load.i64 r9, [r12]
    mov rdx, 1
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    or rbx, r9
    mov rax, rbx
    sext.i32 rax
    ret rax
