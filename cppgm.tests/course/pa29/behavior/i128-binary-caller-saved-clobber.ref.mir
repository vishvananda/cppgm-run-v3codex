machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 96
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12
    slot $a -> [rbp-8] : i64
    slot $b -> [rbp-16] : i64
    slot $c -> [rbp-24] : i64
    slot $d -> [rbp-32] : i64
    temp %left -> [rbp-48] : i128
    temp %right -> [rbp-64] : i128
    temp %unused -> [rbp-80] : i128

  block ^entry
    store.i64 [rbp-8], 10
    store.i64 [rbp-16], 20
    store.i64 [rbp-24], 30
    store.i64 [rbp-32], 40
    load.i64 r8, [rbp-8]
    load.i64 r9, [rbp-16]
    load.i64 rbx, [rbp-24]
    load.i64 r12, [rbp-32]
    mov rax, 3
    mov rdx, 0
    lea r11, [rbp-48]
    store.i64 [r11], rax
    store.i64 [r11+8], rdx
    mov rax, 4
    mov rdx, 0
    lea r11, [rbp-64]
    store.i64 [r11], rax
    store.i64 [r11+8], rdx
    lea r11, [rbp-48]
    load.i64 rax, [r11]
    load.i64 rdx, [r11+8]
    lea r11, [rbp-64]
    load.i64 rcx, [r11]
    load.i64 rsi, [r11+8]
    add rax, rcx
    setb r10
    movzx r10, r10
    add rdx, rsi
    add rdx, r10
    lea r11, [rbp-80]
    store.i64 [r11], rax
    store.i64 [r11+8], rdx
    add r8, r9
    add r8, rbx
    add r8, r12
    mov rdx, 100
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rax, r8
    sext.i32 rax
    ret rax
