  block ^entry
    store.i64 @observed_five, 11
    load.i64 rbx, [rdi+40]
    mov r12, rsi
    add r12, rdx
    mov r13, rcx
    add r13, r8
    mov r14, rsi
    add r14, rcx
    mov r15, rdx
    add r15, r8
    add r12, r13
    add r14, r15
    add r12, r14
    load.i64 r13, @observed_five
    mov r14, 100
    add r14, 200
    add rbx, r13
    add r14, rbx
    add r14, r12
    ret r14

function @distance_six
  abi
    param %base -> rdi : ptr
    param %a -> rsi : i64
    param %b -> rdx : i64
    param %c -> rcx : i64
    param %d -> r8 : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15

  block ^entry
    store.i64 @observed_six, 11
    load.i64 rbx, [rdi+48]
    mov r12, rsi
    add r12, rdx
    mov r13, rcx
    add r13, r8
    mov r14, rsi
    add r14, rcx
    mov r15, rdx
    add r15, r8
    add r12, r13
    add r14, r15
    add r12, r14
    load.i64 r13, @observed_six
    mov r14, 100
    add r14, 200
    add rbx, r13
    add r14, rbx
