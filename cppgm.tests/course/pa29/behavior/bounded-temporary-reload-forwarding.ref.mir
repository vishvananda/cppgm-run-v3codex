machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @values
  storage data
  item i64 17
  item i64 19
  item i64 23
  item i64 29
  item i64 31
  item i64 37
  item i64 41

global @observed_two
  storage scalar i64
  init i64 0

global @observed_five
  storage scalar i64
  init i64 0

global @observed_six
  storage scalar i64
  init i64 0

global @observed_barrier
  storage scalar i64
  init i64 0

function @distance_two
  abi
    param %base -> rdi : ptr
    param %a -> rsi : i64
    param %b -> rdx : i64
    param %c -> rcx : i64
    param %d -> r8 : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15

  block ^entry
    store.i64 @observed_two, 11
    load.i64 rbx, [rdi+16]
    mov r12, rsi
    add r12, rdx
    mov r13, rcx
    add r13, r8
    mov r14, rsi
    add r14, rcx
    mov r15, rdx
    add r15, r8
    add r12, r13
    add r14, r15
    add r12, r14
    load.i64 r13, @observed_two
    mov r14, 100
    add r14, 200
    add rbx, r13
    add r14, rbx
    add r14, r12
    ret r14

function @distance_five
  abi
    param %base -> rdi : ptr
    param %a -> rsi : i64
    param %b -> rdx : i64
    param %c -> rcx : i64
    param %d -> r8 : i64
    return i64 -> rax
  frame
    stack_size 48
