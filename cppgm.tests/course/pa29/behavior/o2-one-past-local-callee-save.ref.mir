machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @noop
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 0
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    slot $bytes -> [rbp-16] : obj<16x1>

  block ^entry
    call @noop [args=()]
    lea r8, [rbp-16]
    lea r9, [r8+16]
    sub r9, r8
    add r9, 7
    mov rdx, 23
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rax, r9
    sext.i32 rax
    ret rax
