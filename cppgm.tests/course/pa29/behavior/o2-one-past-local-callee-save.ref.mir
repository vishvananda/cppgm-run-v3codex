machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @noop
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    mov rax, 0
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    preserve rbx
    slot $bytes -> [rbp-16] : obj<16x1>

  block ^entry
    call @noop
    lea r8, [rbp]
    lea rdx, [rbp-16]
    sub r8, rdx
    add r8, 7
    mov rdx, 23
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    ret r9
