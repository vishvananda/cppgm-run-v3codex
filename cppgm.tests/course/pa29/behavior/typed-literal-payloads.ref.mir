machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @single
  storage scalar f32
  init f32 0x1.000002p0

global @double
  storage scalar f64
  init f64 0x1.0000000000001p0

global @extended
  storage scalar f80
  init f80 0x1.0000000000000002p0L

global @wide
  storage scalar i128
  init i128 -1

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    temp %extended -> [rbp-16] : f80
    temp %wide -> [rbp-16] : i128

  block ^entry
    fmov.f32 xmm0, @single
    fne.f32 rax, xmm0, 0x1.000002p0
    mov r8, rax
    fmov.f64 xmm0, @double
    fne.f64 rax, xmm0, 0x1.0000000000001p0
    mov r9, rax
    fmov.f80 [rbp-16], @extended
    fne.f80 rax, [rbp-16], 0x1.0000000000000002p0L
    mov rdi, rax
    mov r11, @wide
    load.i64 rax, [r11]
    load.i64 rdx, [r11+8]
    lea r11, [rbp-16]
    store.i64 [r11], rax
    store.i64 [r11+8], rdx
    lea r11, [rbp-16]
    load.i64 rax, [r11]
    load.i64 rdx, [r11+8]
    mov rcx, -1
    mov rsi, -1
    cmp.i64 rdx, rsi
    sete r10
    movzx r10, r10
    cmp.i64 rax, rcx
    sete r11
    movzx r11, r11
    and r10, r11
    xor r10, 1
    mov rsi, r10
    or r8, r9
    or rdi, rsi
    or r8, rdi
    mov rax, r8
    sext.i32 rax
    ret rax
