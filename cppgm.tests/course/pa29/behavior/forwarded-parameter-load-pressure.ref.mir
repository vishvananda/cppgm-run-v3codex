machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @first_value
  storage scalar i64
  init i64 11

global @second_value
  storage scalar i64
  init i64 13

global @third_value
  storage scalar i64
  init i64 17

global @observed
  storage scalar i64
  init i64 0

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    ret

function @finish
  abi
    param %first -> rdi : ptr
    param %second -> rsi : ptr
    param %third -> rdx : ptr
    param %fourth -> rcx : i32
    return void -> void
  frame
    stack_size 96
    scratch_bytes 48
    preserve r12 r13 r14 r15

  block ^entry
    mov r8, rdi
    mov r12, rsi
    mov r13, rdx
    load.i64 r9, [r8]
    load.i64 r14, [r12]
    load.i64 r15, [r13]
    add r9, r14
    add r9, r15
    mov r14, rcx
    sext.i32 r14
    add r9, r14
    store.i64 @observed, r9
    ret

function @reduced
  abi
    param %first -> rdi : ptr
    param %second -> rsi : ptr
    param %third -> rdx : ptr
    param %fourth -> rcx : i32
    return void -> void
  frame
    stack_size 48
    scratch_bytes 0
    preserve rbx r12 r13 r14
    temp %fourth_loaded -> [rbp-4] : i32

  block ^entry
    mov rbx, rdi
    mov r13, rsi
    mov r14, rdx
    mov r12, rcx
    call @touch
    mov r8, rbx
    mov r9, r13
    store.i32 [rbp-4], r12
    mov rdi, rbx
    mov rsi, r13
    mov rdx, r14
    load.i32 rcx, [rbp-4]
    call @finish
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    preserve rbx

  block ^entry
    mov r8, @first_value
    mov r9, @second_value
    mov rbx, @third_value
    mov rdi, r8
    mov rsi, r9
    mov rdx, rbx
    mov rcx, 19
    call @reduced
    load.i64 r8, @observed
    mov rdx, 60
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
