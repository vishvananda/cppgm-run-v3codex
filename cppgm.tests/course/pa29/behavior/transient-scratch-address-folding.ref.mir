machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @single_result
  storage data
  item i64 17

global @pair_result
  storage data
  item i64 0
  item i64 0

function @make_single
  abi
    return obj<8x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-8] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], 23
    load.i64 rax, [rbp-8]
    ret

function @make_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-16] : obj<16x8>

  block ^entry
    store.i64 [rbp-16], 29
    store.i64 [rbp-8], 31
    load.i64 rax, [rbp-16]
    load.i64 rdx, [rbp-8]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12

  block ^entry
    call @make_single [args=()]
    mov r11, @single_result
    store.i64 [r11], rax
    mov r8, @single_result
    call @make_pair [args=()]
    mov r11, @pair_result
    store.i64 [r11], rax
    store.i64 [r11+8], rdx
    mov r9, @pair_result
    load.i64 rdi, @single_result
    load.i64 rsi, @pair_result
    mov rbx, @pair_result
    load.i64 r12, [rbx+8]
    mov rdx, 23
    cmp.i64 rdi, rdx
    setne rdi
    movzx rdi, rdi
    mov rdx, 29
    cmp.i64 rsi, rdx
    setne rsi
    movzx rsi, rsi
    mov rdx, 31
    cmp.i64 r12, rdx
    setne r12
    movzx r12, r12
    or rsi, r12
    or rdi, rsi
    mov rax, rdi
    sext.i32 rax
    ret rax
