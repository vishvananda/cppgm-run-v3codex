machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @combine_after_copy
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %b -> [rbp-8] : i64
    slot $source -> [rbp-16] : obj<8x8>
    slot $destination -> [rbp-24] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], rsi
    store.i64 [rbp-16], 1
    copy_bytes 8x8, [rbp-24], [rbp-16]
    load.i64 r8, [rbp-8]
    add r8, r9
    ret r8

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    call @combine_after_copy [args=(rcx,rdx,rsi,rdi,r8,r9)]
    mov rdx, 8
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
