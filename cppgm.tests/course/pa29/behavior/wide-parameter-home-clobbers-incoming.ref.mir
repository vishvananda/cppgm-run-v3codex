machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @combine_after_copy
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    param %f -> r9 : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    preserve rbx
    param-slot %a -> [rbp-8] : i64
    param-slot %c -> [rbp-16] : i64
    param-slot %d -> [rbp-24] : i64
    param-slot %e -> [rbp-32] : i64
    slot $source -> [rbp-40] : obj<8x8>
    slot $destination -> [rbp-48] : obj<8x8>

  block ^entry
    store.i64 [rbp-8], rdi
    store.i64 [rbp-16], rdx
    store.i64 [rbp-24], rcx
    store.i64 [rbp-32], r8
    mov r8, rsi
    mov rax, 1
    store.i64 [rbp-40], rax
    lea rdi, [rbp-48]
    lea rsi, [rbp-40]
    copy_bytes 8x8, rdi, rsi
    mov rbx, r8
    add rbx, r9
    mov rax, rbx
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    mov r9, 6
    call @combine_after_copy
    mov r8, rax
    mov rdx, 8
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
