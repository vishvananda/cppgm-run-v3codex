machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @single_observed
  storage scalar i64
  init i64 0

global @shared_observed
  storage scalar i64
  init i64 0

function @pressure
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15

  block ^entry
    store.i64 @single_observed, 11
    store.i64 @shared_observed, 13
    mov rbx, rdi
    add rbx, rsi
    mov r12, rdx
    add r12, rcx
    mov r13, r8
    add r13, rdi
    mov r14, rsi
    add r14, rdx
    mov r15, rcx
    add r15, r8
    add rbx, r12
    add r13, r14
    add rbx, r13
    add rbx, r15
    mov r12, 13
    add r12, 2
    load.i64 r13, @single_observed
    load.i64 r14, @shared_observed
    mov r15, 100
    add r15, 200
    add r13, r14
    add r13, r12
    add r15, r13
    add r15, rbx
    ret r15

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    call @pressure [args=(rcx,rdx,rsi,rdi,r8)]
    mov rdx, 369
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
