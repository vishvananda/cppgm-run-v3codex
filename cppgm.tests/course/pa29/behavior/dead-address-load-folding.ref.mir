machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @values
  storage data
  item i64 17
  item i64 25

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, @values
    load.i64 r9, [r8+8]
    mov r8, @values
    load.i64 rdi, [r8]
    add rdi, r9
    mov rdx, 42
    cmp.i64 rdi, rdx
    setne rdi
    movzx rdi, rdi
    mov rax, rdi
    sext.i32 rax
    ret rax
