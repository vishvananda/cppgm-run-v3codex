machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @g1
  storage scalar i32
  init i32 7

global @g2
  storage scalar i64
  init i64 2

global @g3
  storage scalar i64
  init i64 3

global @g4
  storage scalar i64
  init i64 4

global @g5
  storage scalar i64
  init i64 5

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @probe
  abi
    param %p1 -> rdi : ptr
    param %p2 -> rsi : ptr
    param %p3 -> rdx : ptr
    param %p4 -> rcx : ptr
    param %p5 -> r8 : ptr
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %atomic -> [rbp-4] : i32

  block ^entry
    mov r15, rdi
    mov r14, rsi
    mov r13, rdx
    mov r12, rcx
    mov rbx, r8
    load.i32 rax, [rdi]
    store.i32 [rbp-4], rax
    call @touch [args=()]
    load.i32 r8, [r15]
    mov r9, r8
    sext.i32 r9
    load.i64 r8, [r14]
    load.i64 rdi, [r13]
    load.i64 rsi, [r12]
    load.i64 r15, [rbx]
    load.i32 r14, [rbp-4]
    sext.i32 r14
    add r14, r9
    add r14, r8
    add r14, rdi
    add r14, rsi
    add r14, r15
    ret r14

function @main
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @g1
    mov rsi, @g2
    mov rdx, @g3
    mov rcx, @g4
    mov r8, @g5
    call @probe [args=(rcx,rdx,rsi,rdi,r8)]
    cmp.i64 rax, 28
    setne rax
    movzx rax, rax
    ret rax
