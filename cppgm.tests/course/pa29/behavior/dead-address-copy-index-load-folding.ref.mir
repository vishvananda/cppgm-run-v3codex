machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @values
  storage data
  item i64 17
  item i64 25

function @identity
  abi
    param %address -> rdi : ptr
    return ptr -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret rdi

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @values
    call @identity [args=(rdi)]
    load.i64 r8, [rax+8]
    mov r9, @values
    load.i64 rdi, [r9]
    add rdi, r8
    mov rdx, 42
    cmp.i64 rdi, rdx
    setne rdi
    movzx rdi, rdi
    mov rax, rdi
    sext.i32 rax
    ret rax
