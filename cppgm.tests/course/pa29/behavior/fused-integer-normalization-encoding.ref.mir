machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @signed_source
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, -17
    ret rax

function @unsigned_source
  abi
    return u8 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 250
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    call @signed_source [args=()]
    mov rbx, rax
    sext.i32 rbx
    call @unsigned_source [args=()]
    mov r8, rax
    zext.i8 r8
    mov r9, 17
    mov rdx, -17
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 250
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rdx, 17
    cmp.i32 r9, rdx
    setne r9
    movzx r9, r9
    or rbx, r8
    mov r8, r9
    zext.i64 r8
    or rbx, r8
    mov rax, rbx
    sext.i32 rax
    ret rax
