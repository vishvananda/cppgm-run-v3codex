machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @values
  storage data
  item i64 17
  item i64 0
  item i64 0

global @other
  storage data
  item i64 25

function @write_second
  abi
    param %base -> rdi : ptr
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 [rdi+8], rsi
    store.i64 [rdi+16], rsi
    mov r8, @other
    load.i64 rax, [r8]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @values
    mov rsi, 25
    call @write_second [args=(rsi,rdi)]
    mov r8, rax
    mov r9, @values
    load.i64 rdi, [r9+8]
    mov rdx, 25
    cmp.i64 rdi, rdx
    setne rdi
    movzx rdi, rdi
    mov rdx, 25
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    or rdi, r8
    mov rax, rdi
    sext.i32 rax
    ret rax
