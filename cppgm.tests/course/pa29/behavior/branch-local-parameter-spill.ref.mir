machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @condition
  storage scalar i64
  init i64 0

global @expected
  storage scalar i64
  init i64 7

global @fields
  storage data
  item i64 0
  item i64 0
  item i64 0

global @late_result
  storage scalar i64
  init i64 0

global @late_source
  storage scalar i64
  init i64 13

function @noop
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 0
    ret rax

function @probe
  abi
    param %condition -> rdi : ptr
    param %value -> rsi : ptr
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, rsi
    load.i64 r8, [rdi]
    mov rax, r8
    cmp.i64 rax, 0
    jne ^pressure
    jmp ^merge

  block ^pressure
    call @noop [args=()]
    mov r8, 1
    add r8, 2
    mov r9, 3
    add r9, 4
    add r8, r9
    add r8, 5
    jmp ^merge

  block ^merge
    load.i64 rax, [rbx]
    ret rax

function @probe_temporary
  abi
    param %condition -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 r8, [rdi]
    mov rax, r8
    cmp.i64 rax, 0
    jne ^pressure
    jmp ^merge

  block ^pressure
    call @noop [args=()]
    mov r8, 1
    add r8, 2
    mov r9, 3
    add r9, 4
    add r8, r9
    add r8, 5
    jmp ^merge

  block ^merge
    mov rax, 7
    ret rax

function @probe_forwarded_alias
  abi
    param %base -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13

  block ^entry
    mov rbx, rdi
    store.i64 [rbx], 11
    lea r12, [rdi+8]
    store.i64 [r12], 22
    lea r13, [rdi+16]
    store.i64 [r13], 33
    call @noop [args=()]
    jmp ^check

  block ^check
    load.i64 r8, [rbx]
    load.i64 r9, [r12]
    load.i64 rsi, [r13]
    mov rdx, 11
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    mov rdx, 22
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov rdx, 33
    cmp.i64 rsi, rdx
    sete rsi
    movzx rsi, rsi
    and r8, r9
    and r8, rsi
    ret r8

function @clobber_first_argument
  abi
    param %value -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 rax, [rdi]
    ret rax

function @write_after_call
  abi
    param %result -> rdi : ptr
    param %source -> rsi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, rdi
    mov rdi, rsi
    call @clobber_first_argument [args=(rdi)]
    jmp ^write

  block ^write
    store.i64 [rbx], 77
    ret

function @dead_parameter_pressure
  abi
    param %a -> rdi : i64
    param %b -> rsi : i64
    param %c -> rdx : i64
    param %d -> rcx : i64
    param %e -> r8 : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    add rdi, rsi
    add rdx, rcx
    add rdi, rdx
    mov rbx, rdi
    add rbx, r8
    call @noop [args=()]
    ret rbx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 96
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %alias_ok -> [rbp-8] : i64

  block ^entry
    mov rbx, @condition
    mov rdi, rbx
    mov rsi, @expected
    call @probe [args=(rsi,rdi)]
    mov r12, rax
    mov rdi, rbx
    call @probe_temporary [args=(rdi)]
    mov r13, rax
    mov rdi, @fields
    call @probe_forwarded_alias [args=(rdi)]
    mov rbx, rax
    mov r14, @late_result
    mov r15, @late_source
    mov rdi, r14
    mov rsi, r15
    call @write_after_call [args=(rsi,rdi)]
    store.i64 [rbp-8], rbx
    load.i64 rbx, [r14]
    load.i64 r14, [r15]
    mov rdi, 1
    mov rsi, 2
    mov rdx, 3
    mov rcx, 4
    mov r8, 5
    call @dead_parameter_pressure [args=(rcx,rdx,rsi,rdi,r8)]
    mov r8, rax
    mov rdx, 7
    cmp.i64 r12, rdx
    setne r12
    movzx r12, r12
    mov rdx, 7
    cmp.i64 r13, rdx
    setne r13
    movzx r13, r13
    load.i64 r9, [rbp-8]
    mov rdx, 0
    cmp.i64 r9, rdx
    sete r9
    movzx r9, r9
    mov rdx, 77
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 13
    cmp.i64 r14, rdx
    setne r14
    movzx r14, r14
    mov rdx, 15
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    or r12, r13
    or r12, r9
    or rbx, r14
    or r12, rbx
    or r12, r8
    mov rax, r12
    sext.i32 rax
    ret rax
