machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @values
  storage data
  item i64 1
  item i64 0

function @probe
  abi
    param %base -> rdi : ptr
    param %a -> rsi : i64
    param %b -> rdx : i64
    param %c -> rcx : i64
    param %d -> r8 : i64
    param %e -> r9 : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve r13 r14 rbx r12
    param-slot %b -> [rbp-8] : i64
    param-slot %c -> [rbp-16] : i64
    slot $iteration -> [rbp-24] : i64

  block ^entry
    store.i64 [rbp-8], rdx
    store.i64 [rbp-16], rcx
    mov r13, r8
    mov r14, r9
    mov r9, rsi
    store.i64 [rbp-24], 0
    jmp ^condition

  block ^condition
    mov r8, r9
    add r8, [rbp-8]
    load.i64 rsi, [rbp-24]
    load.i64 rbx, [rdi]
    cmp.i64 rsi, rbx
    jb ^body
    jmp ^done

  block ^body
    load.i64 rbx, [rbp-16]
    add rbx, r13
    mov r12, r8
    add r12, rbx
    add r12, r9
    add r12, [rbp-8]
    add r12, r14
    store.i64 [rdi+8], r12
    mov rbx, rsi
    add rbx, 1
    store.i64 [rbp-24], rbx
    jmp ^condition

  block ^done
    ret rsi

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @values
    mov rsi, 1
    mov rdx, 2
    mov rcx, 3
    mov r8, 4
    mov r9, 5
    call @probe [args=(rcx,rdx,rsi,rdi,r8,r9)]
    mov rdx, 1
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
