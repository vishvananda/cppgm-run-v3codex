machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @left
  storage scalar f80
  init f80 1.0L

global @right
  storage scalar f80
  init f80 1.0L

global @observed
  storage scalar u8
  init u8 0

global @g1
  storage scalar i64
  init i64 1

global @g2
  storage scalar i64
  init i64 2

global @g3
  storage scalar i64
  init i64 3

global @g4
  storage scalar i64
  init i64 4

global @g5
  storage scalar i64
  init i64 5

global @g6
  storage scalar i64
  init i64 6

global @g7
  storage scalar i64
  init i64 7

function @reduced
  abi
    param %first -> rdi : ptr
    param %second -> rsi : ptr
    return void -> void
  frame
    stack_size 128
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %left -> [rbp-16] : f80
    temp %right -> [rbp-32] : f80
    temp %equal -> [rbp-40] : i64
    temp %v7 -> [rbp-40] : i64

  block ^entry
    load.i64 r8, @g1
    load.i64 r9, @g2
    load.i64 rbx, @g3
    load.i64 r12, @g4
    load.i64 r13, @g5
    load.i64 r14, @g6
    load.i64 r15, @g7
    mov rax, 1
    cmp.i64 rax, 0
    jne ^compare
    jmp ^use_live_values

  block ^compare
    fmov.f80 [rbp-16], @left
    fmov.f80 [rbp-32], @right
    feq.f80 rax, [rbp-16], [rbp-32]
    store.i64 [rbp-40], rax
    load.i64 rax, [rbp-40]
    store.u8 @observed, rax
    ret

  block ^use_live_values
    store.i64 [rbp-40], r15
    mov r15, r8
    add r15, r9
    add r15, rbx
    add r15, r12
    add r15, r13
    add r15, r14
    add r15, [rbp-40]
    store.i64 [rdi], r15
    store.i64 [rsi], r15
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, @g1
    mov rdi, r8
    mov rsi, r8
    call @reduced [args=(rsi,rdi)]
    load.u8 r8, @observed
    mov rdx, 1
    cmp.u8 r8, rdx
    setne r8
    movzx r8, r8
    mov rax, r8
    zext.i8 rax
    sext.i32 rax
    ret rax
