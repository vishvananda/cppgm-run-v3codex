machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

global @saved_power
  storage scalar i64
  init i64 0

global @saved_magic
  storage scalar i64
  init i64 0

function @divide_and_store
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    preserve rbx r12 r13

  block ^entry
    mov rcx, 32
    mov rax, rdi
    cqo
    idiv rcx
    mov r8, rax
    store.i64 @saved_power, rax
    add r8, 1
    mov rcx, 7
    mov rax, rdi
    cqo
    idiv rcx
    mov rbx, rax
    store.i64 @saved_magic, rax
    add rbx, 1
    load.i64 r12, @saved_power
    load.i64 r13, @saved_magic
    add r12, r13
    add r8, rbx
    add r12, r8
    ret r12

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    preserve rbx

  block ^entry
    mov rdi, 224
    call @divide_and_store
    mov r8, rax
    mov rdx, 80
    cmp.i64 rax, rdx
    setne rbx
    movzx rbx, rbx
    mov rdi, -224
    call @divide_and_store
    mov rdx, -76
    cmp.i64 rax, rdx
    setne r8
    movzx r8, r8
    or rbx, r8
    mov r8, rbx
    sext.i32 r8
    ret r8
