machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    preserve rbx r12
    slot $source -> [rbp-8] : obj<8x8>
    slot $destination -> [rbp-16] : obj<8x8>

  block ^entry
    mov rax, 7
    store.i64 [rbp-8], rax
    mov r8, 10
    mov r9, 20
    lea rbx, [rbp-8]
    lea rdi, [rbp-16]
    lea rsi, [rbp-8]
    copy_bytes 8x8, rdi, rsi
    load.i64 r12, [rbx]
    add r8, r9
    add r8, r12
    mov rdx, 37
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
