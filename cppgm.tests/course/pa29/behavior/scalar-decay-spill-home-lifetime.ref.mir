machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @bytes
  storage data
  item zero 128

function @length_of
  abi
    param %value -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 3
    ret rax

function @observe
  abi
    param %p1 -> rdi : ptr
    param %p2 -> rsi : ptr
    param %p3 -> rdx : ptr
    param %p4 -> rcx : ptr
    param %p5 -> r8 : ptr
    param %p6 -> r9 : ptr
    param %p7 -> [rbp+16] : ptr
    param %p8 -> [rbp+24] : ptr
    param %p9 -> [rbp+32] : ptr
    param %q1 -> [rbp+40] : i64
    param %q2 -> [rbp+48] : i64
    param %q3 -> [rbp+56] : i64
    param %q4 -> [rbp+64] : i64
    param %q5 -> [rbp+72] : i64
    param %q6 -> [rbp+80] : i64
    param %q7 -> [rbp+88] : i64
    param %q8 -> [rbp+96] : i64
    param %q9 -> [rbp+104] : i64
    return i64 -> rax
  frame
    stack_size 144
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12
    param-slot %p7 -> [rbp-8] : ptr
    param-slot %p8 -> [rbp-16] : ptr
    param-slot %p9 -> [rbp-24] : ptr
    param-slot %q1 -> [rbp-32] : i64
    param-slot %q2 -> [rbp-40] : i64
    param-slot %q3 -> [rbp-48] : i64
    param-slot %q4 -> [rbp-56] : i64
    param-slot %q5 -> [rbp-64] : i64
    param-slot %q6 -> [rbp-72] : i64
    param-slot %q7 -> [rbp-80] : i64
    param-slot %q8 -> [rbp-88] : i64
    param-slot %q9 -> [rbp-96] : i64

  block ^entry
    load.ptr rax, [rbp+16]
    store.ptr [rbp-8], rax
    load.ptr rax, [rbp+24]
    store.ptr [rbp-16], rax
    load.ptr rax, [rbp+32]
    store.ptr [rbp-24], rax
    load.i64 rax, [rbp+40]
    store.i64 [rbp-32], rax
    load.i64 rax, [rbp+48]
    store.i64 [rbp-40], rax
    load.i64 rax, [rbp+56]
    store.i64 [rbp-48], rax
    load.i64 rax, [rbp+64]
    store.i64 [rbp-56], rax
    load.i64 rax, [rbp+72]
    store.i64 [rbp-64], rax
    load.i64 rax, [rbp+80]
    store.i64 [rbp-72], rax
    load.i64 rax, [rbp+88]
    store.i64 [rbp-80], rax
    load.i64 rax, [rbp+96]
    store.i64 [rbp-88], rax
    load.i64 rax, [rbp+104]
    store.i64 [rbp-96], rax
    mov r8, @bytes
    lea rdi, [r8+48]
    mov rsi, r9
    cmp.ptr rsi, rdi
    sete rsi
    movzx rsi, rsi
    lea rdi, [r8+56]
    load.ptr rbx, [rbp-8]
    cmp.ptr rbx, rdi
    sete rbx
    movzx rbx, rbx
    lea rdi, [r8+64]
    load.ptr r12, [rbp-16]
    cmp.ptr r12, rdi
    sete r12
    movzx r12, r12
    lea r8, [r8+72]
    load.ptr rdi, [rbp-24]
    cmp.ptr rdi, r8
    sete rdi
    movzx rdi, rdi
    load.i64 r8, [rbp-96]
    mov rdx, 12
    cmp.i64 r8, rdx
    sete r8
    movzx r8, r8
    and rsi, rbx
    and r12, rdi
    and rsi, r12
    and rsi, r8
    imul rsi, 100
    ret rsi

function @exercise
  abi
    param %base -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 112
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %p5 -> [rbp-8] : ptr
    temp %p6 -> [rbp-16] : ptr
    temp %p7 -> [rbp-24] : ptr
    temp %p8 -> [rbp-32] : ptr
    temp %q4 -> [rbp-40] : i64
    temp %q5 -> [rbp-48] : i64
    temp %q6 -> [rbp-56] : i64
    temp %q7 -> [rbp-64] : i64

  block ^entry
    lea rbx, [rdi+8]
    lea r12, [rdi+16]
    lea r13, [rdi+24]
    lea r14, [rdi+32]
    lea r15, [rdi+40]
    store.ptr [rbp-8], r15
    lea r15, [rdi+48]
    store.ptr [rbp-16], r15
    lea r15, [rdi+56]
    store.ptr [rbp-24], r15
    lea r15, [rdi+64]
    store.ptr [rbp-32], r15
    lea r15, [rdi+72]
    call @length_of [args=(rdi)]
    mov r8, rax
    add r8, 1
    mov r9, rax
    add r9, 2
    mov rsi, rax
    add rsi, 3
    mov rdi, rax
    add rdi, 4
    store.i64 [rbp-40], rdi
    mov rdi, rax
    add rdi, 5
    store.i64 [rbp-48], rdi
    mov rdi, rax
    add rdi, 6
    store.i64 [rbp-56], rdi
    mov rdi, rax
    add rdi, 7
    store.i64 [rbp-64], rdi
    mov rdi, rax
    add rdi, 8
    add rax, 9
    sub rsp, 96
    load.ptr r11, [rbp-24]
    store.ptr [rsp], r11
    load.ptr r11, [rbp-32]
    store.ptr [rsp+8], r11
    store.ptr [rsp+16], r15
    store.i64 [rsp+24], r8
    store.i64 [rsp+32], r9
    store.i64 [rsp+40], rsi
    load.i64 r11, [rbp-40]
    store.i64 [rsp+48], r11
    load.i64 r11, [rbp-48]
    store.i64 [rsp+56], r11
    load.i64 r11, [rbp-56]
    store.i64 [rsp+64], r11
    load.i64 r11, [rbp-64]
    store.i64 [rsp+72], r11
    store.i64 [rsp+80], rdi
    store.i64 [rsp+88], rax
    mov rdi, rbx
    mov rsi, r12
    mov rdx, r13
    mov rcx, r14
    load.ptr r8, [rbp-8]
    load.ptr r9, [rbp-16]
    call @observe [args=(rcx,rdx,rsi,rdi,r8,r9), stack=96]
    add rsp, 96
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @bytes
    call @exercise [args=(rdi)]
    mov rdx, 100
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
