machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @return_i8
  abi
    return i8 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    slot $home -> [rbp-1] : i8

  block ^entry
    mov r8, -1
    mov r9, r8
    sext.i8 r9
    store.i8 [rbp-1], r9
    mov r8, r9
    sext.i8 r8
    mov rax, r8
    ret rax

function @extend_i8
  abi
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    slot $home -> [rbp-1] : i8

  block ^entry
    mov r8, -1
    mov r9, r8
    sext.i8 r9
    store.i8 [rbp-1], r9
    mov r8, r9
    sext.i8 r8
    mov r9, r8
    zext.i8 r9
    mov rax, r9
    ret rax

function @extend_u16
  abi
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    slot $home -> [rbp-2] : u16

  block ^entry
    mov r8, 48879
    mov r9, r8
    zext.i16 r9
    store.u16 [rbp-2], r9
    mov r8, r9
    zext.i16 r8
    mov r9, r8
    zext.i16 r9
    mov rax, r9
    ret rax

function @extend_i32
  abi
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    slot $home -> [rbp-4] : i32

  block ^entry
    mov r8, -1
    mov r9, r8
    sext.i32 r9
    store.i32 [rbp-4], r9
    mov r8, r9
    sext.i32 r8
    mov r9, r8
    zext.i32 r9
    mov rax, r9
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    preserve rbx r12 r13

  block ^entry
    call @return_i8
    mov r8, rax
    sext.i8 r8
    mov rbx, r8
    zext.i8 rbx
    call @extend_i8
    mov r12, rax
    call @extend_u16
    mov r13, rax
    call @extend_i32
    mov r8, rax
    mov rdx, 255
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 255
    cmp.i64 r12, rdx
    setne r12
    movzx r12, r12
    mov rdx, 48879
    cmp.i64 r13, rdx
    setne r13
    movzx r13, r13
    mov rdx, 4294967295
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    or rbx, r12
    or r13, r8
    or rbx, r13
    mov r8, rbx
    sext.i32 r8
    mov rax, r8
    ret rax
