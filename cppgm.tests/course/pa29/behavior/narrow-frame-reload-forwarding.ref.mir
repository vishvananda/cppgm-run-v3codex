machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @return_i8
  abi
    return i8 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $home -> [rbp-1] : i8

  block ^entry
    mov r8, -1
    store.i8 [rbp-1], r8
    load.i8 rax, [rbp-1]
    ret rax

function @extend_i8
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $home -> [rbp-1] : i8

  block ^entry
    mov r8, -1
    store.i8 [rbp-1], r8
    load.i8 r8, [rbp-1]
    mov rax, r8
    zext.i8 rax
    ret rax

function @extend_u16
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $home -> [rbp-2] : u16

  block ^entry
    mov r8, 48879
    store.u16 [rbp-2], r8
    load.u16 r8, [rbp-2]
    mov rax, r8
    zext.i16 rax
    ret rax

function @extend_i32
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $home -> [rbp-4] : i32

  block ^entry
    mov r8, -1
    store.i32 [rbp-4], r8
    load.i32 r8, [rbp-4]
    mov rax, r8
    zext.i32 rax
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13

  block ^entry
    call @return_i8 [args=()]
    mov rbx, rax
    zext.i8 rbx
    call @extend_i8 [args=()]
    mov r12, rax
    call @extend_u16 [args=()]
    mov r13, rax
    call @extend_i32 [args=()]
    mov r8, rax
    mov rdx, 255
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 255
    cmp.i64 r12, rdx
    setne r12
    movzx r12, r12
    mov rdx, 48879
    cmp.i64 r13, rdx
    setne r13
    movzx r13, r13
    mov rdx, 4294967295
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    or rbx, r12
    or r13, r8
    or rbx, r13
    mov rax, rbx
    sext.i32 rax
    ret rax
