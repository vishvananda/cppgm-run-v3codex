machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @noop
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    mov rax, 0
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 80
    scratch_bytes 48
    preserve rbx
    temp %floating -> [rbp-16] : f80

  block ^entry
    mov r8, 218
    mov rbx, r8
    sext.i8 rbx
    mov r8, 0
    mov rax, r8
    cmp.i64 rax, 0
    jne ^detour
    jmp ^convert

  block ^detour
    call @noop
    jmp ^convert

  block ^convert
    sitofp.i8.f80 [rbp-16], rbx
    fptosi.f80.i64 r8, [rbp-16]
    mov rdx, -38
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
