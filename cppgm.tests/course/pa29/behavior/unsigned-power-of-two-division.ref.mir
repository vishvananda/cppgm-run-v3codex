    cmp.i64 r12, rdx
    setne r12
    movzx r12, r12
    mov r13, -1
    mov rdx, -9223372036854775808
    mov rcx, rdx
    mov rax, r13
    mov rdx, 0
    div rcx
    mov r13, rdx
    mov rdx, 9223372036854775807
    cmp.i64 r13, rdx
    setne r13
    movzx r13, r13
    mov r14, 255
    mov rdx, 4
    mov rcx, rdx
    zext.i8 rcx
    mov rax, r14
    zext.i8 rax
    mov rdx, 0
