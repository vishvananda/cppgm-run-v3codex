    setne r15
    movzx r15, r15
    mov rax, 4294967295
    mov rdx, 65536
    mov rcx, rdx
    zext.i32 rcx
    zext.i32 rax
    mov rdx, 0
    div rcx
    store.u32 [rbp-4], rax
    load.u32 rax, [rbp-4]
    mov rdx, 65535
    cmp.u32 rax, rdx
    setne rax
    movzx rax, rax
    store.i64 [rbp-16], rax
    mov rax, 100
