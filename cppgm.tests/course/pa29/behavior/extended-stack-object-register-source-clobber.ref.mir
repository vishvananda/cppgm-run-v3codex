machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @observe
  abi
    param %ignored -> rdi : i64
    param %payload -> [rbp+16] : i64
    param %payload -> [rbp+24] : i64
    param %payload -> [rbp+32] : i64
    param %payload -> [rbp+40] : i64
    param %payload -> [rbp+48] : i64
    param %payload -> [rbp+56] : i64
    param %payload -> [rbp+64] : i64
    param %payload -> [rbp+72] : i64
    param %payload -> [rbp+80] : i64
    param %payload -> [rbp+88] : i64
    param %payload -> [rbp+96] : i64
    param %payload -> [rbp+104] : i64
    param %payload -> [rbp+112] : i64
    param %payload -> [rbp+120] : i64
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size 128
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %ignored -> [rbp-8] : i64
    param-slot %payload -> [rbp-120] : obj<112x8>
    param-slot %value -> [rbp-128] : i64

  block ^entry
    store.i64 [rbp-8], rdi
    load.i64 rax, [rbp+16]
    store.i64 [rbp-120], rax
    load.i64 rax, [rbp+24]
    store.i64 [rbp-112], rax
    load.i64 rax, [rbp+32]
    store.i64 [rbp-104], rax
    load.i64 rax, [rbp+40]
    store.i64 [rbp-96], rax
    load.i64 rax, [rbp+48]
    store.i64 [rbp-88], rax
    load.i64 rax, [rbp+56]
    store.i64 [rbp-80], rax
    load.i64 rax, [rbp+64]
    store.i64 [rbp-72], rax
    load.i64 rax, [rbp+72]
    store.i64 [rbp-64], rax
    load.i64 rax, [rbp+80]
    store.i64 [rbp-56], rax
    load.i64 rax, [rbp+88]
    store.i64 [rbp-48], rax
    load.i64 rax, [rbp+96]
    store.i64 [rbp-40], rax
    load.i64 rax, [rbp+104]
    store.i64 [rbp-32], rax
    load.i64 rax, [rbp+112]
    store.i64 [rbp-24], rax
    load.i64 rax, [rbp+120]
    store.i64 [rbp-16], rax
    store.i64 [rbp-128], rsi
    load.i64 rax, [rbp-128]
    ret rax

function @forward
  abi
    param %ignored -> rdi : i64
    param %value -> rsi : i64
    return i64 -> rax
  frame
    stack_size 128
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $payload -> [rbp-112] : obj<112x8>
    temp %ignored -> [rbp-120] : i64
    temp %value -> [rbp-128] : i64

  block ^entry
    store.i64 [rbp-120], rdi
    store.i64 [rbp-128], rsi
    sub rsp, 112
    lea rdi, [rsp]
    lea rsi, [rbp-112]
    copy_bytes 112x8, rdi, rsi
    load.i64 rdi, [rbp-120]
    load.i64 rsi, [rbp-128]
    call @observe [args=(rsi,rdi), stack=112]
    add rsp, 112
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, 0
    mov rsi, 42
    call @forward [args=(rsi,rdi)]
    mov rdx, 42
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
