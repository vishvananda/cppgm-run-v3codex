machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @receiver
  storage scalar i8
  init i8 0

global @source
  storage scalar i8
  init i8 0

global @payload
  storage scalar i8
  init i8 0

global @observed
  storage scalar i64
  init i64 0

global @dispatch readonly
  storage data
  item ptr addr @sink

function @sink
  abi
    param %this -> rdi : ptr
    param %source -> rsi : ptr
    param %type -> rdx : i32
    param %data -> rcx : ptr
    param %size -> r8 : i64
    return void -> void
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.i64 @observed, r8
    ret

function @forward
  abi
    param %this -> rdi : ptr
    param %source -> rsi : ptr
    param %type -> rdx : i32
    param %data -> rcx : ptr
    param %size -> r8 : i64
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12

  block ^entry
    mov r9, rcx
    mov rbx, @dispatch
    load.ptr r12, [rbx]
    mov rcx, r9
    call *r12 [args=(rcx,rdx,rsi,rdi,r8)]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @receiver
    mov rsi, @source
    mov rdx, 13
    mov rcx, @payload
    mov r8, 77
    call @forward [args=(rcx,rdx,rsi,rdi,r8)]
    load.i64 r8, @observed
    mov rdx, 77
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rax, r8
    sext.i32 rax
    ret rax
