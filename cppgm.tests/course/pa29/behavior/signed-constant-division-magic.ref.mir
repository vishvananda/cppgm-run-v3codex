function @div_narrow3
  abi
    param %value -> rdi : i8
    return i8 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rcx, 3
    mov rax, rdi
    cqo
    idiv rcx
    sext.i8 rax
    ret rax

function @div_narrow_negative3
  abi
    param %value -> rdi : i8
    return i8 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rcx, -3
    mov rax, rdi
    cqo
    idiv rcx
    sext.i8 rax
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 96
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %bad_q_negative5 -> [rbp-8] : i64

  block ^entry
    mov rdi, -9223372036854775808
    call @div3 [args=(rdi)]
    mov rbx, rax
    mov rdx, -3074457345618258602
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdi, 9223372036854775807
    call @div7 [args=(rdi)]
    mov r12, rax
    mov rdx, 1317624576693539401
    cmp.i64 r12, rdx
    setne r12
    movzx r12, r12
    mov rdi, 9223372036854775807
    call @div_large [args=(rdi)]
    mov r13, rax
    mov rdx, 4294967298
    cmp.i64 r13, rdx
    setne r13
    movzx r13, r13
    mov rdi, -9223372036854775808
    call @div_negative3 [args=(rdi)]
    mov r14, rax
    mov rdx, 3074457345618258602
    cmp.i64 r14, rdx
    setne r14
    movzx r14, r14
    mov rdi, 9223372036854775807
    call @div_negative5 [args=(rdi)]
    mov r15, rax
    mov rdx, -1844674407370955161
    cmp.i64 r15, rdx
    setne r15
    movzx r15, r15
    mov rdi, -128
    call @div_narrow3 [args=(rdi)]
    sext.i8 rax
    store.i64 [rbp-8], r15
    mov r15, rax
    mov rdx, -42
    cmp.i8 r15, rdx
    setne r15
    movzx r15, r15
    mov rdi, 127
    call @div_narrow_negative3 [args=(rdi)]
    sext.i8 rax
    mov rdx, -42
    cmp.i8 rax, rdx
    setne rax
    movzx rax, rax
    or rbx, r12
    or r13, r14
    load.i64 r8, [rbp-8]
    or r8, r15
    or r8, rax
    or rbx, r13
    or rbx, r8
    mov rax, rbx
    sext.i32 rax
    ret rax
