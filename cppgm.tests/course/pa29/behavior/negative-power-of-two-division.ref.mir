machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 112
    scratch_bytes 48
    preserve rbx r12 r13 r14 r15
    temp %q1 -> [rbp-8] : i64
    temp %bad_q1 -> [rbp-16] : i64

  block ^entry
    mov r8, 100
    mov rdx, -2
    mov rcx, rdx
    mov rax, r8
    cqo
    idiv rcx
    mov r8, rax
    mov rdx, -50
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, -99
    mov rdx, -4
    mov rcx, rdx
    mov rax, r9
    cqo
    idiv rcx
    mov r9, rax
    mov rdx, 24
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rbx, -99
    mov rdx, -4
    mov rcx, rdx
    mov rax, rbx
    cqo
    idiv rcx
    mov rbx, rdx
    mov rdx, -3
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov r12, -9223372036854775808
    mov rdx, -9223372036854775808
    mov rcx, rdx
    mov rax, r12
    cqo
    idiv rcx
    mov r12, rax
    mov rdx, 1
    cmp.i64 r12, rdx
    setne r12
    movzx r12, r12
    mov r13, 9223372036854775807
    mov rdx, -9223372036854775808
    mov rcx, rdx
    mov rax, r13
    cqo
    idiv rcx
    mov r13, rdx
    mov rdx, 9223372036854775807
    cmp.i64 r13, rdx
    setne r13
    movzx r13, r13
    mov r14, -100
    mov rdx, -7
    mov rcx, rdx
    mov rax, r14
    cqo
    idiv rcx
    mov r14, rax
    mov rdx, 14
    cmp.i64 r14, rdx
    setne r14
    movzx r14, r14
    mov r15, -100
    mov rdx, -7
    mov rcx, rdx
    mov rax, r15
    cqo
    idiv rcx
    mov r15, rdx
    mov rdx, -2
    cmp.i64 r15, rdx
    setne r15
    movzx r15, r15
    mov rax, 100
    mov rdx, -1
    mov rcx, rdx
    cqo
    idiv rcx
    store.i64 [rbp-8], rax
    load.i64 rax, [rbp-8]
    mov rdx, -100
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    store.i64 [rbp-16], rax
    or r8, r9
    or rbx, r12
    or r13, r14
    load.i64 rdx, [rbp-16]
    or r15, rdx
    or r8, rbx
    or r13, r15
    or r8, r13
    mov r9, r8
    sext.i32 r9
    mov rax, r9
    ret rax
