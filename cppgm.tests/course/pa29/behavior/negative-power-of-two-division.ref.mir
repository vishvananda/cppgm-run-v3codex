machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14

  block ^entry
    mov r8, 100
    mov rcx, -2
    mov rax, r8
    cqo
    idiv rcx
    mov r8, rax
    mov rdx, -50
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov r9, -99
    mov rcx, -4
    mov rax, r9
    cqo
    idiv rcx
    mov r9, rax
    mov rdx, 24
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rdi, -99
    mov rcx, -4
    mov rax, rdi
    cqo
    idiv rcx
    mov rdi, rdx
    mov rdx, -3
    cmp.i64 rdi, rdx
    setne rdi
    movzx rdi, rdi
    mov rsi, -9223372036854775808
    mov rcx, -9223372036854775808
    mov rax, rsi
    cqo
    idiv rcx
    mov rsi, rax
    mov rdx, 1
    cmp.i64 rsi, rdx
    setne rsi
    movzx rsi, rsi
    mov rbx, 9223372036854775807
    mov rcx, -9223372036854775808
    mov rax, rbx
    cqo
    idiv rcx
    mov rbx, rdx
    mov rdx, 9223372036854775807
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov r12, -100
    mov rcx, -7
    mov rax, r12
    cqo
    idiv rcx
    mov r12, rax
    mov rdx, 14
    cmp.i64 r12, rdx
    setne r12
    movzx r12, r12
    mov r13, -100
    mov rcx, -7
    mov rax, r13
    cqo
    idiv rcx
    mov r13, rdx
    mov rdx, -2
    cmp.i64 r13, rdx
    setne r13
    movzx r13, r13
    mov r14, 100
    mov rcx, -1
    mov rax, r14
    cqo
    idiv rcx
    mov r14, rax
    mov rdx, -100
    cmp.i64 r14, rdx
    setne r14
    movzx r14, r14
    or r8, r9
    or rdi, rsi
    or rbx, r12
    or r13, r14
    or r8, rdi
    or rbx, r13
    or r8, rbx
    mov rax, r8
    sext.i32 rax
    ret rax
