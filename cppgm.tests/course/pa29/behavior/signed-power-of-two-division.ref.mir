machine_ir x86_64 linux

startup
    call @main
    mov rdi, rax
    exit

function @div2
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0

  block ^entry
    mov rdx, 2
    mov rcx, rdx
    mov rax, rdi
    cqo
    idiv rcx
    ret rax

function @mod8
