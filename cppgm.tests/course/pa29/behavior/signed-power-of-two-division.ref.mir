machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @div2
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rcx, 2
    mov rax, rdi
    cqo
    idiv rcx
    ret rax

function @mod8
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rcx, 8
    mov rax, rdi
    cqo
    idiv rcx
    ret rdx

