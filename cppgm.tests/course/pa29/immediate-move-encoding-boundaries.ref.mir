machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    mov r8, 4294967295
    mov rax, r8
    mov rdx, 4294967295
    cmp.i64 rax, rdx
    jne ^bad_u32
    jmp ^check_above_u32

  block ^bad_u32
    mov rax, 1
    ret rax

  block ^check_above_u32
    mov r8, 4294967296
    mov rax, r8
    mov rdx, 4294967296
    cmp.i64 rax, rdx
    jne ^bad_above_u32
    jmp ^check_i32_min

  block ^bad_above_u32
    mov rax, 2
    ret rax

  block ^check_i32_min
    mov r8, -2147483648
    cmp.i64 r8, -2147483648
    jne ^bad_i32_min
    jmp ^check_below_i32

  block ^bad_i32_min
    mov rax, 3
    ret rax

  block ^check_below_i32
    mov r8, -2147483649
    mov rax, r8
    mov rdx, -2147483649
    cmp.i64 rax, rdx
    jne ^bad_below_i32
    jmp ^ok

  block ^bad_below_i32
    mov rax, 4
    ret rax

  block ^ok
    mov rax, 0
    ret rax
