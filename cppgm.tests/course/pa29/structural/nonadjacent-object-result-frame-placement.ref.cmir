machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @result
  storage data
  item i64 0
  item i64 0

function @make_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    slot $value -> [rbp-<off0>] : obj<16x8>

  block ^entry
    lea r8, [rbp-<off0>]
    store.i64 [r8], 17
    store.i64 [r8+<off0>], 23
    load.i64 rax, [rbp-<off0>]
    load.i64 rdx, [rbp-<off1>]
    ret

function @forward_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    slot $result -> [rbp-<off0>] : obj<16x8>

  block ^entry
    call @make_pair [args=()]
    store.i64 [rbp-<off0>], rax
    store.i64 [rbp-<off1>], rdx
    load.i64 rax, [rbp-<off0>]
    load.i64 rdx, [rbp-<off1>]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    call @forward_pair [args=()]
    mov <gpr0>, @result
    store.i64 [<gpr0>], rax
    store.i64 [<gpr0>+<off0>], rdx
    mov r8, @result
    load.i64 r9, @result
    mov rdi, @result
    load.i64 rsi, [rdi+<off0>]
    mov rdx, 17
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rdx, 23
    cmp.i64 rsi, rdx
    setne rsi
    movzx rsi, rsi
    or r9, rsi
    mov rax, r9
    sext.i32 rax
    ret rax
