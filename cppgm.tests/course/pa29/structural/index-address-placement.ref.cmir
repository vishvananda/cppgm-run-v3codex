machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @values
  storage data
  item i64 10
  item i64 20
  item i64 30
  item i64 40

function @variable_address
  abi
    param %base -> rdi : ptr
    param %which -> rsi : i64
    return ptr -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    lea rax, [rdi+rsi*8]
    ret rax

function @constant_address
  abi
    param %base -> rdi : ptr
    return ptr -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    lea rax, [rdi+<off0>]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1>

  block ^entry
    mov <gpr0>, @values
    mov rdi, <gpr0>
    mov rsi, 2
    call @variable_address [args=(rsi,rdi)]
    load.i64 <gpr1>, [rax]
    mov rdi, <gpr0>
    call @constant_address [args=(rdi)]
    load.i64 r8, [rax]
    mov rdx, 30
    cmp.i64 <gpr1>, rdx
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    mov rdx, 40
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    or <gpr1>, r8
    mov rax, <gpr1>
    sext.i32 rax
    ret rax
