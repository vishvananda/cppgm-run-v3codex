machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @shift_with_typed_count
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov r8, 3
    shl r8, 2
    sext.i32 r8
    ret r8

function @explicit_truncation
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 4294967297
    sext.i32 rax
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    call @shift_with_typed_count [args=()]
    mov rbx, rax
    sext.i32 rbx
    call @explicit_truncation [args=()]
    mov r8, rax
    sext.i32 r8
    mov rdx, 12
    cmp.i32 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 1
    cmp.i32 r8, rdx
    setne r8
    movzx r8, r8
    or rbx, r8
    mov rax, rbx
    sext.i32 rax
    ret rax
