machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cell
  storage data
  item i64 73

global @tag_source
  storage data
  item i8 1

function @observe
  abi
    param %base -> rdi : ptr
    param %tag -> rsi : i8
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %base -> [rbp-<off0>] : ptr
    param-slot %tag -> [rbp-<off1>] : obj<1x1>

  block ^entry
    store.ptr [rbp-<off0>], rdi
    store.i8 [rbp-<off1>], rsi
    load.ptr rcx, [rbp-<off0>]
    load.i64 rax, [rcx]
    ret rax

function @forward
  abi
    param %base -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $tag -> [rbp-<off2>] : obj<1x1>

  block ^entry
    mov r9, rdi
    lea rdi, [rbp-<off2>]
    mov rsi, @tag_source
    copy_bytes 1x1, rdi, rsi
    mov rdi, r9
    load.i8 rsi, [rbp-<off2>]
    call @observe [args=(rsi,rdi)]
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rdi, @cell
    call @forward [args=(rdi)]
    mov rdx, 73
    cmp.i64 rax, rdx
    setne rax
    movzx rax, rax
    ret rax
