machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %left -> [rbp-<off0>] : i64
    temp %right -> [rbp-<off1>] : i64
    temp %iteration -> [rbp-<off2>] : i64
    temp %phi-cycle-scratch -> [rbp-<off3>] : i64

  block ^entry
    mov <gpr0>, 1
    store.i64 [rbp-<off0>], <gpr0>
    mov <gpr0>, 2
    store.i64 [rbp-<off1>], <gpr0>
    mov <gpr0>, 0
    store.i64 [rbp-<off2>], <gpr0>
    jmp ^loop

  block ^loop
    cmp.i64 [rbp-<off2>], 1
    jge ^exit
    jmp ^latch

  block ^latch
    load.i64 r8, [rbp-<off2>]
    add r8, 1
    store.i64 [rbp-<off2>], r8
    load.i64 <gpr0>, [rbp-<off1>]
    store.i64 [rbp-<off3>], <gpr0>
    load.i64 <gpr0>, [rbp-<off0>]
    store.i64 [rbp-<off1>], <gpr0>
    load.i64 <gpr0>, [rbp-<off3>]
    store.i64 [rbp-<off0>], <gpr0>
    jmp ^loop

  block ^exit
    load.i64 r8, [rbp-<off0>]
    imul r8, 10
    add r8, [rbp-<off1>]
    ret r8
