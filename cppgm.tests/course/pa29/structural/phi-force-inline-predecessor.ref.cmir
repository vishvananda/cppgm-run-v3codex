machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @touch
  abi
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    ret

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %result -> [rbp-<off0>] : i64

  block ^entry
    mov rax, 1
    cmp.i64 rax, 0
    jne ^left
    jmp ^right

  block ^left
    jmp ^__force_inline_prologue_1

  block ^__force_inline_prologue_1
    jmp ^__force_inline_block_0

  block ^__force_inline_block_0
    jmp ^__force_inline_continuation_2

  block ^__force_inline_continuation_2
    mov r8, 40
    add r8, 2
    store.i64 [rbp-<off0>], r8
    jmp ^join

  block ^right
    mov <gpr0>, 7
    store.i64 [rbp-<off0>], <gpr0>
    jmp ^join

  block ^join
    load.i64 rax, [rbp-<off0>]
    ret rax
