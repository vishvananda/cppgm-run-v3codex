machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @global_rhs
  storage scalar i64
  init i64 9

global @xor_rhs
  storage scalar i64
  init i64 240

global @byte_rhs
  storage scalar i8
  init i8 3

global @words
  storage data
  item i64 2
  item i64 4
  item i64 77

function @add_global
  abi
    param %left -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    add rdi, @global_rhs
    ret rdi

function @sub_frame
  abi
    param %left -> rdi : i64
    param %unused1 -> rsi : i64
    param %unused2 -> rdx : i64
    param %unused3 -> rcx : i64
    param %unused4 -> r8 : i64
    param %unused5 -> r9 : i64
    param %right -> [rbp+16] : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %right -> [rbp-8] : i64

  block ^entry
    load.i64 rax, [rbp+16]
    store.i64 [rbp-8], rax
    sub rdi, [rbp-8]
    ret rdi

function @and_dereference
  abi
    param %address -> rdi : ptr
    param %left -> rsi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    and rsi, [rdi]
    ret rsi

function @or_indexed
  abi
    param %base -> rdi : ptr
    param %index_value -> rsi : i64
    param %left -> rdx : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    or rdx, [rdi+rsi*8]
    ret rdx

function @xor_global
  abi
    param %left -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    xor rdi, @xor_rhs
    ret rdi

function @multiply_frame
  abi
    param %left -> rdi : i32
    param %unused1 -> rsi : i32
    param %unused2 -> rdx : i32
    param %unused3 -> rcx : i32
    param %unused4 -> r8 : i32
    param %unused5 -> r9 : i32
    param %right -> [rbp+16] : i32
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %right -> [rbp-4] : i32

  block ^entry
    load.i32 rax, [rbp+16]
    store.i32 [rbp-4], rax
    imul rdi, [rbp-4]
    sext.i32 rdi
    ret rdi

function @compare_indexed
  abi
    param %base -> rdi : ptr
    param %index_value -> rsi : i64
    param %left -> rdx : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    cmp.i64 rdx, [rdi+rsi*8]
    sete rax
    movzx rax, rax
    ret rax

function @divide_dereference
  abi
    param %address -> rdi : ptr
    param %left -> rsi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 r8, [rdi]
    mov rcx, r8
    mov rax, rsi
    cqo
    idiv rcx
    ret rax

function @shift_frame
  abi
    param %left -> rdi : i64
    param %unused1 -> rsi : i64
    param %unused2 -> rdx : i64
    param %unused3 -> rcx : i64
    param %unused4 -> r8 : i64
    param %unused5 -> r9 : i64
    param %count -> [rbp+16] : i64
    return i64 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    param-slot %count -> [rbp-8] : i64

  block ^entry
    load.i64 rax, [rbp+16]
    store.i64 [rbp-8], rax
    load.i64 rdx, [rbp-8]
    mov rcx, rdx
    shl rdi, cl
    ret rdi

function @multiply_byte
  abi
    param %address -> rdi : ptr
    param %left -> rsi : i8
    return i8 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i8 r8, [rdi]
    imul rsi, r8
    sext.i8 rsi
    ret rsi

function @add_byte_indexed
  abi
    param %base -> rdi : ptr
    param %index_value -> rsi : i64
    param %left -> rdx : i8
    return i8 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    add rdx, [rdi+rsi]
    sext.i8 rdx
    ret rdx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 96
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13 r14 r15
    temp %sub -> [rbp-8] : i64
    temp %and -> [rbp-16] : i64
    temp %or -> [rbp-24] : i64
    temp %multiply -> [rbp-28] : i32
    temp %xor -> [rbp-40] : i64
    temp %shift -> [rbp-48] : i64
    temp %bad_xor -> [rbp-8] : i64
    temp %bad_divide -> [rbp-16] : i64

  block ^entry
    mov rbx, @global_rhs
    mov r12, @byte_rhs
    mov r13, @words
    mov rdi, 5
    call @add_global [args=(rdi)]
    mov r14, rax
    sub rsp, 16
    mov rdi, 20
    mov rsi, 0
    mov rdx, 0
    mov rcx, 0
    mov r8, 0
    mov r9, 0
    mov r11, 3
    store.i64 [rsp], r11
    call @sub_frame [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    store.i64 [rbp-8], rax
    mov rdi, rbx
    mov rsi, 15
    call @and_dereference [args=(rsi,rdi)]
    mov r15, rax
    mov rdi, r13
    mov rsi, 1
    mov rdx, 1
    call @or_indexed [args=(rdx,rsi,rdi)]
    store.i64 [rbp-16], r15
    mov r15, rax
    mov rdi, 15
    call @xor_global [args=(rdi)]
    store.i64 [rbp-24], r15
    mov r15, rax
    sub rsp, 16
    mov rdi, 6
    mov rsi, 0
    mov rdx, 0
    mov rcx, 0
    mov r8, 0
    mov r9, 0
    mov r11, 7
    store.i64 [rsp], r11
    call @multiply_frame [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    store.i32 [rbp-28], rax
    mov rdi, r13
    mov rsi, 2
    mov rdx, 77
    call @compare_indexed [args=(rdx,rsi,rdi)]
    store.i64 [rbp-40], r15
    mov r15, rax
    mov rdi, rbx
    mov rsi, 81
    call @divide_dereference [args=(rsi,rdi)]
    mov r13, rax
    sub rsp, 16
    mov rdi, 3
    mov rsi, 0
    mov rdx, 0
    mov rcx, 0
    mov r8, 0
    mov r9, 0
    mov r11, 2
    store.i64 [rsp], r11
    call @shift_frame [args=(rcx,rdx,rsi,rdi,r8,r9), stack=16]
    add rsp, 16
    store.i64 [rbp-48], rax
    mov rdi, r12
    mov rsi, 5
    call @multiply_byte [args=(rsi,rdi)]
    mov rbx, rax
    sext.i8 rbx
    mov rdi, r12
    mov rsi, 0
    mov rdx, 4
    call @add_byte_indexed [args=(rdx,rsi,rdi)]
    mov r8, rax
    sext.i8 r8
    mov rdx, 14
    cmp.i64 r14, rdx
    setne r14
    movzx r14, r14
    load.i64 r9, [rbp-8]
    mov rdx, 17
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    load.i64 rdi, [rbp-16]
    mov rdx, 9
    cmp.i64 rdi, rdx
    setne rdi
    movzx rdi, rdi
    load.i64 rsi, [rbp-24]
    mov rdx, 5
    cmp.i64 rsi, rdx
    setne rsi
    movzx rsi, rsi
    load.i64 r12, [rbp-40]
    mov rdx, 255
    cmp.i64 r12, rdx
    setne r12
    movzx r12, r12
    store.i64 [rbp-8], r12
    load.i32 r12, [rbp-28]
    mov rdx, 42
    cmp.i32 r12, rdx
    setne r12
    movzx r12, r12
    mov rdx, 1
    cmp.i64 r15, rdx
    setne r15
    movzx r15, r15
    mov rdx, 9
    cmp.i64 r13, rdx
    setne r13
    movzx r13, r13
    store.i64 [rbp-16], r13
    load.i64 r13, [rbp-48]
    mov rdx, 12
    cmp.i64 r13, rdx
    setne r13
    movzx r13, r13
    mov rdx, 15
    cmp.i8 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 7
    cmp.i8 r8, rdx
    setne r8
    movzx r8, r8
    or r14, r9
    or rdi, rsi
    load.i64 r9, [rbp-8]
    or r9, r12
    or r15, [rbp-16]
    or rbx, r8
    or r13, rbx
    or r14, rdi
    or r9, r15
    or r14, r9
    or r14, r13
    mov rax, r14
    sext.i32 rax
    ret rax
