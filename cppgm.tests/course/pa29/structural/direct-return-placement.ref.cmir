machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @value
  storage scalar i32
  init i32 17

function @return_constant
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 11
    ret rax

function @return_load
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i32 rax, @value
    ret rax

function @return_global_address
  abi
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, @value
    ret rax

function @return_slot_address
  abi
    return ptr -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $local -> [rbp-<off0>] : i32

  block ^entry
    lea rax, [rbp-<off0>]
    ret rax

function @return_compare
  abi
    param %left -> rdi : i64
    param %right -> rsi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    cmp.i64 rdi, rsi
    setb rax
    movzx rax, rax
    ret rax

function @return_negated
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, rdi
    neg rax
    ret rax

function @return_converted
  abi
    param %value -> rdi : i64
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, rdi
    sext.i32 rax
    ret rax

function @return_quotient
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rcx, 7
    mov rax, rdi
    cqo
    idiv rcx
    ret rax

function @return_remainder
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rcx, 7
    mov rax, rdi
    cqo
    idiv rcx
    ret rdx

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    temp %negated -> [rbp-<off1>] : i64
    temp %converted -> [rbp-<off2>] : i32

  block ^entry
    call @return_constant [args=()]
    mov <gpr0>, rax
    sext.i32 <gpr0>
    call @return_load [args=()]
    mov <gpr1>, rax
    sext.i32 <gpr1>
    call @return_global_address [args=()]
    mov <gpr2>, rax
    mov rdi, 3
    mov rsi, 5
    call @return_compare [args=(rsi,rdi)]
    mov <gpr3>, rax
    mov rdi, -7
    call @return_negated [args=(rdi)]
    mov <gpr4>, rax
    mov rdi, 4294967297
    call @return_converted [args=(rdi)]
    store.i64 [rbp-<off1>], <gpr4>
    mov <gpr4>, rax
    sext.i32 <gpr4>
    mov rdi, 50
    call @return_quotient [args=(rdi)]
    store.i32 [rbp-<off2>], <gpr4>
    mov <gpr4>, rax
    mov rdi, 50
    call @return_remainder [args=(rdi)]
    mov r8, rax
    mov r9, @value
    mov rdx, 11
    cmp.i32 <gpr0>, rdx
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    mov rdx, 17
    cmp.i32 <gpr1>, rdx
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    cmp.ptr <gpr2>, r9
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    mov rdx, 1
    cmp.i64 <gpr3>, rdx
    setne <gpr3>
    movzx <gpr3>, <gpr3>
    load.i64 r9, [rbp-<off1>]
    mov rdx, 7
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    load.i32 rdi, [rbp-<off2>]
    mov rdx, 1
    cmp.i32 rdi, rdx
    setne rdi
    movzx rdi, rdi
    mov rdx, 7
    cmp.i64 <gpr4>, rdx
    setne <gpr4>
    movzx <gpr4>, <gpr4>
    mov rdx, 1
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    or <gpr0>, <gpr1>
    or <gpr2>, <gpr3>
    or <gpr2>, r9
    or <gpr2>, rdi
    or <gpr4>, r8
    or <gpr2>, <gpr4>
    or <gpr0>, <gpr2>
    mov rax, <gpr0>
    sext.i32 rax
    ret rax
