machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cells
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0

function @produce
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 29
    ret rax

function @write_second
  abi
    param %base -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0>

  block ^entry
    mov <gpr0>, rdi
    jmp ^write

  block ^write
    call @produce [args=()]
    store.i64 [<gpr0>+<off0>], rax
    store.i64 [<gpr0>], 11
    ret

function @initialize_tail
  abi
    param %base -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %index -> [rbp-<off0>] : i64

  block ^entry
    mov <gpr1>, 0
    store.i64 [rbp-<off0>], <gpr1>
    jmp ^condition

  block ^condition
    cmp.i64 [rbp-<off0>], 2
    jb ^body
    jmp ^done

  block ^body
    load.i64 r8, [rbp-<off0>]
    lea r8, [rdi+r8*8+<off0>]
    load.i64 r9, [rbp-<off0>]
    add r9, 40
    store.i64 [r8], r9
    load.i64 r8, [rbp-<off0>]
    add r8, 1
    store.i64 [rbp-<off0>], r8
    jmp ^condition

  block ^done
    ret

function @read_before_call
  abi
    param %base -> rdi : ptr
    param %x -> rsi : i64
    param %y -> rdx : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr2> <gpr3>

  block ^entry
    mov <gpr0>, rdi
    jmp ^compute

  block ^compute
    add rsi, 1
    add rdx, 2
    mov r8, 10
    add r8, 20
    mov r9, 30
    add r9, 40
    mov rdi, rsi
    add rdi, rdx
    load.i64 <gpr2>, [<gpr0>+<off0>]
    add r8, r9
    add rdi, r8
    mov <gpr3>, rdi
    add <gpr3>, <gpr2>
    call @produce [args=()]
    mov r8, rax
    store.i64 [<gpr0>], r8
    add <gpr3>, r8
    ret <gpr3>

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve <gpr0>

  block ^entry
    mov <gpr0>, @cells
    mov rdi, <gpr0>
    call @write_second [args=(rdi)]
    mov rdi, <gpr0>
    call @initialize_tail [args=(rdi)]
    mov rdi, <gpr0>
    mov rsi, 3
    mov rdx, 5
    call @read_before_call [args=(rdx,rsi,rdi)]
    mov r8, rax
    load.i64 r9, [<gpr0>+<off0>]
    load.i64 rdi, [<gpr0>+<off1>]
    load.i64 rsi, [<gpr0>+<off2>]
    mov rdx, 29
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rdx, 40
    cmp.i64 rdi, rdx
    setne rdi
    movzx rdi, rdi
    mov rdx, 41
    cmp.i64 rsi, rdx
    setne rsi
    movzx rsi, rsi
    mov rdx, 169
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    or rdi, rsi
    or r9, r8
    or r9, rdi
    mov rax, r9
    sext.i32 rax
    ret rax
