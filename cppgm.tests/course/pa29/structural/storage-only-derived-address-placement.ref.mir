machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cells
  storage data
  item i64 0
  item i64 0
  item i64 0
  item i64 0

function @produce
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, 29
    ret rax

function @write_second
  abi
    param %base -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, rdi
    jmp ^write

  block ^write
    call @produce [args=()]
    store.i64 [rbx+8], rax
    store.i64 [rbx], 11
    ret

function @initialize_tail
  abi
    param %base -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %index -> [rbp-8] : i64

  block ^entry
    mov r11, 0
    store.i64 [rbp-8], r11
    jmp ^condition

  block ^condition
    cmp.i64 [rbp-8], 2
    jb ^body
    jmp ^done

  block ^body
    load.i64 r8, [rbp-8]
    lea r8, [rdi+r8*8+16]
    load.i64 r9, [rbp-8]
    add r9, 40
    store.i64 [r8], r9
    load.i64 r8, [rbp-8]
    add r8, 1
    store.i64 [rbp-8], r8
    jmp ^condition

  block ^done
    ret

function @read_before_call
  abi
    param %base -> rdi : ptr
    param %x -> rsi : i64
    param %y -> rdx : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve rbx r12 r13

  block ^entry
    mov rbx, rdi
    jmp ^compute

  block ^compute
    add rsi, 1
    add rdx, 2
    mov r8, 10
    add r8, 20
    mov r9, 30
    add r9, 40
    mov rdi, rsi
    add rdi, rdx
    load.i64 r12, [rbx+8]
    add r8, r9
    add rdi, r8
    mov r13, rdi
    add r13, r12
    call @produce [args=()]
    mov r8, rax
    store.i64 [rbx], r8
    add r13, r8
    ret r13

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve rbx

  block ^entry
    mov rbx, @cells
    mov rdi, rbx
    call @write_second [args=(rdi)]
    mov rdi, rbx
    call @initialize_tail [args=(rdi)]
    mov rdi, rbx
    mov rsi, 3
    mov rdx, 5
    call @read_before_call [args=(rdx,rsi,rdi)]
    mov r8, rax
    load.i64 r9, [rbx+8]
    load.i64 rdi, [rbx+16]
    load.i64 rsi, [rbx+24]
    mov rdx, 29
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rdx, 40
    cmp.i64 rdi, rdx
    setne rdi
    movzx rdi, rdi
    mov rdx, 41
    cmp.i64 rsi, rdx
    setne rsi
    movzx rsi, rsi
    mov rdx, 169
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    or rdi, rsi
    or r9, r8
    or r9, rdi
    mov rax, r9
    sext.i32 rax
    ret rax
