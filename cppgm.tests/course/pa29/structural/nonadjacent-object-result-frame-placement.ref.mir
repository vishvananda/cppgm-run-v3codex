machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @result
  storage data
  item i64 0
  item i64 0

function @make_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $value -> [rbp-16] : obj<16x8>

  block ^entry
    store.i64 [rbp-16], 17
    store.i64 [rbp-8], 23
    load.i64 rax, [rbp-16]
    load.i64 rdx, [rbp-8]
    ret

function @forward_pair
  abi
    return obj<16x8> -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    slot $result -> [rbp-16] : obj<16x8>

  block ^entry
    call @make_pair [args=()]
    store.i64 [rbp-16], rax
    store.i64 [rbp-8], rdx
    load.i64 rax, [rbp-16]
    load.i64 rdx, [rbp-8]
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    call @forward_pair [args=()]
    mov r11, @result
    store.i64 [r11], rax
    store.i64 [r11+8], rdx
    load.i64 r8, @result
    mov r9, @result
    lea r9, [r9+8]
    load.i64 rdi, [r9]
    mov rdx, 17
    cmp.i64 r8, rdx
    setne r8
    movzx r8, r8
    mov rdx, 23
    cmp.i64 rdi, rdx
    setne rdi
    movzx rdi, rdi
    or r8, rdi
    mov rax, r8
    sext.i32 rax
    ret rax
