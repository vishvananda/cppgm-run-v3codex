machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @cells
  storage data
  item i64 0
  item i64 0
  item i64 0

global @source
  storage scalar i64
  init i64 99

function @write_fields
  abi
    param %base -> rdi : ptr
    param %first -> rsi : ptr
    param %number -> rdx : i64
    param %last -> rcx : ptr
    return void -> void
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    store.ptr [rdi], rsi
    store.i64 [rdi+<off0>], rdx
    store.ptr [rdi+<off1>], rcx
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 64
    scratch_bytes 48
    frame_pointer keep
    epilogues shared
    preserve <gpr0>

  block ^entry
    mov <gpr0>, @cells
    mov r8, @source
    mov rdi, <gpr0>
    mov rsi, r8
    mov rdx, 17
    mov rcx, r8
    call @write_fields [args=(rcx,rdx,rsi,rdi)]
    load.ptr r8, [<gpr0>+<off0>]
    load.i64 r9, [r8]
    mov rdx, 99
    cmp.i64 r9, rdx
    setne r9
    movzx r9, r9
    mov rax, r9
    sext.i32 rax
    ret rax
