machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @wide
  storage scalar i128
  init i128 1267650600228229401496703205376

function @main
  abi
    return i32 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %wide -> [rbp-<off0>] : i128

  block ^entry
    mov <gpr0>, @wide
    load.i64 rax, [<gpr0>]
    load.i64 rdx, [<gpr0>+<off0>]
    lea <gpr0>, [rbp-<off0>]
    store.i64 [<gpr0>], rax
    store.i64 [<gpr0>+<off0>], rdx
    lea <gpr0>, [rbp-<off0>]
    load.i64 rax, [<gpr0>]
    load.i64 rdx, [<gpr0>+<off0>]
    mov rcx, 0
    mov rsi, 68719476736
    cmp.i64 rdx, rsi
    sete <gpr1>
    movzx <gpr1>, <gpr1>
    cmp.i64 rax, rcx
    sete <gpr0>
    movzx <gpr0>, <gpr0>
    and <gpr1>, <gpr0>
    xor <gpr1>, 1
    mov r8, <gpr1>
    mov rax, r8
    sext.i32 rax
    ret rax
