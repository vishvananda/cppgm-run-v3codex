machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @value
  storage scalar i64
  init i64 41

function @direct_storage_use
  abi
    param %replacement -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    load.i64 r8, @value
    store.i64 @value, rdi
    ret r8

function @observe_address
  abi
    return ptr -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues shared

  block ^entry
    mov rax, @value
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    preserve <gpr0> <gpr1>

  block ^entry
    mov rdi, 42
    call @direct_storage_use [args=(rdi), unwind=no]
    mov <gpr0>, rax
    load.i64 <gpr1>, @value
    call @observe_address [args=(), unwind=no]
    mov r8, rax
    mov rdx, 41
    cmp.i64 <gpr0>, rdx
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    mov rdx, 42
    cmp.i64 <gpr1>, rdx
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    mov rdx, 0
    cmp.ptr r8, rdx
    sete r8
    movzx r8, r8
    or <gpr0>, <gpr1>
    or <gpr0>, r8
    ret <gpr0>
