machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues shared
    temp %start -> [rbp-8] : i64
    temp %current -> [rbp-16] : i64

  block ^entry
    mov rax, 0
    cmp.i64 rax, 0
    jne ^side
    jmp ^__phi_edge_6

  block ^side
    mov r11, 9
    store.i64 [rbp-8], r11
    jmp ^join

  block ^join
    load.i64 r11, [rbp-8]
    store.i64 [rbp-16], r11
    jmp ^loop

  block ^loop
    cmp.i64 [rbp-16], 12
    jge ^exit
    jmp ^latch

  block ^latch
    load.i64 r8, [rbp-16]
    add r8, 1
    store.i64 [rbp-16], r8
    jmp ^loop

  block ^exit
    load.i64 rax, [rbp-16]
    ret rax

  block ^__phi_edge_6
    mov r11, 7
    store.i64 [rbp-8], r11
    jmp ^join
