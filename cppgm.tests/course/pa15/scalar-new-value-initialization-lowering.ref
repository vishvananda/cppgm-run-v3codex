declare function @operator_new(%arg0 : i64) -> ptr [binding=strong, object=cppgm_builtin_operator_new]

function @make_value() -> ptr [binding=strong, object=_Z10make_valuev] {
  block ^entry:
    %t1 = convert sext i64 i32 4
    %t2 = call ptr @operator_new(%t1)
    store u32 0, %t2
    return ptr %t2
}
