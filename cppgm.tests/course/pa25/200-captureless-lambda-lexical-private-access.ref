    %t3 = load ptr $this
    %t4 = call i32 @__lambda_holder__read_t0_0_n0__operator__(%t2, %t3)
    return i32 %t4
}

function @__lambda_holder__read_t0_0_n0__operator__(%this : ptr, %object : ptr [pass=reference]) -> i32 [binding=weak, object=_ZZN6holder4readEvENUlRS_E0_clEv] {
