global @calls : i32 [binding=strong, object=_Z5calls] = zero

global @values [binding=strong, object=_Z6values] = {
  i32 1
  i32 2
  i32 3
}

function @range() -> ptr [binding=strong, object=_Z5rangev] {
  block ^entry:
    %t1 = load i32 @calls
    %t2 = binary add i32 %t1, 1
    store i32 %t2, @calls
    %t3 = addr @values
    return ptr %t3
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $sum : i32
  slot $__range1 : ptr
  slot $__idx2 : i32
  slot $value : i32
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    store i32 0, $sum
    %t1 = call ptr @range()
    store ptr %t1, $__range1
    store i32 0, $__idx2
    jump ^for_cond_1

  block ^for_cond_1:
    %t2 = load i32 $__idx2
    %t3 = cmp lt i32 %t2, 3
    branch %t3, ^for_body_2, ^for_end_4

  block ^for_body_2:
    %t4 = load ptr $__range1
    %t5 = unary decay ptr %t4
    %t6 = load i32 $__idx2
    %t7 = index i32 [projection=array_element] %t5, %t6
    %t8 = load i32 %t7
    store i32 %t8, $value
    %t9 = load i32 $sum
    %t10 = load i32 $value
    %t11 = binary add i32 %t9, %t10
    store i32 %t11, $sum
    jump ^for_iter_3

  block ^for_iter_3:
    %t12 = load i32 $__idx2
    %t13 = binary add i32 %t12, 1
    store i32 %t13, $__idx2
    jump ^for_cond_1

  block ^for_end_4:
    %t14 = load i32 @calls
    %t15 = cmp eq i32 %t14, 1
    branch %t15, ^land_rhs_8, ^land_short_9

  block ^land_rhs_8:
    %t16 = load i32 $sum
    %t17 = cmp eq i32 %t16, 6
    %t18 = cmp ne i64 %t17, 0
    store i64 %t18, $land__2
    jump ^land_end_10

  block ^land_short_9:
    store i64 0, $land__2
    jump ^land_end_10

  block ^land_end_10:
    %t19 = load i64 $land__2
    branch %t19, ^cond_then_5, ^cond_else_6

  block ^cond_then_5:
    store i32 0, $cond__1
    jump ^cond_end_7

  block ^cond_else_6:
    store i32 1, $cond__1
    jump ^cond_end_7

  block ^cond_end_7:
    %t20 = load i32 $cond__1
    return i32 %t20
}
