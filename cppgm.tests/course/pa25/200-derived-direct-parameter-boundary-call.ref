    call void @Direct__Direct__ov2(%t2, %t3)
    %t4 = call i32 @take_direct($argobj__2)
    %t5 = cmp eq i32 %t4, 9
    branch %t5, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t6 = load i32 $cond__1
    return i32 %t6
}

