function @main(%x : i64) -> i64 [role=entry] {
  block ^entry:
    %__o1inl0____o1inl0__result = binary add i64 %x, 1
    %address = addr @addressed
    %kept = call i64 %address(%__o1inl0____o1inl0__result) as (%arg0 : i64) -> i64
    return i64 %kept
}
function @addressed(%x : i64) -> i64 [binding=weak] {
  block ^entry:
    return i64 %x
}
function @rooted() -> i64 [binding=weak, object_root=yes] {
  block ^entry:
    return i64 7
}
