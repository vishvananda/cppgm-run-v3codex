declare function @observe(%value : i64) -> void

function @forwards(%dest : ptr, %a : i64, %b : i64) -> void {
  block ^entry:
    store i64 %a, %dest
    %t1 = index i8 [projection=field] %dest, 8
    store i64 %b, %t1
    %t3 = index i8 [projection=field] %dest, 16
    store i64 7, %t3
    return void
}
function @keeps_load(%dest : ptr, %a : i64) -> i64 {
  block ^entry:
    store i64 %a, %dest
    %t1 = index i8 [projection=field] %dest, 8
    store i64 9, %t1
    return i64 %a
}
function @keeps_two_copies(%dest : ptr, %other : ptr, %a : i64) -> void {
  block ^entry:
    store i64 %a, %dest
    %t1 = index i8 [projection=field] %dest, 8
    store i64 11, %t1
    store i64 %a, %other
    %t4 = index i8 [projection=field] %other, 8
    store i64 11, %t4
    return void
}
function @keeps_conditional_store(%dest : ptr, %a : i64, %pick : u8) -> void {
  slot $staging__sroa8 : i64

  block ^entry:
    branch %pick, ^set, ^done

  block ^set:
    store i64 13, $staging__sroa8
    jump ^done

  block ^done:
    store i64 %a, %dest
    %t1 = index i8 [projection=field] %dest, 8
    %t2 = load i64 $staging__sroa8
    store i64 %t2, %t1
    return void
}
