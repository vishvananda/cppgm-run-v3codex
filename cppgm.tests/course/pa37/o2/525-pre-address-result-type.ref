function @select_address(%choose : i64) -> i64 [no_inline=yes] {
  block ^entry:
    branch %choose, ^left, ^right

  block ^left:
    jump ^join

  block ^right:
    jump ^join

  block ^join:
    %t0 = phi i64 [^left: 11, ^right: 22]
    return i64 %t0
}
function @select_partial_address(%choose : i64) -> i64 [no_inline=yes] {
  block ^entry:
    branch %choose, ^left, ^right

  block ^left:
    jump ^join

  block ^right:
    jump ^join

  block ^join:
    %t1 = phi i64 [^left: 33, ^right: 0]
    return i64 %t1
}
