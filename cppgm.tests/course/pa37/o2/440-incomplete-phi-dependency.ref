global @take_outer : i64 = 1
global @take_path : i64 = 1
global @take_right : i64 = 0
global @repeat_inner : i64 = 0
global @result : i64 = 0

function @main() -> i64 {
  block ^entry:
    %take = load i64 @take_path
    %right = load i64 @take_right
    %again = load i64 @repeat_inner
    jump ^outer_header

  block ^outer_header:
    %outer = load i64 @take_outer
    branch %outer, ^inner_header, ^exit

  block ^inner_header:
    branch %take, ^choose, ^inner_merge

  block ^choose:
    branch %right, ^right, ^left

  block ^left:
    jump ^selected

  block ^right:
    jump ^selected

  block ^selected:
    %t2 = phi i64 [^left: 7, ^right: 9]
    store i64 %t2, @result
    jump ^inner_merge

  block ^inner_merge:
    branch %again, ^inner_header, ^outer_latch

  block ^outer_latch:
    store i64 0, @take_outer
    jump ^outer_header

  block ^exit:
    %answer = load i64 @result
    return i64 %answer
}
