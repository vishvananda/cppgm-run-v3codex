function @retained_leaf(%value : i32) -> i32 [binding=strong, object=_Z13retained_leafi, no_inline=yes] {
  slot $value : i32

  block ^entry:
    store i32 %value, $value
    %t1 = load i32 $value
    %t2 = binary add i32 %t1, 1
    return i32 %t2
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @retained_leaf(4)
    %t2 = binary sub i32 %t1, 5
    return i32 %t2
}
