global @observed : i32 [binding=strong, object=_Z8observed] = zero

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    store i32 0, @observed
    store i32 1, @observed
    store i32 3, @observed
    store i32 6, @observed
    jump ^for_end_4

  block ^for_end_4:
    branch 1, ^land_rhs_8, ^land_short_9

  block ^land_rhs_8:
    %t11 = load i32 @observed
    %t12 = cmp eq i32 %t11, 6
    jump ^land_end_10

  block ^land_short_9:
    jump ^land_end_10

  block ^land_end_10:
    %t18 = phi i64 [^land_rhs_8: %t12, ^land_short_9: 0]
    branch %t18, ^cond_then_5, ^cond_else_6

  block ^cond_then_5:
    jump ^cond_end_7

  block ^cond_else_6:
    jump ^cond_end_7

  block ^cond_end_7:
    %t17 = phi i32 [^cond_then_5: 0, ^cond_else_6: 1]
    return i32 %t17
}
