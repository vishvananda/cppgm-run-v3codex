global @g : i32 [binding=strong, object=_Z1g] = zero

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : obj<4x4>

  block ^entry:
    %t1 = addr $value
    call void @YU__YU(%t1)
    %t2 = addr $value
    call void @YU___YU(%t2)
    return i32 0
}

function @YU__YU(%this : ptr) -> void [binding=strong, object=_ZN2YUC1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load ptr $this
    %t2 = index i8 [projection=field] %t1, 0
    store i32 0, %t2
    return void
}

function @YU___YU(%this : ptr) -> void [binding=strong, object=_ZN2YUD1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    return void
}
