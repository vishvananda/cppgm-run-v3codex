global @g : i32 [binding=strong, object=_Z1g] = zero

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $value : obj<1x1>

  block ^entry:
    %t1 = addr $value
    %t2 = addr $value
    call void @YB___YB(%t2)
    return i32 0
}

function @YB___YB(%this : ptr) -> void [binding=strong, object=_ZN2YBD1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    eh_cleanup ^destructor_cleanup_1
    eh_end
    jump ^destructor_return_epilogue_3

  block ^destructor_return_epilogue_3:
    %t1 = load ptr $this
    %t2 = index i8 [projection=field] %t1, 0
    call void @YA___YA(%t2)
    jump ^destructor_end_2

  block ^destructor_cleanup_1:
    %t3 = load ptr $this
    %t4 = index i8 [projection=field] %t3, 0
    call void @YA___YA(%t4)
    eh_end
    resume

  block ^destructor_end_2:
    return void
}

function @YA___YA(%this : ptr) -> void [binding=strong, object=_ZN2YAD1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    store i32 1, @g
    return void
}
