function @read(%box : ptr) -> i32 [binding=strong, object=_Z4readP3Box] {
  slot $box : ptr

  block ^entry:
    store ptr %box, $box
    %t1 = load ptr $box
    %t2 = call i32 @Box__get(%t1)
    return i32 %t2
}
function @Box__get(%this : ptr) -> i32 [binding=weak, object=_ZN3Box3getEv, inline_hint=yes] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load ptr $this
    %t2 = index i8 [projection=field] %t1, 0
    %t3 = load i32 %t2
    return i32 %t3
}
