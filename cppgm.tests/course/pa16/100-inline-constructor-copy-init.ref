function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $y : obj<1x1>

  block ^entry:
    %t1 = addr $y
    call void @Y__Y(%t1, 1)
    return i32 0
}

function @Y__Y(%this : ptr, %__param1 : i32) -> void [binding=strong, object=_ZN1YC1Ei] {
  slot $this : ptr
  slot $__param1 : i32

  block ^entry:
    store ptr %this, $this
    store i32 %__param1, $__param1
    return void
}
