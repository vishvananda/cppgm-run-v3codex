function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $lor__1 : i64

  block ^entry:
    %t1 = call i32 @read_digits()
    %t2 = cmp ne i32 %t1, 50
    branch %t2, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t3 = call i32 @read_digits__ov2()
    %t4 = cmp ne i32 %t3, 53
    %t5 = cmp ne i64 %t4, 0
    store i64 %t5, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t6 = load i64 $lor__1
    %t7 = convert zext i32 u8 %t6
    return i32 %t7
}

