    jump ^land_end_6

  block ^land_end_6:
    %t32 = load i64 $land__2
    branch %t32, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    %t33 = addr $first
    %t34 = unary decay ptr %t33
    %t35 = index i8 [projection=array_element] %t34, 2
