    %t28 = convert sext i32 i8 %t23
    %t29 = convert sext i32 i8 %t27
    %t30 = cmp eq i32 %t28, %t29
    %t31 = cmp ne i64 %t30, 0
    store i64 %t31, $land__2
    jump ^land_end_6

  block ^land_short_5:
