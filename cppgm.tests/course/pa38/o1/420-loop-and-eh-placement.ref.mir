machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @node1
  storage data
  item ptr addr @node2

global @node2
  storage data
  item ptr 0

global @number
  storage scalar i64
  init i64 42

function @identity
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    ret rdi

function @walk_unavoidable
  abi
    param %head -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer omit
    epilogues direct
    preserve r15 r14 rbx

  block ^entry
    load.i64 rbx, @number
    mov r15, rdi
    mov r14, 0

  block ^loop
    test.ptr r15, r15
    je ^exit

  block ^body
    cmp.i64 rbx, 42
    jne ^failure

  block ^advance
    load.ptr r15, [r15]
    lea r8, [r14+1]
    mov r14, r8
    jmp ^loop

  block ^exit
    ret r14

  block ^failure
    mov rax, 99
    ret rax

function @walk_guarded
  abi
    param %head -> rdi : ptr
    param %run -> rsi : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    temp %cursor -> [rbp-8] : ptr
    temp %count -> [rbp-16] : i64
    temp %result -> [rbp-24] : i64

  block ^entry
    test.i64 rsi, rsi
    jne ^__phi_edge_4
    jmp ^__phi_edge_5

  block ^loop
    cmp.ptr [rbp-8], 0
    je ^__phi_edge_6

  block ^body
    load.ptr rcx, [rbp-8]
    load.ptr r9, [rcx]
    load.i64 r8, [rbp-16]
    add r8, 1
    store.ptr [rbp-8], r9
    store.i64 [rbp-16], r8
    jmp ^loop

  block ^exit
    load.i64 rax, [rbp-24]
    ret rax

  block ^__phi_edge_4
    store.ptr [rbp-8], rdi
    mov r11, 0
    store.i64 [rbp-16], r11
    jmp ^loop

  block ^__phi_edge_5
    mov r11, 0
    store.i64 [rbp-24], r11
    jmp ^exit

  block ^__phi_edge_6
    load.i64 r11, [rbp-16]
    store.i64 [rbp-24], r11
    jmp ^exit

function @call_free_eh_load
  abi
    param %address -> rdi : ptr
    param %choose -> rsi : i64
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    temp %host-eh-exception -> [rbp-8] : ptr
    temp %host-eh-selector -> [rbp-16] : i64
    temp %result -> [rbp-24] : i64

  block ^entry
    eh_push ^handler, 0
    eh_pop
    load.i64 rdi, [rdi]
    test.i64 rsi, rsi
    je ^right

  block ^left
    lea rsi, [rdi+1]
    store.i64 [rbp-24], rsi
    jmp ^done

  block ^right
    mov rsi, rdi
    sub rsi, 1
    store.i64 [rbp-24], rsi

  block ^done
    load.i64 rax, [rbp-24]
    ret rax

  block ^handler
    mov rax, 99
    ret rax

function @call_crossing_eh_value
  abi
    param %address -> rdi : ptr
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    preserve r13
    temp %host-eh-exception -> [rbp-8] : ptr
    temp %host-eh-selector -> [rbp-16] : i64

  block ^entry
    eh_push ^handler, 0
    load.i64 r13, [rdi]
    mov rdi, 7
    call @identity [args=(rdi), unwind=no]
    eh_pop

  block ^done
    lea r9, [r13+1]
    ret r9

  block ^handler
    mov rax, 99
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer omit
    epilogues direct
    preserve rbx r12 r13 r14

  block ^entry
    mov rdi, @node1
    call @walk_unavoidable [args=(rdi), unwind=no]
    mov rbx, rax
    mov rdi, @node1
    mov rsi, 0
    call @walk_guarded [args=(rsi,rdi), unwind=no]
    mov r12, rax
    mov rdi, @number
    mov rsi, 1
    call @call_free_eh_load [args=(rsi,rdi)]
    mov r13, rax
    mov rdi, @number
    mov rsi, 0
    call @call_free_eh_load [args=(rsi,rdi)]
    mov r14, rax
    mov rdi, @number
    call @call_crossing_eh_value [args=(rdi)]
    mov rdx, 2
    cmp.i64 rbx, rdx
    setne rbx
    movzx rbx, rbx
    mov rdx, 0
    cmp.i64 r12, rdx
    setne r12
    movzx r12, r12
    mov rdx, 43
    cmp.i64 r13, rdx
    setne r13
    movzx r13, r13
    mov rdx, 41
    cmp.i64 r14, rdx
    setne r14
    movzx r14, r14
    mov rdx, 43
    cmp.i64 rax, rdx
    setne r8
    movzx r8, r8
    or rbx, r12
    or r13, r14
    or rbx, r13
    or rbx, r8
    ret rbx
