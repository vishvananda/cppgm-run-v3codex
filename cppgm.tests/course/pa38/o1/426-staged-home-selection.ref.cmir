machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @keep1
  storage scalar i64
  init i64 1

global @keep2
  storage scalar i64
  init i64 2

global @keep3
  storage scalar i64
  init i64 3

global @keep4
  storage scalar i64
  init i64 4

global @keep5
  storage scalar i64
  init i64 5

global @number
  storage scalar i64
  init i64 40

global @number_pointer
  storage data
  item ptr addr @number

function @identity
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    ret rdi

function @copy_to_edge_home
  abi
    param %value -> rdi : i64
    param %condition -> rsi : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    preserve <gpr0>
    temp %host-eh-exception -> [rbp-<off0>] : ptr
    temp %host-eh-selector -> [rbp-<off1>] : i64
    temp %result -> [rbp-<off2>] : i64
    temp %copied -> [rbp-<off3>] : i64

  block ^entry
    mov <gpr0>, rsi
    eh_push ^handler, 0
    store.i64 [rbp-<off3>], rdi
    mov rdi, 7
    call @identity [args=(rdi), unwind=no]
    eh_pop
    test.i64 <gpr0>, <gpr0>
    je ^right

  block ^left
    load.i64 r9, [rbp-<off3>]
    add r9, 1
    store.i64 [rbp-<off2>], r9
    jmp ^done

  block ^right
    load.i64 r9, [rbp-<off3>]
    sub r9, 1
    store.i64 [rbp-<off2>], r9

  block ^done
    load.i64 rax, [rbp-<off2>]
    ret rax

  block ^handler
    mov rax, 99
    ret rax

function @call_result_to_edge_home
  abi
    param %condition -> rdi : i64
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    preserve <gpr0> <gpr1>
    temp %host-eh-exception -> [rbp-<off0>] : ptr
    temp %host-eh-selector -> [rbp-<off1>] : i64
    temp %result -> [rbp-<off2>] : i64
    temp %value -> [rbp-<off3>] : i64

  block ^entry
    mov <gpr0>, rdi
    eh_push ^handler, 0
    mov rdi, 40
    call @identity [args=(rdi), unwind=no]
    store.i64 [rbp-<off3>], rax
    mov rdi, 9
    call @identity [args=(rdi), unwind=no]
    eh_pop
    test.i64 <gpr0>, <gpr0>
    je ^right

  block ^left
    load.i64 r9, [rbp-<off3>]
    add r9, 2
    store.i64 [rbp-<off2>], r9
    jmp ^done

  block ^right
    load.i64 r9, [rbp-<off3>]
    sub r9, 2
    store.i64 [rbp-<off2>], r9

  block ^done
    load.i64 rax, [rbp-<off2>]
    ret rax

  block ^handler
    mov rax, 99
    ret rax

function @load_with_dead_address
  abi
    param %condition -> rdi : i64
    return i64 -> rax
  frame
    stack_size 80
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    preserve <gpr0> <gpr2> <gpr1> <gpr3> <gpr4>
    temp %host-eh-exception -> [rbp-<off0>] : ptr
    temp %host-eh-selector -> [rbp-<off1>] : i64
    temp %result -> [rbp-<off2>] : i64
    temp %c -> [rbp-<off3>] : i64
    temp %value -> [rbp-<off4>] : i64

  block ^entry
    mov <gpr0>, rdi
    eh_push ^handler, 0
    load.i64 <gpr2>, @keep1
    load.i64 <gpr1>, @keep2
    load.i64 <gpr3>, @keep3
    store.i64 [rbp-<off3>], <gpr3>
    load.i64 <gpr3>, @keep4
    load.i64 <gpr4>, @keep5
    load.ptr r8, @number_pointer
    load.i64 r8, [r8]
    store.i64 [rbp-<off4>], r8
    mov rdi, 11
    call @identity [args=(rdi), unwind=no]
    eh_pop
    test.i64 <gpr0>, <gpr0>
    je ^right

  block ^left
    lea r9, [<gpr2>+<gpr1>]
    load.i64 r8, [rbp-<off3>]
    add r8, <gpr3>
    add r9, r8
    add r9, <gpr4>
    add r9, 3
    store.i64 [rbp-<off2>], r9
    jmp ^done

  block ^right
    lea r9, [<gpr2>+<gpr1>]
    load.i64 r8, [rbp-<off3>]
    add r8, <gpr3>
    add r9, r8
    add r9, <gpr4>
    sub r9, 3
    store.i64 [rbp-<off2>], r9

  block ^done
    load.i64 r9, [rbp-<off2>]
    add r9, [rbp-<off4>]
    ret r9

  block ^handler
    mov rax, 99
    ret rax

function @load_with_live_address
  abi
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    preserve <gpr2> <gpr1>
    temp %host-eh-exception -> [rbp-<off0>] : ptr
    temp %host-eh-selector -> [rbp-<off1>] : i64

  block ^entry
    eh_push ^handler, 0
    load.ptr <gpr2>, @number_pointer
    load.i64 <gpr1>, [<gpr2>]
    mov rdi, 13
    call @identity [args=(rdi), unwind=no]
    eh_pop
    mov rdx, 0
    cmp.ptr <gpr2>, rdx
    sete <gpr2>
    movzx <gpr2>, <gpr2>
    mov rdx, 40
    cmp.i64 <gpr1>, rdx
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    or <gpr2>, <gpr1>
    ret <gpr2>

  block ^handler
    mov rax, 99
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer omit
    epilogues direct
    preserve <gpr0> <gpr1> <gpr2>

  block ^entry
    mov rdi, 40
    mov rsi, 1
    call @copy_to_edge_home [args=(rsi,rdi)]
    mov <gpr0>, rax
    mov rdi, 1
    call @call_result_to_edge_home [args=(rdi)]
    mov <gpr1>, rax
    mov rdi, 1
    call @load_with_dead_address [args=(rdi)]
    mov <gpr2>, rax
    call @load_with_live_address [args=()]
    mov rdx, 41
    cmp.i64 <gpr0>, rdx
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    mov rdx, 42
    cmp.i64 <gpr1>, rdx
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    mov rdx, 58
    cmp.i64 <gpr2>, rdx
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    or <gpr0>, <gpr1>
    or <gpr2>, rax
    or <gpr0>, <gpr2>
    ret <gpr0>
