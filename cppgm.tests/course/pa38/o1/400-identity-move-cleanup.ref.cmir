machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @identity
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    ret rdi

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    mov rdi, 42
    call @identity [args=(rdi), unwind=no]
    mov r8, rax
    test.i64 rax, rax
    je ^bad

  block ^done
    cmp.i64 r8, 42
    setne rax
    movzx rax, rax
    ret rax

  block ^bad
    mov rax, 1
    ret rax
