machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @identity
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    ret rdi

function @frameless_leaf
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    add rdi, 1
    ret rdi

function @frameless_call
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    call @identity [args=(rdi), unwind=no]
    ret rax

function @frame_operand
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    slot $value -> [rbp-<off0>] : i64

  block ^entry
    store.i64 [rbp-<off0>], 31
    load.i64 rax, [rbp-<off0>]
    ret rax

function @dynamic_stack
  abi
    param %bytes -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues direct

  block ^entry
    mov rax, rdi
    add rax, 15
    and rax, -16
    sub rsp, rax
    store.i64 [rsp], 37
    load.i64 rax, [rsp]
    ret rax

function @floating_scratch
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues direct

  block ^entry
    fadd.f64 xmm0, 1.25, 2.5
    fne.f64 rax, xmm0, 3.75
    ret rax

function @host_eh
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    temp %host-eh-exception -> [rbp-<off0>] : ptr
    temp %host-eh-selector -> [rbp-<off1>] : i64

  block ^entry
    eh_push ^handler, 0
    mov rdi, 41
    call @identity [args=(rdi), unwind=no]
    mov r8, rax
    eh_pop
    ret r8

  block ^handler
    mov rax, 99
    ret rax

function @direct_returns
  abi
    param %condition -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    test.i64 rdi, rdi
    je ^no

  block ^yes
    mov rax, 43
    ret rax

  block ^no
    mov rax, 47
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    temp %floating_bad -> [rbp-<off0>] : i64

  block ^entry
    mov rdi, 28
    call @frameless_leaf [args=(rdi), unwind=no]
    mov <gpr0>, rax
    mov rdi, 30
    call @frameless_call [args=(rdi), unwind=no]
    mov <gpr1>, rax
    call @frame_operand [args=(), unwind=no]
    mov <gpr2>, rax
    mov rdi, 16
    call @dynamic_stack [args=(rdi), unwind=no]
    mov <gpr3>, rax
    call @floating_scratch [args=(), unwind=no]
    mov <gpr4>, rax
    call @host_eh [args=()]
    store.i64 [rbp-<off0>], <gpr4>
    mov <gpr4>, rax
    mov rdi, 1
    call @direct_returns [args=(rdi), unwind=no]
    mov rdx, 29
    cmp.i64 <gpr0>, rdx
    setne <gpr0>
    movzx <gpr0>, <gpr0>
    mov rdx, 30
    cmp.i64 <gpr1>, rdx
    setne <gpr1>
    movzx <gpr1>, <gpr1>
    mov rdx, 31
    cmp.i64 <gpr2>, rdx
    setne <gpr2>
    movzx <gpr2>, <gpr2>
    mov rdx, 37
    cmp.i64 <gpr3>, rdx
    setne <gpr3>
    movzx <gpr3>, <gpr3>
    mov rdx, 41
    cmp.i64 <gpr4>, rdx
    setne <gpr4>
    movzx <gpr4>, <gpr4>
    mov rdx, 43
    cmp.i64 rax, rdx
    setne r8
    movzx r8, r8
    or <gpr0>, <gpr1>
    or <gpr2>, <gpr3>
    load.i64 r9, [rbp-<off0>]
    or r9, <gpr4>
    or <gpr0>, <gpr2>
    or r9, r8
    or <gpr0>, r9
    ret <gpr0>
