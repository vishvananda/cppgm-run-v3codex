machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @identity
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    ret rdi !dbg(test.cpp, 2, 3)

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct
    preserve r15

  block ^entry
    mov r15, 40 !dbg(test.cpp, 7, 5)
    add r15, 2 !dbg(test.cpp, 7, 5)

  block ^loop
    mov rdi, r15 !dbg(test.cpp, 11, 5)
    call @identity [args=(rdi), unwind=no] !dbg(test.cpp, 11, 5)
    mov r8, rax !dbg(test.cpp, 11, 5)
    test.i64 rax, rax !dbg(test.cpp, 12, 5)
    je ^loop !dbg(test.cpp, 12, 5)

  block ^done
    cmp.i64 r8, 42 !dbg(test.cpp, 15, 5)
    setne rax !dbg(test.cpp, 15, 5)
    movzx rax, rax !dbg(test.cpp, 15, 5)
    ret rax !dbg(test.cpp, 16, 5)
