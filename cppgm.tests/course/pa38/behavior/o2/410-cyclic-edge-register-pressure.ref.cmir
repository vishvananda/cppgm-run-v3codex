machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @data
  storage data
  item i64 0
  item i64 0

global @a
  storage scalar i64
  init i64 1

global @b
  storage scalar i64
  init i64 2

global @c
  storage scalar i64
  init i64 3

global @d
  storage scalar i64
  init i64 4

function @noop
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    mov rax, 0
    ret rax

function @probe
  abi
    return i64 -> rax
  frame
    stack_size 96
    scratch_bytes 0
    preserve <gpr0> <gpr1> <gpr2> <gpr3> <gpr4>
    slot $counter -> [rbp-<off0>] : i64
    temp %base -> [rbp-<off1>] : ptr
    temp %a -> [rbp-<off2>] : i64
    temp %b -> [rbp-<off3>] : i64
    temp %c -> [rbp-<off4>] : i64
    temp %d -> [rbp-<off5>] : i64
    temp %iteration -> [rbp-<off6>] : i64

  block ^entry
    mov <gpr0>, @data
    store.ptr [rbp-<off1>], <gpr0>
    load.i64 <gpr1>, @a
    store.i64 [rbp-<off2>], <gpr1>
    load.i64 <gpr2>, @b
    store.i64 [rbp-<off3>], <gpr2>
    load.i64 <gpr3>, @c
    store.i64 [rbp-<off4>], <gpr3>
    load.i64 <gpr4>, @d
    store.i64 [rbp-<off5>], <gpr4>
    store.i64 [rbp-<off0>], 0

  block ^condition
    load.i64 <gpr4>, [rbp-<off0>]
    store.i64 [rbp-<off6>], <gpr4>
    cmp.i64 <gpr4>, 2
    jae ^done

  block ^body
    store.i64 [<gpr0>+<gpr4>*8], <gpr4>
    call @noop [args=(), unwind=no]
    mov r8, <gpr1>
    add r8, <gpr2>
    mov r9, <gpr3>
    add r9, [rbp-<off5>]
    add r8, r9
    add r8, 7
    mov r9, <gpr4>
    add r9, 1
    store.i64 [rbp-<off0>], r9
    cmp.i64 r8, 17
    je ^condition
    jmp ^failure

  block ^done
    load.i64 r8, [<gpr0>+<off0>]
    cmp.i64 r8, 1
    setne rax
    movzx rax, rax
    ret rax

  block ^failure
    mov rax, 1
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0

  block ^entry
    call @probe [args=(), unwind=no]
    ret rax
