machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    mov r9, 40
    add r9, 2

  block ^next
    cmp.i64 r9, 42
    setne rax
    movzx rax, rax
    ret rax
