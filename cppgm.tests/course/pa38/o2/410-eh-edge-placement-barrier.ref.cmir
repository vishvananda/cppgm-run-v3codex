machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @identity
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    ret rdi

function @main
  abi
    return i64 -> rax
  frame
    stack_size 32
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    preserve <gpr0>
    temp %host-eh-exception -> [rbp-<off0>] : ptr
    temp %host-eh-selector -> [rbp-<off1>] : i64

  block ^entry
    mov <gpr0>, 40
    add <gpr0>, 2
    eh_push ^handler, 0
    mov rdi, <gpr0>
    call @identity [args=(rdi), unwind=no]
    eh_pop

  block ^done
    cmp.i64 <gpr0>, 42
    setne rax
    movzx rax, rax
    ret rax

  block ^handler
    mov rax, 2
    ret rax
