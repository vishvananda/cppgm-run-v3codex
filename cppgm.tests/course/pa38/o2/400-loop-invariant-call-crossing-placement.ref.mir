machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @identity
  abi
    param %value -> rdi : i64
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    ret rdi

function @float_loop
  abi
    return i64 -> rax
  frame
    stack_size 48
    scratch_bytes 48
    frame_pointer keep
    epilogues direct

  block ^entry
    fmov.f64 xmm0, 3.5

  block ^loop
    fcmp.f64 xmm0, 3.5
    jp ^loop
    jne ^loop

  block ^done
    mov rax, 0
    ret rax

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct
    preserve r15 r13

  block ^entry
    mov r15, 40
    add r15, 2

  block ^loop
    mov rdi, r15
    call @identity [args=(rdi), unwind=no]
    mov r8, rax
    test.i64 rax, rax
    je ^loop

  block ^done
    mov rdx, 42
    cmp.i64 r8, rdx
    setne r13
    movzx r13, r13
    call @float_loop [args=(), unwind=no]
    or r13, rax
    ret r13
