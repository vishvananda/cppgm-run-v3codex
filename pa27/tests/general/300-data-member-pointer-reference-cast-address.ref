function @addr(%b : ptr [pass=reference]) -> ptr [binding=weak, object=_Z4addrR1B] {
  slot $b : ptr

  block ^entry:
    store ptr %b, $b
    %t1 = load ptr $b
    return ptr %t1
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $o : obj<4x4>

  block ^entry:
    %t1 = addr $o
    %t2 = addr $o
    %t3 = index i8 [projection=field] %t2, 0
    zeroinit 4x4 %t3
    %t4 = addr $o
    %t5 = call ptr @get(%t4)
    %t6 = addr $o
    %t7 = index i8 [projection=field] %t6, 0
    %t8 = index i8 [projection=base_subobject] %t7, 0
    %t9 = cmp ne ptr %t5, %t8
    %t10 = convert trunc i32 i64 %t9
    return i32 %t10
}
function @get(%o : ptr [pass=reference]) -> ptr [binding=weak, object=_Z3getIXadL_ZN1O1mEEEEP1BRS0_] {
  slot $o : ptr

  block ^entry:
    store ptr %o, $o
    %t1 = load ptr $o
    %t2 = binary sub i64 1, 1
    %t3 = index i8 [projection=field] %t1, %t2
    %t4 = index i8 [projection=base_subobject] %t3, 0
    %t5 = call ptr @addr(%t4)
    return ptr %t5
}
