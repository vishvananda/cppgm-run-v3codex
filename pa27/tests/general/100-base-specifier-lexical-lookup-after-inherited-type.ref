function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $d : obj<8x4>
  slot $p : ptr

  block ^entry:
    %t1 = addr $d
    %t2 = addr $d
    %t3 = index i8 [projection=base_subobject] %t2, 4
    store ptr %t3, $p
    %t4 = load ptr $p
    %t5 = index i8 [projection=field] %t4, 0
    store i32 7, %t5
    %t6 = load ptr $p
    %t7 = index i8 [projection=field] %t6, 0
    %t8 = load i32 %t7
    %t9 = cmp ne i32 %t8, 7
    %t10 = convert trunc i32 i64 %t9
    return i32 %t10
}
