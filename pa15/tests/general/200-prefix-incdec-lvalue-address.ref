function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $values : obj<12x4>
  slot $p : ptr
  slot $paddr : ptr
  slot $ok_inc : i32
  slot $q : ptr
  slot $qaddr : ptr
  slot $ok_dec : i32
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = addr $values
    %t2 = unary decay ptr %t1
    store ptr %t2, $p
    %t3 = addr $p
    store ptr %t3, $paddr
    %t4 = load ptr $p
    %t5 = binary mul i64 1, 4
    %t6 = index i8 %t4, %t5
    store ptr %t6, $p
    %t7 = addr $p
    %t8 = load ptr $paddr
    %t9 = cmp eq ptr %t7, %t8
    %t10 = convert trunc i32 i64 %t9
    store i32 %t10, $ok_inc
    %t11 = addr $values
    %t12 = unary decay ptr %t11
    %t13 = binary mul i64 2, 4
    %t14 = index i8 %t12, %t13
    store ptr %t14, $q
    %t15 = addr $q
    store ptr %t15, $qaddr
    %t16 = load ptr $q
    %t17 = binary mul i64 1, 4
    %t18 = binary sub i64 0, %t17
    %t19 = index i8 %t16, %t18
    store ptr %t19, $q
    %t20 = addr $q
    %t21 = load ptr $qaddr
    %t22 = cmp eq ptr %t20, %t21
    %t23 = convert trunc i32 i64 %t22
    store i32 %t23, $ok_dec
    %t24 = load i32 $ok_inc
    branch %t24, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t25 = load i32 $ok_dec
    %t26 = cmp ne i64 %t25, 0
    store i64 %t26, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t27 = load i64 $land__2
    branch %t27, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t28 = load i32 $cond__1
    return i32 %t28
}
