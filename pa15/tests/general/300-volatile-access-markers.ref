function @poll(%port : ptr, %device : ptr [pass=reference]) -> i32 [binding=strong, object=_Z4pollPViR6Device] {
  slot $port : ptr
  slot $device : ptr
  slot $gate : i32
  slot $sampled : i32
  slot $indirect : ptr

  block ^entry:
    store ptr %port, $port
    store ptr %device, $device
    store volatile i32 0, $gate
    store volatile i32 1, $gate
    %t1 = load volatile i32 $gate
    %t2 = binary add i32 %t1, 2
    store volatile i32 %t2, $gate
    %t3 = load volatile i32 $gate
    %t4 = binary add i32 %t3, 1
    store volatile i32 %t4, $gate
    %t5 = load ptr $port
    %t6 = load volatile i32 %t5
    store i32 %t6, $sampled
    %t7 = load i32 $sampled
    %t8 = load ptr $device
    %t9 = index i8 [projection=field] %t8, 0
    %t10 = load volatile i32 %t9
    %t11 = binary add i32 %t7, %t10
    store i32 %t11, $sampled
    %t12 = load i32 $sampled
    %t13 = load ptr $device
    %t14 = index i8 [projection=field] %t13, 0
    store volatile i32 %t12, %t14
    %t15 = load i32 $sampled
    %t16 = load ptr $device
    %t17 = index i8 [projection=field] %t16, 4
    store i32 %t15, %t17
    %t18 = addr $gate
    store ptr %t18, $indirect
    %t19 = load ptr $indirect
    %t20 = load volatile i32 %t19
    %t21 = load volatile i32 $gate
    %t22 = binary add i32 %t20, %t21
    return i32 %t22
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $device : obj<8x4>
  slot $port : i32

  block ^entry:
    %t1 = addr $device
    %t2 = addr $device
    %t3 = index i8 [projection=field] %t2, 0
    store i32 0, %t3
    %t4 = addr $device
    %t5 = index i8 [projection=field] %t4, 4
    store i32 0, %t5
    store i32 5, $port
    %t6 = addr $port
    %t7 = addr $device
    %t8 = call i32 @poll(%t6, %t7)
    %t9 = binary sub i32 %t8, 14
    return i32 %t9
}
