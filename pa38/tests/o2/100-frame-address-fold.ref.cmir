machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    slot $x -> [rbp-<off0>] : i8

  block ^entry
    store.i8 [rbp-<off0>], -1
    load.i8 r9, [rbp-<off0>]
    cmp.i64 r9, -1
    sete rax
    movzx rax, rax
    ret rax
