machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

function @main
  abi
    return i64 -> rax
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer keep
    epilogues direct
    preserve r13
    slot $box__0 -> [rbp-8] : i64

  block ^entry
    lea rdi, [rbp-8]
    call @Box_int___Box [args=(rdi)]
    store.i32 [rbp-8], 7
    load.i32 r9, [rbp-8]
    mov r13, r9
    sub r13, 7
    lea rdi, [rbp-8]
    call @Box_int____Box [args=(rdi)]
    ret r13

function @Box_int___Box
  abi
    param %this -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    ret

function @Box_int____Box
  abi
    param %this -> rdi : ptr
    return void -> void
  frame
    stack_size 16
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    ret
