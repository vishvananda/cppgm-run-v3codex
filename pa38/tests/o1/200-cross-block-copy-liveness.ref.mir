machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @value
  storage scalar i64
  init i64 77

global @value_ptr
  storage scalar ptr
  init addr @value

function @main
  abi
    return i64 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer omit
    epilogues direct

  block ^entry
    load.ptr r9, @value_ptr
    cmp.ptr r9, r9
    je ^check

  block ^bad
    mov rax, 1
    ret rax

  block ^check
    load.i64 r8, [r9]
    cmp.i64 r8, 77
    setne rax
    movzx rax, rax
    ret rax
