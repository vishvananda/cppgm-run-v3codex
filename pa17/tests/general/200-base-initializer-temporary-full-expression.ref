global @live : i32 [binding=strong, object=_Z4live] = zero

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $object : obj<1x1>

  block ^entry:
    %t1 = addr $object
    call void @Derived__Derived(%t1)
    %t2 = load i32 @live
    return i32 %t2
}

function @Derived__Derived(%this : ptr) -> void [binding=weak, object=_ZN7DerivedC1Ev] {
  slot $this : ptr
  slot $arg__1 : obj<1x1>

  block ^entry:
    store ptr %this, $this
    eh_try ^cleanup_resume_1
    %t1 = load ptr $this
    %t2 = index i8 [projection=base_subobject] %t1, 0
    %t3 = addr $arg__1
    call void @Value__Value(%t3)
    eh_end
    jump ^call_unwind_end_2

  block ^cleanup_resume_1:
    resume

  block ^call_unwind_end_2:
    eh_try ^cleanup_action_3
    call void @Base__Base__base_entry(%t2, %t3)
    call void @Value___Value(%t3)
    eh_end
    jump ^call_unwind_end_4

  block ^cleanup_action_3:
    call void @Value___Value(%t3)
    jump ^cleanup_resume_1

  block ^call_unwind_end_4:
    return void
}

function @Value__Value(%this : ptr) -> void [binding=weak, object=_ZN5ValueC1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    %t1 = load i32 @live
    %t2 = binary add i32 %t1, 1
    store i32 %t2, @live
