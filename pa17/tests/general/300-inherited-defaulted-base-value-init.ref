  block ^for_cond_1:
    %t2 = load i64 $i
    %t3 = const i64 8
    %t4 = cmp ne i64 %t2, %t3
    branch %t4, ^for_body_2, ^for_end_4

  block ^for_body_2:
    %t5 = addr $storage
    %t6 = unary decay ptr %t5
    %t7 = load i64 $i
    %t8 = index u8 [projection=array_element] %t6, %t7
    store u8 255, %t8
    jump ^for_iter_3

  block ^for_iter_3:
    %t9 = load i64 $i
    %t10 = binary add i64 %t9, 1
    store i64 %t10, $i
    jump ^for_cond_1

  block ^for_end_4:
    %t11 = convert sext i64 i32 8
    %t12 = addr $storage
    %t13 = unary decay ptr %t12
    %t14 = call ptr @operatornew__ov2(%t11, %t13)
    call void @holder__holder(%t14)
    store ptr %t14, $object
    %t15 = load ptr $object
    %t16 = index i8 [projection=field] %t15, 0
    %t17 = index i8 [projection=base_subobject] %t16, 0
    %t18 = index i8 [projection=field] %t17, 0
    %t19 = load ptr %t18
    %t20 = cmp eq ptr %t19, 0
    branch %t20, ^cond_then_5, ^cond_else_6

  block ^cond_then_5:
    store i32 0, $cond__1
    jump ^cond_end_7

  block ^cond_else_6:
    store i32 1, $cond__1
    jump ^cond_end_7

  block ^cond_end_7:
    %t21 = load i32 $cond__1
    return i32 %t21
}

