global @destroyed : i32 [binding=strong, object=_Z9destroyed] = zero

function @make(%ret : ptr [pass=indirect_result]) -> void [binding=strong, object=_Z4makev] {
  block ^entry:
    call void @object__object(%ret)
    return void
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $target : obj<1x1>
  slot $count : i32
  slot $call__1 : ptr
  slot $arg__2 : obj<1x1>
  slot $cleanup_return__3 : i32
  slot $cond__4 : i32

  block ^entry:
    %t1 = addr $target
    store i32 0, $count
    jump ^for_cond_1

  block ^for_cond_1:
    %t2 = load i32 $count
    %t3 = cmp ne i32 %t2, 2
    branch %t3, ^for_body_2, ^for_end_4

  block ^for_body_2:
    %t4 = load i32 @destroyed
    %t5 = load i32 $count
    %t6 = cmp ne i32 %t4, %t5
    branch %t6, ^if_then_5, ^if_else_6

  block ^if_then_5:
