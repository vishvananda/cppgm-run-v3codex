}

function @object__operator_(%this : ptr, %__param1 : ptr [pass=reference]) -> ptr [binding=weak, object=_ZN6objectaSERKS_] {
  slot $this : ptr
  slot $__param1 : ptr

  block ^entry:
    store ptr %this, $this
    store ptr %__param1, $__param1
    %t1 = load ptr $this
