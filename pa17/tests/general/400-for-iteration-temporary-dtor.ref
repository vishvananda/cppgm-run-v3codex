    jump ^return_cleanup_terminal_8

  block ^if_else_6:
    jump ^if_end_7

  block ^if_end_7:
    jump ^for_iter_3

  block ^for_iter_3:
    eh_try ^cleanup_action_11
    %t8 = addr $target
    %t9 = addr $arg__2
    call void @make(%t9)
    eh_end
    jump ^call_unwind_end_12

  block ^cleanup_resume_10:
    resume

  block ^cleanup_action_11:
    %t10 = addr $target
    call void @object___object(%t10)
    jump ^cleanup_resume_10

  block ^call_unwind_end_12:
    eh_try ^cleanup_action_13
    %t11 = call ptr @object__operator_(%t8, %t9)
    store ptr %t11, $call__1
    %t12 = load ptr $call__1
    %t13 = load i32 $count
    %t14 = binary add i32 %t13, 1
    store i32 %t14, $count
    call void @object___object(%t9)
    eh_end
    jump ^call_unwind_end_14

  block ^cleanup_action_13:
    call void @object___object(%t9)
    jump ^cleanup_action_11

  block ^call_unwind_end_14:
    jump ^for_cond_1

  block ^for_end_4:
    %t15 = load i32 @destroyed
    %t16 = cmp eq i32 %t15, 2
    branch %t16, ^cond_then_15, ^cond_else_16

  block ^cond_then_15:
    store i32 0, $cond__4
    jump ^cond_end_17

  block ^cond_else_16:
    store i32 2, $cond__4
    jump ^cond_end_17

  block ^cond_end_17:
    %t17 = load i32 $cond__4
    store i32 %t17, $cleanup_return__3
    jump ^return_cleanup_action_9
}

function @object__object(%this : ptr) -> void [unwind=no, binding=weak, object=_ZN6objectC1Ev, trivial_lifecycle=yes] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
