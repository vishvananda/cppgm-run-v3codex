declare function @cleanup() -> void [binding=strong, object=_Z7cleanupv]

declare function @may_throw() -> void [binding=strong, object=_Z9may_throwv]

function @first() -> i32 [binding=strong, object=_Z5firstv] {
  slot $guard : obj<1x1>

  block ^entry:
    %t1 = addr $guard
    eh_try ^cleanup_action_2
    call void @may_throw()
    eh_end
    jump ^call_unwind_end_3

  block ^cleanup_resume_1:
    resume

  block ^cleanup_action_2:
    %t2 = addr $guard
    call void @Guard___Guard(%t2)
    jump ^cleanup_resume_1

  block ^call_unwind_end_3:
    %t3 = addr $guard
    call void @Guard___Guard(%t3)
    return i32 1
}

function @second() -> i32 [binding=strong, object=_Z6secondv] {
  slot $guard : obj<1x1>

  block ^entry:
    %t1 = addr $guard
    eh_try ^cleanup_action_2
    call void @may_throw()
    eh_end
    jump ^call_unwind_end_3

  block ^cleanup_resume_1:
    resume

  block ^cleanup_action_2:
    %t2 = addr $guard
    call void @Guard___Guard(%t2)
    jump ^cleanup_resume_1

  block ^call_unwind_end_3:
    %t3 = addr $guard
    call void @Guard___Guard(%t3)
    return i32 2
}

function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $cond__1 : i32

  block ^entry:
    %t1 = call i32 @first()
    %t2 = call i32 @second()
    %t3 = cmp eq i32 %t2, 2
    branch %t3, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t4 = load i32 $cond__1
    return i32 %t4
}

function @Guard___Guard(%this : ptr) -> void [binding=weak, object=_ZN5GuardD1Ev] {
  slot $this : ptr

  block ^entry:
    store ptr %this, $this
    call void @cleanup()
    return void
}
