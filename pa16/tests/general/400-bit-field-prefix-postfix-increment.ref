function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $bits : obj<4x4>
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = addr $bits
    %t2 = addr $bits
    %t3 = index i8 [projection=field] %t2, 0
    %t4 = binary and u32 1, 1
    store u32 %t4, %t3
    %t5 = addr $bits
    %t6 = index i8 [projection=field] %t5, 0
    %t7 = binary and u32 3, 1
    %t8 = binary shl u32 %t7, 1
    %t9 = load u32 %t6
    %t10 = binary and u32 %t9, 4294967289
    %t11 = binary or u32 %t10, %t8
    store u32 %t11, %t6
    %t12 = addr $bits
    %t13 = index i8 [projection=field] %t12, 0
    %t14 = load i32 %t13
    %t15 = binary shr i32 %t14, 1
    %t16 = binary and i32 %t15, 3
    %t17 = binary add i32 %t16, 1
    %t18 = addr $bits
    %t19 = index i8 [projection=field] %t18, 0
    %t20 = binary and i32 %t17, 3
    %t21 = binary shl i32 %t20, 1
    %t22 = load i32 %t19
    %t23 = binary and i32 %t22, 4294967289
    %t24 = binary or i32 %t23, %t21
    store i32 %t24, %t19
    %t25 = addr $bits
    %t26 = index i8 [projection=field] %t25, 0
    %t27 = load i32 %t26
    %t28 = binary shr i32 %t27, 1
    %t29 = binary and i32 %t28, 3
    %t30 = binary add i32 %t29, 1
    %t31 = binary and i32 %t30, 3
    %t32 = binary shl i32 %t31, 1
    %t33 = load i32 %t26
    %t34 = binary and i32 %t33, 4294967289
    %t35 = binary or i32 %t34, %t32
    store i32 %t35, %t26
    %t36 = addr $bits
    %t37 = index i8 [projection=field] %t36, 0
    %t38 = load i32 %t37
    %t39 = binary and i32 %t38, 1
    %t40 = cmp eq u32 %t39, 1
    branch %t40, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t41 = addr $bits
    %t42 = index i8 [projection=field] %t41, 0
    %t43 = load i32 %t42
    %t44 = binary shr i32 %t43, 1
    %t45 = binary and i32 %t44, 3
    %t46 = cmp eq u32 %t45, 3
    %t47 = cmp ne i64 %t46, 0
    store i64 %t47, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t48 = load i64 $land__2
    branch %t48, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t49 = load i32 $cond__1
    return i32 %t49
}
